<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Dapur Sukaluyu</title>
  <link rel="preconnect" href="https://cdn.tailwindcss.com">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>try { if (localStorage.getItem('dark_mode')) document.documentElement.classList.add('dark'); } catch (e) {}</script>
  <style>
    
    :root { --bg-body: #FAFAF9; --bg-card: #fff; --bg-sidebar: #fff; --text-body: #1C1917; --border: #e7e5e4; --bg-sidebar-hover: rgba(0,0,0,.05); --bg-sidebar-active: rgba(0,0,0,.08); --bg-header: #fff; }
    html.dark { --bg-body: #0c0a09; --bg-card: #44403c; --bg-sidebar: #1c1917; --text-body: #e7e5e4; --border: #57534e; --bg-sidebar-hover: rgba(255,255,255,.06); --bg-sidebar-active: rgba(255,255,255,.1); --bg-header: #1c1917; }
    html.dark .sidebar-logo-wrap img { background: #fff !important; }
    html.dark #splash-screen { background: var(--bg-body) !important; background-size: auto !important; animation: none !important; }
    html.dark #splash-screen .splash-logo { box-shadow: 0 8px 32px rgba(0,0,0,.4); }
    html.dark #splash-screen .splash-bar-track { background: rgba(255,255,255,.12); }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans", Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji"; background: var(--bg-body); color: var(--text-body); }
    h1,h2,h3 { font-family: inherit; letter-spacing: -0.02em; }
    .mono { font-family: ui-monospace, SFMono-Regular, "SF Mono", Menlo, Consolas, "Liberation Mono", monospace; }
    .sidebar-link { display:flex;align-items:center;gap:.75rem;padding:.5rem .875rem;border-radius:.375rem;font-size:.875rem;color:var(--text-body);cursor:pointer;white-space:nowrap;overflow:hidden;opacity:.7;transition:opacity .15s,background .15s;}
    .sidebar-link:hover { background: var(--bg-sidebar-hover); opacity:1; }
    .sidebar-link.active { background: var(--bg-sidebar-active); opacity:1; }
    .sidebar-link .nav-label { transition: opacity .15s; }
    .sidebar-dropdown .sidebar-sub { display:none; }
    .sidebar-dropdown.open .sidebar-sub { display:block; }
    .sidebar-dropdown .dropdown-arrow { transition:transform .15s;display:inline-block; }
    .sidebar-dropdown.open > .sidebar-dropdown-parent .dropdown-arrow { transform:rotate(90deg); }
    .sidebar-sub-link { padding-left:2.25rem !important; font-size:.8rem !important; opacity:.6; }
    .sidebar-sub-link:hover { opacity:1; }
    .sidebar-sub-link.active { opacity:1; }
    #sidebar.collapsed .sidebar-dropdown .sidebar-sub { display:none !important; }
    #sidebar.collapsed #sidebar-search-wrap { display:none !important; }
    #sidebar-search-results a.active-search { background: var(--bg-sidebar-hover); opacity:1; }
    #sidebar.collapsed .sidebar-dropdown .dropdown-arrow { display:none; }
    #sidebar.collapsed .sidebar-dropdown .sidebar-sub-link { padding-left:.5rem !important; }
    #sidebar.collapsed { width: 64px; }
    #sidebar.collapsed .sidebar-link { justify-content:center;padding:.5rem;gap:0; }
    #sidebar.collapsed .sidebar-link .nav-label,
    #sidebar.collapsed .nav-group-label { opacity:0;width:0;display:none; }
    #sidebar.collapsed .sidebar-logo-text,
    #sidebar.collapsed .user-info-text,
    #sidebar.collapsed .sidebar-toggle-label { display:none; }
    #sidebar.collapsed .sidebar-logo-wrap { justify-content:center;padding:.5rem; }
    #sidebar.collapsed .user-area { display:flex;justify-content:center;padding:.25rem; }
    #sidebar.collapsed .logout-text { display:none; }
    #sidebar.collapsed .logout-icon { display:inline !important; }
    #sidebar .sidebar-toggle { transition: transform .2s; }
    #sidebar.collapsed .sidebar-badge { display:none !important; }
    #sidebar.collapsed .sidebar-toggle { display:none; }
    #app.sidebar-collapsed main { margin-left:64px; }
    @media (max-width:1023px) { #sidebar.collapsed { width:260px; } #sidebar.collapsed .sidebar-link { justify-content:flex-start;padding:.5rem .875rem;gap:.75rem; } #sidebar.collapsed .sidebar-link .nav-label, #sidebar.collapsed .nav-group-label { opacity:1;width:auto;display:block; } #sidebar.collapsed .sidebar-logo-text, #sidebar.collapsed .user-info-text { display:block; } #sidebar.collapsed .sidebar-logo-wrap { justify-content:flex-start;padding:.5rem 1.25rem; } #sidebar.collapsed .user-area { display:flex;justify-content:flex-start;padding:0; } #sidebar.collapsed .logout-text { display:inline; } #app.sidebar-collapsed main { margin-left:0; } }
    .modal-content { background: var(--bg-body); border: 1px solid var(--border); }
    .modal-backdrop, [class*="bg-black/"] { background: rgba(0,0,0,.65); }
    html.dark .modal-backdrop, html.dark [class*="bg-black/"] { background: rgba(0,0,0,.8); }

    @keyframes alert-in {
      from { opacity: 0; transform: scale(0.9) translateY(10px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }
    .animate-alert-in { animation: alert-in 0.2s ease-out; }
    #content table,
    #modal-body table { font-size: .6875rem; }
    #content table th,
    #content table td,
    #modal-body table th,
    #modal-body table td { font-size: .6875rem !important; padding: .5rem .75rem; }
    .badge { display:inline-block;padding:2px 10px;border-radius:999px;font-size:.7rem;font-weight:600;white-space:nowrap; }
    .badge-hadir { background:#dcfce7;color:#166534; }
    .badge-sakit { background:#fef9c3;color:#854d0e; }
    .badge-izin { background:#dbeafe;color:#1e40af; }
    .badge-cuti { background:#f3e8ff;color:#6b21a8; }
    .badge-alpha { background:#fee2e2;color:#991b1b; }
    .badge-terlambat { background:#ffedd5;color:#9a3412; }
    .badge-koreksi { background:#fce7f3;color:#9d174d; }

    /* ═══ Animasi kartu global (dipakai semua halaman) ═══ */
    @keyframes dashIn {
      from { opacity: 0; transform: translateY(14px) scale(.97); }
      to { opacity: 1; transform: none; }
    }
    .dash-card-item { animation: dashIn .5s ease-out both; transition: transform .2s ease, box-shadow .2s ease; }
    .dash-card-item:hover { transform: translateY(-3px); box-shadow: 0 12px 28px -10px rgba(0,0,0,.18); }
    html.dark .dash-card-item:hover { box-shadow: 0 12px 28px -10px rgba(0,0,0,.6); }
    @keyframes dashPulseSoft {
      0%, 100% { transform: scale(1); }
      50% { transform: scale(1.08); }
    }
    .dash-icon-pulse { animation: dashPulseSoft 2.4s ease-in-out infinite; }
  </style>
</head>
<body>
  <!-- ═══ SPLASH / LOADING SCREEN ═══ -->
  <div id="splash-screen" class="fixed inset-0 z-[9999] flex flex-col items-center justify-center" style="background:linear-gradient(135deg, #1e40af 0%, #3b82f6 50%, #06b6d4 100%);background-size:200% 200%;animation:splashGradient 6s ease-in-out infinite alternate">
    <style>
      @keyframes splashGradient {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
      }
      @keyframes splashPulse {
        0%, 100% { transform: scale(1); opacity: 0.8; }
        50% { transform: scale(1.06); opacity: 1; }
      }
      @keyframes splashFadeOut {
        to { opacity: 0; transform: scale(1.02); pointer-events: none; }
      }
      @keyframes splashDot {
        0%, 80%, 100% { opacity: 0.3; transform: translateY(0); }
        40% { opacity: 1; transform: translateY(-4px); }
      }
      @keyframes splashBar {
        0% { width: 0%; }
        25% { width: 30%; }
        50% { width: 55%; }
        75% { width: 78%; }
        100% { width: 98%; }
      }
      .splash-logo {
        animation: splashPulse 2s ease-in-out infinite;
        box-shadow: 0 8px 32px rgba(0,0,0,0.15);
      }
      .splash-dot {
        animation: splashDot 1.4s ease-in-out infinite;
      }
      .splash-dot:nth-child(2) { animation-delay: 0.2s; }
      .splash-dot:nth-child(3) { animation-delay: 0.4s; }
      .splash-bar-track {
        background: rgba(255,255,255,0.15);
        border-radius: 99px;
        height: 4px;
        width: 160px;
        overflow: hidden;
      }
      .splash-bar-fill {
        height: 100%;
        border-radius: 99px;
        background: white;
        animation: splashBar 2.5s ease-out forwards;
      }
      .splash-hidden {
        animation: splashFadeOut 0.4s ease-out forwards !important;
      }
    </style>
    <div class="flex flex-col items-center gap-5">
      <!-- Logo -->
      <div class="splash-logo w-20 h-20 rounded-2xl bg-white flex items-center justify-center overflow-hidden p-1.5">
        <img src="/asset/logo.png" alt="Dapur Sukaluyu" class="w-full h-full object-contain" />
      </div>
      <!-- Title -->
      <div class="text-center">
        <h1 class="text-2xl font-bold text-white tracking-tight">Dapur Sukaluyu</h1>
        <p class="text-white/60 text-sm mt-1 font-medium">Makan Bergizi Gratis</p>
      </div>
      <!-- Progress bar -->
      <div class="splash-bar-track mt-2">
        <div class="splash-bar-fill"></div>
      </div>
      <!-- Loading dots -->
      <div class="flex items-center gap-1.5 mt-1">
        <span id="splash-step" class="text-white/70 text-xs font-medium">Memuat...</span>
        <div class="flex items-center gap-1 ml-1">
          <div class="splash-dot w-1.5 h-1.5 rounded-full bg-white/80"></div>
          <div class="splash-dot w-1.5 h-1.5 rounded-full bg-white/80" style="animation-delay:0.2s"></div>
          <div class="splash-dot w-1.5 h-1.5 rounded-full bg-white/80" style="animation-delay:0.4s"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Header -->
  <header class="lg:hidden sticky top-0 z-30" style="background:var(--bg-header);border-bottom:1px solid var(--border)">
    <div class="px-4 py-3 flex items-center gap-3">
    <button onclick="toggleSidebar()" class="p-2 -ml-2 rounded-md" style="color:var(--text-body)">
      <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/></svg>
    </button>
    <div class="font-bold text-lg flex-1 truncate" style="color:var(--text-body)">Dapur Sukaluyu</div>
        <div class="flex items-center gap-1">
          <div class="relative">
            <button id="chat-header-btn-mobile" onclick="toggleChatPanel()" class="p-2 rounded-lg relative" style="color:var(--text-body)" title="Chat">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
              <span id="chat-badge-mobile" class="absolute -top-0.5 -right-0.5 bg-red-500 text-white text-[9px] font-bold rounded-full min-w-[16px] h-4 flex items-center justify-center px-1 hidden" style="box-shadow:0 0 0 2px var(--bg-header)">0</span>
            </button>
          </div>
          <div class="relative" id="stock-notif-wrap-mobile">
        <button id="stock-notif-btn-mobile" onclick="toggleStockNotif()" class="p-2 rounded-lg relative" style="color:var(--text-body)" title="Notifikasi">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
          <span id="stock-notif-badge-mobile" class="absolute -top-0.5 -right-0.5 bg-red-500 text-white text-[9px] font-bold rounded-full min-w-[16px] h-4 flex items-center justify-center px-1 hidden" style="box-shadow:0 0 0 2px var(--bg-header)">0</span>
        </button>
      </div>
      <button id="dark-toggle-mobile" onclick="toggleDarkMode()" class="p-2 rounded-lg" style="color:var(--text-body)" title="Mode Gelap/Terang">
      <svg class="sun-icon-mobile w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
      <svg class="moon-icon-mobile w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
    </button>
    </div>
    </div>
    <div id="mobile-breadcrumb" class="flex items-center gap-1 px-4 pb-2.5 text-[11px] font-medium overflow-x-auto whitespace-nowrap" style="color:var(--text-body)"></div>
  </header>
  <div id="app" class="flex min-h-screen">
    <!-- Overlay for mobile -->
    <div id="sidebar-overlay" onclick="closeSidebar()" class="fixed inset-0 bg-black/40 z-30 hidden lg:hidden"></div>

    <aside id="sidebar" class="w-[260px] shrink-0 fixed inset-y-0 left-0 flex flex-col transform -translate-x-full lg:translate-x-0 transition-all duration-200 z-40" style="background:var(--bg-sidebar);color:var(--text-body);border-right:1px solid var(--border)">
      <div class="sidebar-logo-wrap flex items-center gap-3 px-5 py-5 cursor-pointer" onclick="expandSidebar()" style="border-bottom:1px solid var(--border)">
        <img src="/asset/logo.png" alt="Dapur Sukaluyu" class="h-9 w-9 rounded-md shrink-0 object-contain" style="background:var(--border)" />
        <span class="sidebar-logo-text font-bold leading-tight truncate">Dapur Sukaluyu</span>
      </div>
      <!-- Sidebar Search -->
      <div id="sidebar-search-wrap" class="relative px-3 pt-3 shrink-0">
        <div class="relative">
          <svg class="absolute left-2.5 top-1/2 -translate-y-1/2 w-4 h-4 pointer-events-none" style="opacity:.45" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <input id="sidebar-search" type="text" placeholder="Cari menu…" autocomplete="off" spellcheck="false"
            oninput="onSidebarSearch(this.value)" onkeydown="onSidebarSearchKey(event)"
            class="w-full h-9 pl-8 pr-8 rounded-lg text-sm transition-all focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 outline-none"
            style="background:var(--bg-card);border:1px solid var(--border)" />
          <button id="sidebar-search-clear" onclick="clearSidebarSearch()" class="hidden absolute right-1.5 top-1/2 -translate-y-1/2 w-6 h-6 items-center justify-center rounded-full transition-opacity" style="opacity:.5" title="Bersihkan">✕</button>
        </div>
        <div id="sidebar-search-results" class="hidden absolute left-3 right-3 top-[calc(100%+6px)] z-50 rounded-xl overflow-hidden shadow-xl" style="background:var(--bg-card);border:1px solid var(--border);max-height:min(56vh,420px);overflow-y:auto"></div>
      </div>
      <nav id="nav" class="flex-1 overflow-y-auto py-4 px-3 space-y-0.5"></nav>
      <div style="border-top:1px solid var(--border)" class="px-4 py-3 text-sm">
        <a href="/akun" data-key="akun" onclick="closeSidebar()" class="user-area flex items-center gap-3 mb-2 rounded-lg px-2 -mx-2 py-2 transition-colors" title="Akun Saya" style="color:var(--text-body)">
          <div id="user-avatar" class="w-9 h-9 rounded-full flex items-center justify-center text-xs font-bold shrink-0 overflow-hidden" style="background:var(--border);color:var(--text-body)">—</div>
          <div class="user-info-text min-w-0">
            <div class="font-medium truncate" id="user-name">—</div>
            <div class="text-[11px] capitalize truncate" id="user-role" style="opacity:.6">—</div>
          </div>
        </a>
        <div class="flex items-center gap-1">
          <button id="logout-btn" class="flex-1 text-left text-sm py-1.5 px-2 rounded flex items-center" style="color:var(--text-body);opacity:.65">
            <span class="logout-text">↪ Keluar</span>
            <span class="hidden logout-icon w-5 text-center">↪</span>
          </button>
          <button id="sidebar-toggle" onclick="toggleSidebarCollapse()" class="sidebar-toggle p-1.5 rounded hidden lg:block" style="color:var(--text-body);opacity:.5" title="Ciutkan sidebar">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 19l-7-7 7-7m8 14l-7-7 7-7"/></svg>
          </button>
        </div>
      </div>
    </aside>

    <main id="main-content" class="flex-1 lg:ml-[260px] w-full min-w-0">
      <header class="hidden lg:flex items-center justify-between sticky top-0 z-10 px-8 py-4" style="background:var(--bg-header);border-bottom:1px solid var(--border)">
        <div>
          <h1 id="page-title" class="text-2xl font-bold tracking-tight">Dashboard</h1>
          <p id="page-sub" class="text-sm mt-1" style="opacity:.6">Ringkasan operasional dapur</p>
        </div>
        <div class="flex items-center gap-1">
          <div class="relative">
            <button id="chat-header-btn" onclick="toggleChatPanel()" class="p-2 rounded-lg relative" style="color:var(--text-body)" title="Chat antar user">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
              <span id="chat-badge" class="absolute -top-0.5 -right-0.5 bg-red-500 text-white text-[9px] font-bold rounded-full min-w-[16px] h-4 flex items-center justify-center px-1 hidden" style="box-shadow:0 0 0 2px var(--bg-header)">0</span>
            </button>
          </div>
          <div class="relative" id="stock-notif-wrap">
            <button id="stock-notif-btn" onclick="toggleStockNotif()" class="p-2 rounded-lg relative" style="color:var(--text-body)" title="Notifikasi">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
              <span id="stock-notif-badge" class="absolute -top-0.5 -right-0.5 bg-red-500 text-white text-[9px] font-bold rounded-full min-w-[16px] h-4 flex items-center justify-center px-1 hidden" style="box-shadow:0 0 0 2px var(--bg-header)">0</span>
            </button>
          </div>
          <button id="dark-toggle" onclick="toggleDarkMode()" class="p-2 rounded-lg" style="color:var(--text-body)" title="Mode Gelap/Terang">
          <svg id="sun-icon" class="w-5 h-5 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 3v1m0 16v1m9-9h-1M4 12H3m15.364 6.364l-.707-.707M6.343 6.343l-.707-.707m12.728 0l-.707.707M6.343 17.657l-.707.707M16 12a4 4 0 11-8 0 4 4 0 018 0z"/></svg>
          <svg id="moon-icon" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20.354 15.354A9 9 0 018.646 3.646 9.003 9.003 0 0012 21a9.003 9.003 0 008.354-5.646z"/></svg>
        </button>
      </header>
      <div id="content" class="p-4 lg:p-8 min-w-0"></div>
    </main>
  </div>

  <!-- Modal -->
  <div id="modal" class="fixed inset-0 modal-backdrop hidden items-center justify-center z-50 p-4">
    <div class="modal-content rounded-lg shadow-xl w-full max-w-2xl max-h-[90vh] overflow-hidden flex flex-col">
      <div class="px-4 lg:px-6 py-3 lg:py-4 flex justify-between items-center" style="border-bottom:1px solid var(--border)">
        <h3 id="modal-title" class="text-base lg:text-lg font-bold"></h3>
        <button id="modal-close-btn" class="text-xl" style="opacity:.5">×</button>
      </div>
      <div id="modal-body" class="p-4 lg:p-6 overflow-y-auto flex-1"></div>
      <div class="px-4 lg:px-6 py-3 flex justify-end gap-2" style="border-top:1px solid var(--border)">
        <button id="modal-cancel-btn" class="px-4 py-2 text-sm btn-ghost rounded">Batal</button>
        <button id="modal-save" class="px-4 py-2 text-sm bg-[#1e40af] hover:bg-[#1d4ed8] text-white rounded font-medium">Simpan</button>
      </div>
    </div>
  </div>

  <!-- Notification Dropdown -->
  <div id="stock-notif-dropdown" class="fixed right-4 top-16 w-80 rounded-xl shadow-lg border z-50 hidden" style="background:var(--bg-card);border-color:var(--border);color:var(--text-body)">
    <div class="px-4 py-3 border-b font-bold text-sm flex items-center gap-2" style="border-color:var(--border)">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9"/></svg>
      Notifikasi
    </div>
    <div id="stock-notif-list" class="max-h-[350px] overflow-y-auto">
      <div class="px-4 py-6 text-center text-sm" style="opacity:0.5">Memuat...</div>
    </div>
    <div class="flex border-t" style="border-color:var(--border)">
      <a href="/gudang" data-key="gudang" class="flex-1 block px-4 py-2.5 text-xs font-medium text-center" style="opacity:0.7" onclick="closeStockNotif()">Stok</a>
      <a href="/siklus" data-key="siklus" class="flex-1 block px-4 py-2.5 text-xs font-medium text-center border-l" style="border-color:var(--border);opacity:0.7" onclick="closeStockNotif()">Siklus</a>
    </div>
  </div>

  <!-- Toast container -->
  <div id="toast-container" class="fixed top-4 right-4 z-[100] flex flex-col gap-2 pointer-events-none"></div>
  <style>
    .toast { background:var(--bg-card);color:var(--text-body);border:1px solid var(--border); }
    .btn-ghost { color:var(--text-body); }
    .btn-ghost:hover { background:var(--bg-sidebar-hover); }
    html.dark body { background:var(--bg-body);color:var(--text-body); }
    html.dark table.w-full,
    html.dark [class*="bg-white"] { background:var(--bg-card);color:var(--text-body); }
    html.dark [class*="border-stone"] { border-color:var(--border) !important; }
    html.dark [class*="border-red-"] { border-color:#991b1b !important; }
    html.dark [class*="border-orange-"] { border-color:#9a3412 !important; }
    html.dark [class*="border-emerald-"] { border-color:#065f46 !important; }
    html.dark thead { background:var(--bg-sidebar); }
    html.dark th { color:var(--text-body); }
    html.dark tr[class*="border-stone"] { border-color:var(--border); }
    html.dark .text-stone-400,
    html.dark .text-stone-500,
    html.dark .text-stone-600,
    html.dark .text-stone-700,
    html.dark .text-stone-800,
    html.dark .text-stone-900 { color:var(--text-body); }
    html.dark [class*="bg-stone-50"] { background:#292524; }
    html.dark [class*="bg-stone-100"] { background:#44403c; }
    html.dark [class*="hover:bg-stone-50"]:hover { background:#292524; }
    html.dark [class*="hover:bg-stone-100"]:hover,
    html.dark [class*="hover:bg-stone-200"]:hover { background:#44403c; }
    html.dark .shadow-sm,
    html.dark .shadow { box-shadow:0 1px 3px rgba(0,0,0,.3); }
    html.dark .shadow-lg,
    html.dark .shadow-xl { box-shadow:0 4px 16px rgba(0,0,0,.4); }
    input, select, textarea { background:var(--bg-card);color:var(--text-body);border-color:var(--border); }
    html.dark input, html.dark select, html.dark textarea { background:#1c1917; border-color:#57534e; }
    html.dark input:focus, html.dark select:focus, html.dark textarea:focus { border-color:#a8a29e; }
    html.dark [class*="bg-blue-50"],
    html.dark [class*="bg-blue-100"] { background:#1e3a5f; }
    html.dark [class*="bg-emerald-50"],
    html.dark [class*="bg-emerald-100"] { background:#064e3b; }
    html.dark [class*="bg-amber-50"],
    html.dark [class*="bg-amber-100"] { background:#451a03; }
    html.dark [class*="bg-orange-50"],
    html.dark [class*="bg-orange-100"] { background:#431407; }
    html.dark [class*="bg-violet-50"],
    html.dark [class*="bg-violet-100"] { background:#2e1065; }
    html.dark [class*="bg-cyan-50"],
    html.dark [class*="bg-cyan-100"] { background:#164e63; }
    html.dark [class*="bg-rose-50"],
    html.dark [class*="bg-rose-100"] { background:#4c0519; }
    html.dark [class*="bg-red-50"],
    html.dark [class*="bg-red-100"] { background:#450a0a; }
    html.dark [class*="bg-green-50"],
    html.dark [class*="bg-green-100"] { background:#064e3b; }
    html.dark [class*="hover:bg-blue-200"]:hover,
    html.dark [class*="hover:bg-emerald-200"]:hover,
    html.dark [class*="hover:bg-amber-200"]:hover,
    html.dark [class*="hover:bg-violet-200"]:hover,
    html.dark [class*="hover:bg-cyan-200"]:hover,
    html.dark [class*="hover:bg-rose-200"]:hover { opacity:.8; }
    html.dark [class*="text-blue"] { color:#93c5fd; }
    html.dark [class*="text-emerald"] { color:#6ee7b7; }
    html.dark [class*="text-amber"] { color:#fcd34d; }
    html.dark [class*="text-orange"] { color:#fdba74; }
    html.dark [class*="text-violet"] { color:#c4b5fd; }
    html.dark [class*="text-cyan"] { color:#67e8f9; }
    html.dark [class*="text-rose"] { color:#fda4af; }
    html.dark [class*="text-red"] { color:#fca5a5; }
    html.dark [class*="text-green"] { color:#86efac; }
    html.dark [class*="text-\[#1e40af\]"] { color:#93c5fd; }
    html.dark [class*="bg-gradient"] { background: linear-gradient(135deg, #292524, #44403c) !important; }
    html.dark [class*="bg-gradient"] [class*="bg-white"] { background: #44403c !important; }
    html.dark [class*="bg-gradient"] [class*="bg-white"]:hover { background: #57534e !important; }
    html.dark [class*="bg-gradient"] .text-\[#1e40af\] { color: #e7e5e4 !important; }
  </style>

  <style>
    .chat-bubble-other { background:#f5f5f4; color:#1c1917; box-shadow:0 1px 2px rgba(0,0,0,.06),0 1px 1px rgba(0,0,0,.04); }
    html.dark .chat-bubble-other { background:#44403c; color:#e7e5e4; box-shadow:0 1px 2px rgba(0,0,0,.2),0 1px 1px rgba(0,0,0,.15); }
    .chat-bubble-mine { background:linear-gradient(135deg,#10b981,#059669); color:#fff; box-shadow:0 1px 2px rgba(16,185,129,.25),0 1px 1px rgba(16,185,129,.15); }
    .chat-bubble-other, .chat-bubble-mine { border-radius:18px 18px 18px 4px; }
    .chat-bubble-mine { border-radius:18px 18px 4px 18px; }
    .chat-scroll::-webkit-scrollbar { width:6px; }
    .chat-scroll::-webkit-scrollbar-track { background:transparent; }
    .chat-scroll::-webkit-scrollbar-thumb { background:rgba(0,0,0,.15); border-radius:99px; }
    html.dark .chat-scroll::-webkit-scrollbar-thumb { background:rgba(255,255,255,.2); }
    @keyframes chatIn { from { opacity:0; transform:translateY(8px); } to { opacity:1; transform:none; } }
    .chat-msg-anim { animation:chatIn .18s ease-out both; }
    .chat-time { font-size:10px; opacity:.55; margin-top:4px; }
    .chat-time.mine { text-align:right; color:rgba(255,255,255,.7); }
    .chat-time.other { text-align:left; color:var(--text-body); }
    html.dark .chat-time.other { color:#a8a29e; }
  </style>

  <!-- ═══ CHAT ANTAR USER (sidebar melayang kanan) ═══ -->
  <div id="chat-panel" class="fixed inset-y-0 right-0 z-[56] w-[360px] max-w-[94vw] flex flex-col overflow-hidden translate-x-full transition-transform duration-200"
    style="background:var(--bg-card);border-left:1px solid var(--border);box-shadow:-16px 0 40px -16px rgba(0,0,0,.28)">
    <div class="flex items-center gap-3 px-4 py-3.5 border-b shrink-0" style="border-color:var(--border);background:var(--bg-header)">
      <div class="w-9 h-9 rounded-full flex items-center justify-center text-white shrink-0" style="background:linear-gradient(135deg,#10b981,#059669)">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/></svg>
      </div>
      <div class="flex-1 min-w-0">
        <div class="font-bold text-sm leading-tight" style="color:var(--text-body)">Chat</div>
        <div id="chat-panel-subtitle" class="text-[11px] truncate" style="color:var(--text-body);opacity:.55">—</div>
      </div>
      <button onclick="closeChatPanel()" class="p-2 rounded-lg hover:bg-stone-100 shrink-0" style="color:var(--text-body)" title="Tutup">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <!-- Daftar kontak / room -->
    <div id="chat-contacts-view" class="chat-scroll flex-1 overflow-y-auto"></div>

    <!-- Percakapan -->
    <div id="chat-conversation-view" class="hidden flex-col min-h-0 flex-1">
      <div class="flex items-center gap-2 px-3 py-2.5 border-b shrink-0" style="border-color:var(--border)">
        <button onclick="chatBackToContacts()" class="p-1.5 -ml-1.5 rounded-lg hover:bg-stone-100" style="color:var(--text-body)" title="Kembali">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        </button>
        <div class="flex-1 min-w-0">
          <div id="chat-conv-title" class="font-semibold text-sm truncate" style="color:var(--text-body)">—</div>
          <div id="chat-conv-sub" class="text-[10px] flex items-center gap-1" style="color:var(--text-body);opacity:.55">
            <span id="chat-conv-dot" class="w-1.5 h-1.5 rounded-full bg-stone-300 inline-block"></span>
            <span id="chat-conv-online">—</span>
          </div>
        </div>
      </div>
      <div id="chat-messages" class="chat-scroll flex-1 min-h-0 overflow-y-auto px-3 py-3 flex flex-col gap-1.5"></div>
      <div class="p-3 border-t shrink-0" style="border-color:var(--border)">
        <div class="flex items-end gap-2">
          <input id="chat-input" type="text" maxlength="2000" placeholder="Tulis pesan..." autocomplete="off"
            class="flex-1 text-sm px-3 py-2 rounded-xl outline-none"
            style="background:var(--bg-sidebar-hover);color:var(--text-body);border:1px solid var(--border)" />
          <button onclick="chatSend()" class="w-9 h-9 rounded-xl flex items-center justify-center text-white shrink-0 hover:scale-105 transition-transform" style="background:linear-gradient(135deg,#10b981,#059669)" title="Kirim">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/></svg>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Alert Modal -->
  <div id="alert-modal" class="fixed inset-0 modal-backdrop hidden items-center justify-center z-[60] p-4">
    <div class="alert-content rounded-xl shadow-xl w-full max-w-sm overflow-hidden animate-alert-in" style="background:var(--bg-card)">
      <div class="p-6">
        <div class="flex items-center gap-3 mb-3">
          <div id="alert-icon" class="w-10 h-10 rounded-full flex items-center justify-center shrink-0">
            <svg id="alert-svg" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01"/>
            </svg>
          </div>
          <h3 id="alert-title" class="text-base font-bold">Perhatian</h3>
        </div>
        <p id="alert-message" class="text-sm ml-13" style="opacity:.7"></p>
      </div>
      <div class="px-6 pb-4 flex justify-end">
        <button id="alert-ok" class="px-5 py-2 text-sm font-medium text-white rounded-lg transition-colors">OK</button>
      </div>
    </div>
  </div>

  <!-- Confirm Modal -->
  <div id="confirm-modal" class="fixed inset-0 hidden items-center justify-center z-[60] p-4" role="dialog" aria-modal="true" aria-labelledby="confirm-title" aria-describedby="confirm-message">
    <div class="modal-backdrop fixed inset-0 opacity-0 transition-opacity duration-200" aria-hidden="true"></div>
    <div id="confirm-content" class="relative w-full max-w-md transform overflow-hidden transition-all duration-200 ease-out opacity-0 scale-95" style="background:var(--bg-card);border:1px solid var(--border);border-radius:1rem;box-shadow:0 25px 50px -12px rgba(0,0,0,0.25)">
      <div id="confirm-header" class="px-6 py-4 flex items-center gap-3 border-b" style="border-color:var(--border)">
        <div id="confirm-icon" class="w-10 h-10 rounded-full flex items-center justify-center shrink-0" style="background:var(--bg-sidebar-hover)">
          <svg id="confirm-icon-svg" class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
        </div>
        <h3 id="confirm-title" class="text-base font-semibold" style="color:var(--text-body)">Konfirmasi</h3>
      </div>
      <div class="p-6">
        <p id="confirm-message" class="text-sm leading-relaxed" style="color:var(--text-body);opacity:.8"></p>
      </div>
      <div class="px-6 py-4 flex justify-end gap-2 border-t" style="border-color:var(--border)">
        <button id="confirm-cancel" type="button" class="px-4 py-2 text-sm font-medium rounded-lg transition-all duration-150 btn-ghost" style="color:var(--text-body)">Batal</button>
        <button id="confirm-ok" type="button" class="px-4 py-2 text-sm font-medium text-white rounded-lg transition-all duration-150 bg-red-600 hover:bg-red-700 focus:ring-2 focus:ring-red-500 focus:ring-offset-2">Hapus</button>
      </div>
    </div>
  </div>

  <script src="https://cdn.sheetjs.com/xlsx-0.20.3/package/dist/xlsx.full.min.js"></script>
  <script src="/vendor/dayjs/dayjs.min.js"></script>
  <script src="/vendor/dayjs/locale/id.js"></script>
  <script>dayjs.locale('id');</script>
  <script src="/dist/app.min.js?v=<%= distVer %>"></script>
</body>
</html>
