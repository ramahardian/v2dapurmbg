      if (fileInput) fileInput.value = '';
      btnYa.textContent=in_?'Ya, Clock In!':'Ya, Clock Out!'; btnYa.className='flex-1 h-11 btn btn-primary'; btnYa.disabled=true;
      
      // File input fallback
      if (fileInput) {
