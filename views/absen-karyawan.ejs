          co.disabled=true; co.onclick=null;
        } else if (s.bolos) {
          ci.className='h-16 btn btn-outline text-red-400 cursor-not-allowed';
          ci.innerHTML='<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg><span>Bolos</span>';
          ci.disabled=true; ci.onclick=null;
          co.className='h-16 btn btn-outline text-red-400 cursor-not-allowed';
          co.innerHTML='<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg><span>Bolos</span>';
          co.disabled=true; co.onclick=null;
        } else {
          ci.className='h-16 btn btn-outline text-slate-400 cursor-not-allowed';
          ci.innerHTML='<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg><span>Terkunci</span>';
          ci.disabled=true; ci.onclick=null;
          co.className='h-16 btn btn-outline text-slate-400 cursor-not-allowed';
          co.innerHTML='<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg><span>Terkunci</span>';
