      if (!s.sudah_absensi||!s.sudah_masuk) {
        ci.className='h-16 btn btn-primary'; ci.innerHTML='<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg><span>Clock In</span>'; ci.disabled=false; ci.onclick=()=>confirmAbsen('in');
        co.className='h-16 btn btn-outline text-slate-400'; co.innerHTML='<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg><span>Clock Out</span>'; co.disabled=true; co.onclick=null;
      } else if (s.sudah_masuk&&!s.sudah_keluar) {
        ci.className='h-16 btn btn-success cursor-default'; ci.innerHTML='<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg><span>Sudah Clock In</span>'; ci.disabled=true; ci.onclick=null;
        co.className='h-16 btn btn-primary'; co.innerHTML='<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg><span>Clock Out</span>'; co.disabled=false; co.onclick=()=>confirmAbsen('out');
      } else {
        ci.className='h-16 btn btn-success cursor-default'; ci.innerHTML='<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg><span>Selesai</span>'; ci.disabled=true; ci.onclick=null;
        co.className='h-16 btn btn-success cursor-default'; co.innerHTML='<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg><span>Selesai</span>'; co.disabled=true; co.onclick=null;
      }
    }

    // Render Shift
    function renderShift(s) {
      const card=document.getElementById('shift-card'), wrap=document.getElementById('shift-progress-wrap');
      const nama=document.getElementById('shift-nama'), jam=document.getElementById('shift-jam'), label=document.getElementById('shift-jam-label');
      if (!s.ada_shift||!s.data) {
        nama.textContent='Tidak ada shift hari ini'; nama.className='text-slate-400 font-semibold text-sm';
        jam.textContent='--:--'; label.textContent=''; if(wrap)wrap.classList.add('hidden'); card.classList.remove('hidden'); return;
      }
      if (!s.hari_kerja_hari_ini) {
        nama.textContent=s.data.nama+' — Libur'; nama.className='text-slate-400 font-semibold text-sm';
        const m=s.data.jam_masuk?s.data.jam_masuk.slice(0,5):'--:--', k=s.data.jam_keluar?s.data.jam_keluar.slice(0,5):'--:--';
        jam.textContent=m+' — '+k; label.textContent='Libur'; if(wrap)wrap.classList.add('hidden'); card.classList.remove('hidden'); return;
      }
      nama.textContent=s.data.nama; nama.className='text-slate-800 font-semibold text-sm';
      if(wrap)wrap.classList.remove('hidden');
      const m=s.data.jam_masuk?s.data.jam_masuk.slice(0,5):'--:--', k=s.data.jam_keluar?s.data.jam_keluar.slice(0,5):'--:--';
      jam.textContent=m; label.textContent='— '+k;
      document.getElementById('shift-label-masuk').textContent=m; document.getElementById('shift-label-keluar').textContent=k;
      if (s.data.jam_masuk&&s.data.jam_keluar) {
        const n=new Date(), nm=n.getHours()*60+n.getMinutes(), sm=toMin(s.data.jam_masuk), em=toMin(s.data.jam_keluar), tm=em-sm;
        if(tm>0){let p=Math.max(0,Math.min(100,((nm-sm)/tm)*100)); document.getElementById('shift-progress').style.width=p+'%';
          const st=document.getElementById('shift-status-text');
          if(p<25)st.textContent='Baru mulai';else if(p<50)st.textContent='Sedang berjalan';else if(p<75)st.textContent='Hampir selesai';else if(p<100)st.textContent='Sebentar lagi selesai';else st.textContent='Selesai ✓';}
      }
    }



    // Render Riwayat
    function renderRiwayat(r) {
      showSkeleton('riwayat',false); const el=document.getElementById('riwayat-content'),btn=document.getElementById('btn-lihat-semua');
      if (!r.data||!r.data.length) { el.innerHTML='<div class="text-center py-8 text-slate-400 text-sm">Belum ada riwayat absen</div>'; btn.classList.add('hidden'); return; }
      btn.classList.remove('hidden'); btn.onclick=async()=>{if(riwayatExpanded)return; btn.textContent='Memuat...'; btn.disabled=true; try{const rr=await fetch('/api/mobile/absensi/riwayat?limit=50&_='+Date.now()),rd=await rr.json(); renderRiwayatList(el,rd.data,true); btn.textContent='Semua riwayat ('+(rd.pagination?.total||rd.data.length)+')'; btn.disabled=true; riwayatExpanded=true;}catch{btn.textContent='Gagal memuat'; btn.disabled=false;}};
      renderRiwayatList(el,r.data,false);
    }
    function renderRiwayatList(el,data,full) {
      if(!data.length){el.innerHTML='<div class="text-center py-6 text-slate-400 text-sm">Belum ada riwayat</div>';return;}
      const h=data.filter(a=>a.status==='Hadir').length,t=data.length,pct=t>0?Math.round(h/t*100):0;
      let html='';
      if(!full&&t>0)html+='<div class="flex items-center gap-2 text-[0.6rem] text-slate-400 mb-3 pb-3 border-b border-slate-100"><span class="text-emerald-600 font-semibold">'+h+'/'+t+' hadir</span><span class="text-slate-200">·</span><span>'+pct+'% kehadiran</span><div class="flex-1 h-1.5 bg-slate-100 rounded-full overflow-hidden ml-1"><div class="h-full rounded-full bg-emerald-500" style="width:'+pct+'%"></div></div></div>';
      data.forEach(a=>{
        const cls=a.status==='Hadir'?'badge-hadir':a.status==='Terlambat'?'badge-terlambat':a.status==='Sakit'?'badge-sakit':a.status==='Izin'?'badge-izin':a.status==='Cuti'?'badge-cuti':a.status==='Alpha'?'badge-alpha':'badge-hadir';
        html+='<div class="flex items-center justify-between py-2.5 border-b border-slate-100 last:border-0"><div class="flex items-center gap-2.5 min-w-0"><span class="text-slate-600 text-xs font-medium w-20 shrink-0">'+escapeHtml(full?fmtDateFull(a.tanggal):fmtDate(a.tanggal))+'</span><span class="badge '+cls+'">'+escapeHtml(a.status)+'</span></div><div class="text-[0.65rem] text-slate-400 font-mono shrink-0 ml-2">'+fmt(a.jam_masuk)+' — '+fmt(a.jam_keluar)+'</div></div>';
      });
      el.innerHTML=html;
    }

    // Confirm Absen
    async function confirmAbsen(type) {
      const overlay=document.getElementById('modal-overlay'),icon=document.getElementById('modal-icon'),title=document.getElementById('modal-title'),desc=document.getElementById('modal-desc'),locEl=document.getElementById('modal-location'),locText=document.getElementById('modal-location-text'),locSpin=locEl.querySelector('.spinner'),btnYa=document.getElementById('modal-ya'),photoPreview=document.getElementById('modal-photo-preview'),photoInput=document.getElementById('modal-photo-input'),photoContainer=document.getElementById('modal-photo-container');
      const in_=type==='in';
      icon.className='w-16 h-16 mx-auto mb-3 rounded-xl flex items-center justify-center '+(in_?'bg-amber-100':'bg-blue-100');
      icon.innerHTML=in_?'<svg class="w-8 h-8 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>':'<svg class="w-8 h-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>';
      title.textContent=in_?'Clock In':'Clock Out'; desc.textContent=in_?'Konfirmasi clock-in untuk memulai hari kerja?':'Konfirmasi clock-out untuk mengakhiri hari kerja?';
      btnYa.textContent=in_?'Ya, Clock In!':'Ya, Clock Out!'; btnYa.className='flex-1 h-11 btn btn-primary'; btnYa.disabled=false;
      locEl.classList.remove('hidden'); if(locSpin)locSpin.classList.remove('hidden'); locText.textContent='Mendapatkan lokasi...';
      const loc=await getLocation();
      if(loc){currentLocation=loc;if(locSpin)locSpin.classList.add('hidden');locText.textContent='📍 '+loc.lat.toFixed(4)+', '+loc.lng.toFixed(4);}
      else{currentLocation=null;if(locSpin)locSpin.classList.add('hidden');locText.textContent='📍 Lokasi tidak tersedia (absen tanpa lokasi)';}
      // Siapkan photo preview
      if (photoPreview) photoPreview.classList.add('hidden');
      if (photoPreview) photoPreview.src = '';
      if (photoInput) photoInput.value = '';
      if (photoContainer) photoContainer.classList.remove('hidden');
      
      // Setup photo preview
      if (photoInput) {
        const oldHandler = photoInput.onclick;
        photoInput.onclick = function(e) {
          e.stopPropagation();
          if (oldHandler) oldHandler.call(this, e);
        };
        photoInput.onchange = function(e) {
          const file = e.target.files?.[0];
          if (!file) return;
          const maxSize = 2 * 1024 * 1024; // 2MB
          if (file.size > maxSize) {
            showToast('Ukuran photo maksimal 2MB', 'error');
            e.target.value = '';
            return;
          }
          const reader = new FileReader();
          reader.onload = function(ev) {
            if (photoPreview) {
              photoPreview.src = ev.target.result;
              photoPreview.classList.remove('hidden');
            }
            if (photoContainer) {
              photoContainer.classList.remove('hidden');
              const placeholder = document.getElementById('modal-photo-placeholder');
              if (placeholder) placeholder.classList.add('hidden');
            }
            btnYa.disabled = false;
          };
          reader.readAsDataURL(file);
        };
      }
      
      overlay.classList.remove('hidden');
      btnYa.onclick=async()=>{btnYa.disabled=true;btnYa.textContent='Memproses...';try{const body={client_time:new Date().toISOString()};if(currentLocation){body.latitude=currentLocation.lat;body.longitude=currentLocation.lng;}
        if (photoInput && photoInput.value) {
          const file = photoInput.files[0];
          if (file) {
            const reader = new FileReader();
            reader.onload = function(e) {
              body.foto = e.target.result;
            };
            await new Promise(resolve => { reader.onload = () => resolve(); reader.readAsDataURL(file); });
          }
        }
        const r=await fetch(in_?'/api/mobile/absensi/clock-in':'/api/mobile/absensi/clock-out',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)});
        const data=await r.json();
        if(!r.ok)throw new Error(data.error||'Gagal');
        showToast(in_?'✅ Clock-in berhasil!':'✅ Clock-out berhasil!','success');
        overlay.classList.add('hidden');
        loadAll();
      }catch(ex){showToast('❌ '+ex.message,'error');btnYa.disabled=false;btnYa.textContent=in_?'Ya, Clock In!':'Ya, Clock Out!';}};
      document.getElementById('modal-batal').onclick=()=>{overlay.classList.add('hidden');btnYa.disabled=false;};
      overlay.addEventListener('click',e=>{if(e.target===overlay){overlay.classList.add('hidden');btnYa.disabled=false;}});
    }

    // ─── Profile Modal ───
    // Click pada avatar atau nama → buka profil
    document.getElementById('avatar-container').style.cursor = 'pointer';
    document.getElementById('avatar-container').addEventListener('click', openProfileModal);
    document.getElementById('nama-karyawan').style.cursor = 'pointer';
    document.getElementById('nama-karyawan').addEventListener('click', openProfileModal);

    function openProfileModal() {
      if (!karyawanData) {
        showToast('Data belum dimuat', 'error');
        return;
      }
      const d = karyawanData;
      document.getElementById('profile-modal-nama').textContent = d.nama || '—';
      document.getElementById('profile-modal-nik').textContent = d.nik || '—';
      document.getElementById('profile-modal-jabatan').textContent = d.jabatan || '';
      document.getElementById('profile-modal-departemen').textContent = d.departemen || '';
      document.getElementById('profile-modal-phone').textContent = d.phone ? 'Telp: ' + d.phone : '';
      
      const ph = document.getElementById('profile-modal-photo');
      const pl = document.getElementById('profile-modal-placeholder');
      if (d.photo) {
        ph.src = d.photo;
        ph.classList.remove('hidden');
        pl.classList.add('hidden');
      } else {
        ph.classList.add('hidden');
        pl.classList.remove('hidden');
      }

      // Reset form
      document.getElementById('cuti-jenis').value = 'Izin';
      document.getElementById('cuti-tanggal-mulai').value = new Date().toISOString().slice(0,10);
      document.getElementById('cuti-tanggal-selesai').value = '';
      document.getElementById('cuti-alasan').value = '';
      hapusDokumenProfil();
      toggleDokumenProfil();

      document.getElementById('profile-modal').classList.remove('hidden');
      document.getElementById('profile-modal').classList.add('flex');
    }

    function closeProfileModal() {
      document.getElementById('profile-modal').classList.add('hidden');
      document.getElementById('profile-modal').classList.remove('flex');
    }

    // ─── Ijin/Cuti Form ───
    function toggleDokumenProfil() {
      const jenis = document.getElementById('cuti-jenis')?.value;
      const wrap = document.getElementById('cuti-dokumen-wrap-profil');
      if (!wrap) return;
      if (jenis === 'Izin') {
        wrap.classList.remove('hidden');
      } else {
        wrap.classList.add('hidden');
        hapusDokumenProfil();
      }
    }

    function previewDokumenProfil(input) {
      const file = input.files[0];
      if (!file) return;
      if (file.size > 2 * 1024 * 1024) {
        showToast('Ukuran file maksimal 2MB', 'error');
        input.value = '';
        return;
      }
      document.getElementById('cuti-dokumen-name').textContent = file.name;
      document.getElementById('cuti-dokumen-hapus').classList.remove('hidden');
      const reader = new FileReader();
      reader.onload = function(e) {
        document.getElementById('cuti-dokumen').value = e.target.result;
      };
      reader.readAsDataURL(file);
    }

    function hapusDokumenProfil() {
      document.getElementById('cuti-dokumen').value = '';
      document.getElementById('cuti-dokumen-input').value = '';
      document.getElementById('cuti-dokumen-name').textContent = '';
      document.getElementById('cuti-dokumen-hapus').classList.add('hidden');
    }

    async function submitCutiProfil() {
      const jenis = document.getElementById('cuti-jenis').value;
      const tglMulai = document.getElementById('cuti-tanggal-mulai').value;
      const tglSelesai = document.getElementById('cuti-tanggal-selesai').value;
      const alasan = document.getElementById('cuti-alasan').value.trim();
      const dokumen = document.getElementById('cuti-dokumen').value;

      if (!tglMulai) {
        showToast('Tanggal mulai wajib diisi', 'error');
        return;
      }
      if (!alasan) {
        showToast('Alasan wajib diisi', 'error');
        return;
      }

      const btn = document.querySelector('#cuti-form-profil button[type="button"]');
      btn.disabled = true;
      btn.innerHTML = '<svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4"/></svg> Mengirim...';

      try {
        const body = {
          jenis,
          tanggal_mulai: tglMulai,
          tanggal_selesai: tglSelesai || null,
          alasan,
          dokumen: dokumen || null
        };
        const r = await fetch('/api/mobile/ijin-cuti', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        const data = await r.json();
        if (!r.ok) throw new Error(data.error || 'Gagal');
        showToast('✅ Pengajuan berhasil dikirim', 'success');
        closeProfileModal();
      } catch (ex) {
        showToast('❌ ' + ex.message, 'error');
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 5v14m-7-7h14"/></svg> Ajukan Ijin/Cuti';
      }
    }

    // Tutup modal profil jika klik backdrop
    document.getElementById('profile-modal').addEventListener('click', function(e) {
      if (e.target === this) closeProfileModal();
    });

    // Logout & Refresh
    document.getElementById('btn-logout').addEventListener('click',async()=>{await fetch('/api/auth/logout',{method:'POST'});window.location.href='/absen';});
    document.getElementById('btn-refresh').addEventListener('click',()=>{loadAll();});


    // Poll notifikasi setiap 60 detik
    // Init
    loadAll();


  </script>
</body>
</html>
