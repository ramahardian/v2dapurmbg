      const h=data.filter(a=>a.status==='Hadir').length,t=data.length,pct=t>0?Math.round(h/t*100):0;
      let html='';
      if(!full&&t>0)html+='<div class="flex items-center gap-2 text-[0.6rem] text-slate-400 mb-3 pb-3 border-b border-slate-100"><span class="text-emerald-600 font-semibold">'+h+'/'+t+' hadir</span><span class="text-slate-200">·</span><span>'+pct+'% kehadiran</span><div class="flex-1 h-1.5 bg-slate-100 rounded-full overflow-hidden ml-1"><div class="h-full rounded-full bg-emerald-500" style="width:'+pct+'%"></div></div></div>';
      data.forEach(a=>{
        const cls=a.status==='Hadir'?'badge-hadir':a.status==='Terlambat'?'badge-terlambat':a.status==='Sakit'?'badge-sakit':a.status==='Izin'?'badge-izin':a.status==='Cuti'?'badge-cuti':a.status==='Alpha'?'badge-alpha':'badge-hadir';
        html+='<div class="flex items-center justify-between py-2.5 border-b border-slate-100 last:border-0"><div class="flex items-center gap-2.5 min-w-0"><span class="text-slate-600 text-xs font-medium w-20 shrink-0">'+escapeHtml(full?fmtDateFull(a.tanggal):fmtDate(a.tanggal))+'</span><span class="badge '+cls+'">'+escapeHtml(a.status)+'</span></div><div class="text-[0.65rem] text-slate-400 font-mono shrink-0 ml-2">'+fmt(a.jam_masuk)+' — '+fmt(a.jam_keluar)+'</div></div>';
      });
      el.innerHTML=html;
    }

    let _photoBase64 = null;
