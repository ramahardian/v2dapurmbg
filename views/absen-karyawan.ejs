<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta http-equiv="Cache-Control" content="no-store, no-cache, must-revalidate">
  <meta http-equiv="Pragma" content="no-cache">
  <meta http-equiv="Expires" content="0">
  <title>Dashboard Absen — Dapur Sukaluyu</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body {
      font-family: 'Inter', sans-serif;
      background: #f1f5f9;
      min-height: 100vh;
      padding-bottom: 2rem;
      color: #1e293b;
    }
    .card {
      background: #fff;
      border: 1px solid #e2e8f0;
      border-radius: 0.75rem;
    }
    .header-bar {
      background: #1e293b;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .spinner {
      width: 1.25rem; height: 1.25rem;
      border: 2px solid #e2e8f0;
      border-top-color: #2563eb;
      border-radius: 50%;
      animation: spin 0.6s linear infinite;
    }
    .skeleton {
      background: #e2e8f0;
      border-radius: 0.5rem;
      animation: pulse 1.5s ease-in-out infinite;
    }
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }
    @keyframes alert-in {
      from { opacity: 0; transform: scale(0.95) translateY(8px); }
      to { opacity: 1; transform: scale(1) translateY(0); }
    }
    .animate-alert-in { animation: alert-in 0.25s ease-out; }
    .badge {
      display: inline-flex;
      align-items: center;
      gap: 0.25rem;
      padding: 0.15rem 0.6rem;
      border-radius: 999px;
      font-size: 0.7rem;
      font-weight: 600;
    }
    .badge-hadir { background: #dcfce7; color: #166534; }
    .badge-sakit { background: #fef9c3; color: #854d0e; }
    .badge-izin { background: #dbeafe; color: #1e40af; }
    .badge-cuti { background: #f3e8ff; color: #6b21a8; }
    .badge-alpha { background: #fee2e2; color: #991b1b; }
    .badge-terlambat { background: #ffedd5; color: #9a3412; }
    .badge-koreksi { background: #fce7f3; color: #9d174d; }
    .btn-clock { cursor: pointer; user-select: none; -webkit-tap-highlight-color: transparent; }

    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      border-radius: 0.75rem;
      font-size: 0.875rem;
      font-weight: 600;
      transition: all 0.2s;
      user-select: none;
      -webkit-tap-highlight-color: transparent;
      border: 2px solid transparent;
    }
    .btn:disabled { opacity: 0.45; cursor: not-allowed; pointer-events: none; }
    .btn-primary { background: #2563eb; color: #fff; border-color: #2563eb; }
    .btn-primary:hover:not(:disabled) { background: #1d4ed8; border-color: #1d4ed8; }
    .btn-primary:active:not(:disabled) { transform: scale(0.97); }
    .btn-success { background: #16a34a; color: #fff; border-color: #16a34a; }
    .btn-success:hover:not(:disabled) { background: #15803d; border-color: #15803d; }
    .btn-outline { background: transparent; border-color: #e2e8f0; color: #94a3b8; }
        .btn-outline:disabled { opacity: 0.45; cursor: not-allowed; pointer-events: none; }
        .photo-error { border-color: #ef4444 !important; background: #fef2f2 !important; }
    .bar { height: 0.5rem; border-radius: 999px; background: #e2e8f0; overflow: hidden; }
    .bar-fill { height: 100%; border-radius: 999px; transition: width 0.5s ease; }

    @media (max-width: 480px) {
      body { padding-bottom: 1rem; }
    }
  </style>
</head>
<body>
  <!-- Header -->
  <header class="header-bar">
    <div class="max-w-lg mx-auto px-4 py-3 flex items-center gap-3">
      <div class="w-10 h-10 rounded-lg bg-white/10 flex items-center justify-center shrink-0" id="avatar-container">
        <img id="profile-photo" src="" alt="" class="w-full h-full object-cover rounded-lg hidden" onerror="this.classList.add('hidden')" />
        <div id="avatar-placeholder" class="w-full h-full flex items-center justify-center">
          <svg class="w-5 h-5 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/></svg>
        </div>
      </div>
      <div class="flex-1 min-w-0">
        <div class="font-bold text-white text-sm truncate" id="nama-karyawan">—</div>
        <div class="flex items-center gap-2 mt-0.5">
          <span class="text-amber-300 text-[0.65rem] font-medium" id="jabatan-karyawan"></span>
          <span class="text-white/20">·</span>
          <span class="text-white/40 text-[0.65rem]" id="nik-karyawan"></span>
        </div>
      </div>
      <div class="flex items-center gap-1">
        <button id="notif-badge-link" class="relative p-2 text-white/40 hover:text-white/80 transition rounded-lg hover:bg-white/10" title="Notifikasi" onclick="openNotifModal()">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width:1.125rem;height:1.125rem"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          <span id="notif-count-mobile" class="absolute -top-0.5 -right-0.5 text-[9px] font-bold bg-red-500 text-white px-1 rounded-full min-w-[14px] text-center hidden">0</span>
        </button>
        <button id="btn-refresh" class="p-2 text-white/40 hover:text-white/80 transition rounded-lg hover:bg-white/10" title="Refresh">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width:1.125rem;height:1.125rem"><path d="M1 4v6h6"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
        </button>
        <button id="btn-logout" class="p-2 text-white/40 hover:text-red-300 transition rounded-lg hover:bg-white/10" title="Keluar">
          <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" style="width:1.125rem;height:1.125rem"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
        </button>
      </div>
    </div>
  </header>

  <main class="max-w-lg mx-auto px-4 pt-4 space-y-3 pb-20">

    <!-- ─── Clock & Greeting ─── -->
    <div class="card p-4">
      <div class="flex items-start justify-between">
        <div>
          <div class="text-slate-500 text-[0.65rem] uppercase tracking-wider font-medium" id="greeting-text">Selamat Datang</div>
          <div class="text-3xl font-bold text-slate-800 tracking-widest font-mono mt-0.5" id="clock-display">--:--:--</div>
          <div class="text-slate-400 text-xs mt-1" id="date-display">—</div>
        </div>
        <div class="text-right">
          <div class="text-slate-400 text-[0.6rem] uppercase tracking-wider" id="network-status">● Online</div>
        </div>
      </div>
    </div>

    <!-- ─── Shift Info ─── -->
    <div id="shift-card" class="card p-4">
      <div class="flex items-center gap-3">
        <div class="w-10 h-10 rounded-lg bg-amber-100 flex items-center justify-center shrink-0">
          <svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <div class="flex-1 min-w-0">
          <div class="text-slate-500 text-[0.6rem] uppercase tracking-wider font-medium">Shift Hari Ini</div>
          <div class="text-slate-800 font-semibold text-sm" id="shift-nama">—</div>
        </div>
        <div class="text-right">
          <div class="text-slate-700 text-sm font-mono font-semibold" id="shift-jam">--:--</div>
          <div class="text-slate-400 text-[0.6rem] uppercase tracking-wider" id="shift-jam-label">—</div>
        </div>
      </div>
      <div id="shift-progress-wrap" class="mt-3">
        <div class="bar">
          <div id="shift-progress" class="bar-fill bg-amber-500" style="width:0%"></div>
        </div>
        <div class="flex justify-between text-[0.6rem] text-slate-400 mt-1">
          <span id="shift-label-masuk">Mulai</span>
          <span id="shift-status-text" class="text-slate-500">—</span>
          <span id="shift-label-keluar">Selesai</span>
        </div>
      </div>
    </div>

    <!-- ─── Status Absensi ─── -->
    <div class="card p-4">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-slate-800 font-bold text-sm">Status Hari Ini</h2>
        <span class="text-slate-400 text-[0.65rem]" id="tanggal-hari-ini"></span>
      </div>
      <div id="status-skeleton" class="space-y-3">
        <div class="skeleton h-20 w-full"></div>
      </div>
      <div id="status-content" class="hidden space-y-3"></div>
    </div>

    <!-- ─── Tombol Absen ─── -->
    <div id="absen-buttons" class="grid grid-cols-2 gap-3">
      <button id="btn-clock-in" class="btn h-16 btn-outline" disabled>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span>Clock In</span>
      </button>
      <button id="btn-clock-out" class="btn h-16 btn-outline" disabled>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <span>Clock Out</span>
      </button>
    </div>



    <!-- ─── Riwayat Absen ─── -->
    <div class="card p-4">
      <div class="flex items-center justify-between mb-1">
        <h2 class="text-slate-800 font-bold text-sm">Riwayat Absen</h2>
        <button id="btn-lihat-semua" class="text-blue-600/70 hover:text-blue-600 text-[0.65rem] font-medium transition hidden">Lihat Semua</button>
      </div>
      <div id="riwayat-skeleton" class="space-y-2 pt-2">
        <div class="skeleton h-10 w-full"></div>
        <div class="skeleton h-10 w-full"></div>
        <div class="skeleton h-10 w-full"></div>
      </div>
      <div id="riwayat-content" class="hidden pt-1"></div>
    </div>

  </main>

  <!-- ─── Modal Profil Karyawan ─── -->
  <div id="profile-modal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl w-full max-w-md max-h-[90vh] overflow-y-auto shadow-xl">
      <div class="sticky top-0 bg-white z-10 px-5 py-4 border-b border-stone-200 flex items-center justify-between">
        <h3 class="font-bold text-base text-stone-800">Profil Karyawan</h3>
        <button onclick="closeProfileModal()" class="w-8 h-8 flex items-center justify-center rounded-lg text-stone-400 hover:text-stone-600 hover:bg-stone-100 transition-all">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      
      <div class="p-5 space-y-5">
        <div class="flex items-center gap-4">
          <div class="w-16 h-16 rounded-full bg-stone-100 flex items-center justify-center shrink-0 overflow-hidden" id="profile-modal-avatar">
            <img id="profile-modal-photo" src="" alt="" class="w-full h-full object-cover hidden" />
            <div id="profile-modal-placeholder" class="w-full h-full flex items-center justify-center">
              <svg class="w-8 h-8 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="8.5" cy="7" r="4"/></svg>
            </div>
          </div>
          <div class="min-w-0 flex-1">
            <div class="font-bold text-lg text-stone-800 truncate" id="profile-modal-nama">—</div>
            <div class="text-xs text-stone-500 mt-0.5">NIK <span id="profile-modal-nik">—</span></div>
            <div class="flex items-center gap-2 mt-1">
              <span class="text-xs font-medium text-amber-600" id="profile-modal-jabatan"></span>
              <span class="text-xs text-stone-300">·</span>
              <span class="text-xs text-stone-500" id="profile-modal-departemen"></span>
            </div>
            <div class="text-xs text-stone-400 mt-0.5" id="profile-modal-phone"></div>
          </div>
        </div>

        <hr class="border-stone-100" />

        <div>
          <h4 class="text-xs font-bold uppercase tracking-wider text-stone-500 mb-3">Ajukan Ijin / Cuti</h4>
          <form id="cuti-form-profil" class="space-y-4" onsubmit="return false;">
            <div class="grid grid-cols-2 gap-3">
              <div>
                <label class="text-xs font-semibold text-stone-600 uppercase tracking-wider">Jenis <span class="text-red-500">*</span></label>
                <select id="cuti-jenis" onchange="toggleDokumenProfil()" class="mt-1.5 w-full h-11 px-3 rounded-lg border border-stone-200 text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 transition-all">
                  <option value="Izin">Izin</option>
                  <option value="Cuti">Cuti</option>
                </select>
              </div>
              <div>
                <label class="text-xs font-semibold text-stone-600 uppercase tracking-wider">Tanggal Mulai <span class="text-red-500">*</span></label>
                <input id="cuti-tanggal-mulai" type="date" class="mt-1.5 w-full h-11 px-3 rounded-lg border border-stone-200 text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 transition-all" />
              </div>
            </div>
            <div>
              <label class="text-xs font-semibold text-stone-600 uppercase tracking-wider">Tanggal Selesai</label>
              <input id="cuti-tanggal-selesai" type="date" class="mt-1.5 w-full h-11 px-3 rounded-lg border border-stone-200 text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 transition-all" />
            </div>
            <div id="cuti-dokumen-wrap-profil">
              <label class="text-xs font-semibold text-stone-600 uppercase tracking-wider">Upload Dokumen</label>
              <p class="text-[10px] text-stone-400 mt-0.5">Surat sakit / izin (opsional, maks 2MB)</p>
              <div class="flex items-center gap-2 mt-1.5">
                <button type="button" onclick="document.getElementById('cuti-dokumen-input').click()" class="h-9 px-3 text-xs font-medium border border-stone-200 rounded-lg hover:bg-stone-50 shadow-sm transition-all">Pilih File</button>
                <span id="cuti-dokumen-name" class="text-xs text-stone-500 truncate"></span>
                <input type="file" id="cuti-dokumen-input" accept=".pdf,.jpg,.jpeg,.png" class="hidden" onchange="previewDokumenProfil(this)" />
                <input type="hidden" id="cuti-dokumen" value="" />
                <button type="button" id="cuti-dokumen-hapus" onclick="hapusDokumenProfil()" class="hidden text-xs font-medium text-red-600 hover:text-red-800">Hapus</button>
              </div>
            </div>
            <div>
              <label class="text-xs font-semibold text-stone-600 uppercase tracking-wider">Alasan</label>
              <textarea id="cuti-alasan" class="mt-1.5 w-full px-3 py-2.5 rounded-lg border border-stone-200 text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 transition-all" rows="2" placeholder="Alasan izin/cuti..."></textarea>
            </div>
            <button type="button" onclick="submitCutiProfil()" class="w-full h-11 bg-[#1e40af] hover:bg-[#1d4ed8] text-white rounded-xl text-sm font-semibold shadow-sm flex items-center justify-center gap-2 transition-all">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 5v14m-7-7h14"/></svg>
              Ajukan Ijin/Cuti
            </button>
          </form>
        </div>
      </div>
    </div>
  </div>





  <style>
    @keyframes slideUp {
      from { opacity: 0; transform: translateY(20px); }
      to { opacity: 1; transform: translateY(0); }
    }
  </style>

  <!-- ─── Modal Konfirmasi ─── -->
  <div id="modal-overlay" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl w-full max-w-sm p-6 space-y-5 shadow-xl">
      <div class="text-center">
        <div id="modal-icon" class="w-16 h-16 mx-auto mb-3 rounded-2xl flex items-center justify-center bg-amber-100">
          <svg class="w-8 h-8 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        </div>
        <h3 class="font-bold text-lg text-stone-800" id="modal-title">Konfirmasi</h3>
        <p class="text-stone-500 text-sm mt-1" id="modal-desc">Apakah Anda yakin?</p>
      </div>
      
      <!-- Camera Capture Section (WAJIB) -->
      <div id="modal-photo-container" class="hidden">
        <div class="text-xs font-medium text-stone-500 mb-2 mt-2">Foto Bukti Absen <span class="text-red-500 font-bold text-xs ml-1">* Wajib</span></div>
        <div id="modal-camera-area" class="relative w-full aspect-[4/3] max-h-48 rounded-xl border-2 border-dashed border-stone-300 bg-stone-50 flex items-center justify-center overflow-hidden transition-all">
          <video id="modal-camera-video" class="w-full h-full object-cover hidden" autoplay playsinline></video>
          <canvas id="modal-camera-canvas" class="hidden"></canvas>
          <div id="modal-photo-preview" class="w-full h-full hidden">
            <img id="modal-photo-img" src="" alt="Bukti Absen" class="w-full h-full object-cover">
          </div>
          <div id="modal-camera-start" class="flex flex-col items-center gap-2 cursor-pointer" onclick="startCamera()">
            <svg class="w-10 h-10 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>
            <span class="text-stone-500 text-sm font-medium">Buka Kamera</span>
            <span class="text-stone-400 text-[10px]">Izinkan akses kamera untuk foto</span>
          </div>
          <div id="modal-camera-loading" class="hidden flex-col items-center gap-2">
            <svg class="animate-spin w-8 h-8 text-blue-500" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
            <span class="text-stone-500 text-xs">Mengakses kamera...</span>
          </div>
          <div id="modal-camera-active" class="hidden absolute inset-0">
            <div class="absolute bottom-3 left-0 right-0 flex justify-center gap-4 z-10">
              <button type="button" onclick="capturePhoto()" class="w-14 h-14 rounded-full bg-white border-4 border-blue-500 shadow-lg flex items-center justify-center hover:scale-105 transition-transform active:scale-95">
                <div class="w-10 h-10 rounded-full bg-blue-500"></div>
              </button>
            </div>
          </div>
          <div id="modal-camera-retake" class="hidden absolute inset-0">
            <div class="absolute bottom-3 left-0 right-0 flex justify-center gap-4 z-10">
              <button type="button" onclick="retakePhoto()" class="px-5 py-2.5 bg-white/90 backdrop-blur rounded-full text-sm font-medium text-stone-700 shadow-lg hover:bg-white transition-all flex items-center gap-2">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="1 4 1 10 7 10"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
                Ambil Ulang
              </button>
            </div>
          </div>
        </div>
        <div id="modal-photo-status" class="flex items-center gap-2 mt-1.5">
          <div id="modal-photo-error" class="hidden text-xs text-red-500 flex items-center gap-1.5">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span>Foto wajib diambil</span>
          </div>
          <div id="modal-photo-compressing" class="hidden text-xs text-blue-600 flex items-center gap-1.5">
            <svg class="animate-spin w-3.5 h-3.5" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg>
            <span>Memproses foto...</span>
          </div>
          <div id="modal-photo-ok" class="hidden text-xs text-emerald-600 flex items-center gap-1.5">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
            <span id="modal-photo-ok-text">Foto berhasil diambil</span>
          </div>
          <div id="modal-photo-camera-off" class="hidden text-xs text-amber-600 flex items-center gap-1.5">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span>Kamera tidak tersedia — <a href="#" onclick="event.preventDefault();openFilePicker()" class="underline font-medium">pilih dari galeri</a></span>
          </div>
        </div>
      </div>
      <input type="file" id="modal-photo-file" class="hidden" accept="image/*" capture="environment">
      
      <div class="flex gap-3">
        <button id="modal-batal" class="flex-1 h-11 rounded-xl border border-stone-200 text-sm font-medium text-stone-600 hover:bg-stone-50 shadow-sm transition-all">Batal</button>
        <button id="modal-ya" class="flex-1 h-11 rounded-xl bg-blue-600 hover:bg-blue-700 text-white text-sm font-semibold shadow-sm transition-all">Ya, Absen!</button>
      </div>
    </div>
  </div>

  <!-- ─── Modal Notifikasi (Enhanced) ─── -->
  <div id="notif-modal" class="fixed inset-0 bg-black/50 z-50 hidden flex items-center justify-center p-2 sm:p-4">
    <div class="bg-white rounded-2xl w-full max-w-md max-h-[90vh] flex flex-col shadow-xl">
      <!-- Header: Inbox -->
      <div id="notif-modal-header-inbox" class="sticky top-0 bg-white z-10 px-4 sm:px-5 py-3 border-b border-stone-200 flex items-center justify-between rounded-t-2xl">
        <div class="flex items-center gap-2">
          <svg class="w-5 h-5 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          <h3 class="font-bold text-base text-stone-800">Notifikasi</h3>
          <span id="notif-modal-count" class="text-[10px] font-bold bg-blue-100 text-blue-700 px-1.5 py-0.5 rounded-full hidden"></span>
        </div>
        <div class="flex items-center gap-1">
          <button onclick="notifRefresh()" class="p-2 text-stone-400 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition" title="Segarkan">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M1 4v6h6"/><path d="M3.51 15a9 9 0 1 0 2.13-9.36L1 10"/></svg>
          </button>
          <button onclick="showNotifForm()" class="p-2 text-blue-600 hover:bg-blue-100 rounded-lg transition" title="Pesan Baru">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </button>
          <button onclick="closeNotifModal()" class="p-2 text-stone-400 hover:text-stone-600 hover:bg-stone-100 rounded-lg transition">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
          </button>
        </div>
      </div>
      <!-- Header: Detail -->
      <div id="notif-modal-header-detail" class="sticky top-0 bg-white z-10 px-4 sm:px-5 py-3 border-b border-stone-200 flex items-center gap-3 rounded-t-2xl hidden">
        <button onclick="loadNotifList()" class="p-1.5 text-stone-400 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <h3 class="font-bold text-base text-stone-800 truncate flex-1" id="notif-detail-title">Detail Pesan</h3>
        <button onclick="closeNotifModal()" class="p-2 text-stone-400 hover:text-stone-600 hover:bg-stone-100 rounded-lg transition shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <!-- Header: Compose -->
      <div id="notif-modal-header-compose" class="sticky top-0 bg-white z-10 px-4 sm:px-5 py-3 border-b border-stone-200 flex items-center gap-3 rounded-t-2xl hidden">
        <button onclick="loadNotifList()" class="p-1.5 text-stone-400 hover:text-blue-600 hover:bg-blue-50 rounded-lg transition">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
        </button>
        <h3 class="font-bold text-base text-stone-800" id="notif-compose-title">Pesan Baru</h3>
        <div class="flex-1"></div>
        <button onclick="closeNotifModal()" class="p-2 text-stone-400 hover:text-stone-600 hover:bg-stone-100 rounded-lg transition shrink-0">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>
      <!-- Content area -->
      <div id="notif-modal-content" class="flex-1 overflow-y-auto">
        <div id="notif-list" class="min-h-[200px]"></div>
      </div>
    </div>
  </div>

  <!-- ─── Toast Container ─── -->
  <div class="fixed bottom-4 left-1/2 -translate-x-1/2 z-50 flex flex-col gap-2 pointer-events-none" id="toast-container"></div>

  <script>
    let karyawanData = null, absenStatus = null, rekapData = null, riwayatExpanded = false;

    function escapeHtml(str) {
      const div = document.createElement('div');
      div.textContent = str || '';
      return div.innerHTML;
    }
    function fmt(t) { if (!t) return '—'; const p = t.split(':'); return p[0]+':'+p[1]; }
    function fmtFull(t) { if (!t) return '—'; const p = t.split(':'); return p[0]+':'+p[1]+':'+(p[2]||'00'); }
    function toMin(t) { if (!t) return 0; const p = t.split(':'); return +p[0]*60+ +p[1]; }
    function parseDate(d) {
      if (!d) return null;
      const ds = d.includes('T') ? d : d+'T00:00:00';
      const dd = new Date(ds);
      return isNaN(dd.getTime()) ? null : dd;
    }
    function fmtDate(d) { const dd = parseDate(d); if (!dd) return '—'; const m = ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des']; return dd.getDate()+' '+m[dd.getMonth()]; }
    function fmtDateFull(d) { const dd = parseDate(d); if (!dd) return '—'; const m = ['Jan','Feb','Mar','Apr','Mei','Jun','Jul','Agu','Sep','Okt','Nov','Des']; return dd.getDate()+' '+m[dd.getMonth()]+' '+dd.getFullYear(); }

    function showToast(msg, type) {
      const c = document.getElementById('toast-container');
      const t = document.createElement('div');
      t.className = 'pointer-events-auto bg-white border border-slate-200 text-slate-800 px-4 py-2.5 rounded-lg text-sm flex items-center gap-2.5 shadow-lg transform translate-y-2 opacity-0 transition-all duration-300 max-w-[90vw] '+(type==='error'?'border-red-200 bg-red-50 text-red-700':'border-emerald-200 bg-emerald-50 text-emerald-700');
      t.innerHTML = (type==='error'
        ? '<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>'
        : '<svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>')
        + '<span>'+escapeHtml(msg)+'</span>';
      c.appendChild(t);
      requestAnimationFrame(() => { t.classList.remove('translate-y-2','opacity-0'); });
      setTimeout(() => { t.classList.add('translate-y-2','opacity-0'); setTimeout(() => t.remove(), 300); }, 3000);
    }

    // Clock
    function updateClock() {
      const n = new Date();
      document.getElementById('clock-display').textContent = n.toLocaleTimeString('id-ID',{hour:'2-digit',minute:'2-digit',second:'2-digit',hour12:false});
      document.getElementById('date-display').textContent = n.toLocaleDateString('id-ID',{weekday:'long',year:'numeric',month:'long',day:'numeric'});
      document.getElementById('tanggal-hari-ini').textContent = n.toLocaleDateString('id-ID',{weekday:'long',day:'numeric',month:'short'});
      const h = n.getHours();
      let g = 'Selamat Malam';
      if (h>=4&&h<11) g='Selamat Pagi'; else if (h>=11&&h<15) g='Selamat Siang'; else if (h>=15&&h<18) g='Selamat Sore';
      document.getElementById('greeting-text').textContent = g;
    }
    updateClock(); setInterval(updateClock, 1000);

    // Network
    if (navigator.onLine !== undefined) {
      const u = () => { const e=document.getElementById('network-status'); e.textContent=navigator.onLine?'● Online':'○ Offline'; e.style.color=navigator.onLine?'#16a34a':'#dc2626'; };
      window.addEventListener('online',u); window.addEventListener('offline',u); u();
    }
    

    async function loadNotifCount() {
      try {
        const r = await fetch('/api/notifikasi/belum-dibaca', { credentials: 'include' });
        if (r.ok) {
          const d = await r.json();
          const count = (d && d.count) || 0;
          const link = document.getElementById('notif-badge-link');
          const badge = document.getElementById('notif-count-mobile');
          if (link) link.classList.remove('hidden');
          if (badge && count > 0) {
            badge.textContent = count > 99 ? '99+' : count;
            badge.classList.remove('hidden');
          }
        }
      } catch(e) { /* silent */ }
    }

    // Load All
    async function loadAll() {
      try {
        const pRes = await fetch('/api/mobile/profile?_='+Date.now());
        if (!pRes.ok) {
          if (pRes.status===401) { showToast('Sesi habis, silakan login ulang','error'); setTimeout(()=>{window.location.href='/absen'},1500); }
          else { const pErr=await pRes.json().catch(()=>({})); showSkeleton('status',false); showSkeleton('statistik',false); showSkeleton('riwayat',false); showToast(pErr.error||'Gagal memuat profil','error'); }
          return;
        }
        const pData = await pRes.json();
        karyawanData = pData.data;
        _tenantNama = pData.tenant || '';
        document.getElementById('nama-karyawan').textContent = karyawanData.nama;
        document.getElementById('jabatan-karyawan').textContent = karyawanData.jabatan || '—';
        document.getElementById('nik-karyawan').textContent = 'NIK ' + (karyawanData.nik || '—');
        const ph = document.getElementById('profile-photo');
        if (karyawanData.photo) { ph.src=karyawanData.photo; ph.classList.remove('hidden'); document.getElementById('avatar-placeholder').classList.add('hidden'); }

        const [statusRes,rekapRes,shiftRes,riwayatRes] = await Promise.all([
          fetch('/api/mobile/absensi/status?_='+Date.now()),
          fetch('/api/mobile/absensi/rekap?_='+Date.now()),
          fetch('/api/mobile/absensi/shift-saya?_='+Date.now()),
          fetch('/api/mobile/absensi/riwayat?limit=5&_='+Date.now())
        ]);
        if (statusRes.ok) { absenStatus=await statusRes.json(); renderStatus(absenStatus); renderButtons(absenStatus); }
        if (rekapRes.ok) { rekapData=await rekapRes.json(); }
        if (shiftRes.ok) { renderShift(await shiftRes.json()); }
        if (riwayatRes.ok) { renderRiwayat(await riwayatRes.json()); }
        else { document.getElementById('riwayat-content').innerHTML='<div class="text-center py-6 text-slate-400 text-sm">Gagal memuat riwayat</div>'; showSkeleton('riwayat',false); }
      } catch(ex) { console.error('Load error:',ex); showSkeleton('status',false); showSkeleton('statistik',false); showSkeleton('riwayat',false); showToast('Gagal memuat data: '+ex.message,'error'); }
    }

    function showSkeleton(id, show) {
      const s=document.getElementById(id+'-skeleton'), c=document.getElementById(id+'-content');
      if(s) s.classList.toggle('hidden',!show); if(c) c.classList.toggle('hidden',show);
    }

    // Render Status
    function renderStatus(s) {
      showSkeleton('status',false);
      const el = document.getElementById('status-content');
      if (!s.sudah_absensi) {
        if (s.terkunci) {
          if (s.hari_libur) {
            el.innerHTML = '<div class="flex items-start gap-3 bg-violet-50 border border-violet-200 rounded-lg p-4">'
              +'<div class="w-10 h-10 rounded-lg bg-violet-100 flex items-center justify-center shrink-0">'
              +'<svg class="w-5 h-5 text-violet-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg></div>'
              +'<div><div class="font-semibold text-violet-700">Hari Libur</div><div class="text-xs text-violet-500 mt-0.5">Hari ini libur. Silakan nikmati hari libur Anda! 🎉</div></div></div>';
          } else if (s.bolos) {
            el.innerHTML = '<div class="flex items-start gap-3 bg-red-50 border border-red-200 rounded-lg p-4">'
              +'<div class="w-10 h-10 rounded-lg bg-red-100 flex items-center justify-center shrink-0">'
              +'<svg class="w-5 h-5 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg></div>'
              +'<div><div class="font-semibold text-red-700">Bolos!</div><div class="text-xs text-red-500 mt-0.5">Anda belum sama sekali absen hari ini. Akan dicatat sebagai BOLOS.</div></div></div>'
          } else {
            el.innerHTML = '<div class="flex items-start gap-3 bg-slate-100 border border-slate-200 rounded-lg p-4">'
              +'<div class="w-10 h-10 rounded-lg bg-slate-200 flex items-center justify-center shrink-0">'
              +'<svg class="w-5 h-5 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg></div>'
              +'<div><div class="font-semibold text-slate-600">Absen Terkunci</div><div class="text-xs text-slate-400 mt-0.5">Belum waktunya absen. Clock-in dibuka 30 menit sebelum shift dimulai.</div></div></div>';
          }
        } else if (s.peringatan_terlambat) {
          el.innerHTML = '<div class="flex items-center gap-3 bg-orange-50 border border-orange-200 rounded-lg p-4">'
            +'<div class="w-10 h-10 rounded-lg bg-orange-100 flex items-center justify-center shrink-0">'
            +'<svg class="w-5 h-5 text-orange-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></div>'
            +'<div><div class="font-semibold text-orange-700">Terlambat!</div><div class="text-xs text-orange-500 mt-0.5">Anda melewati batas toleransi 15 menit. Clock-in sekarang akan dicatat sebagai TERLAMBAT.</div></div></div>';
        } else {
          el.innerHTML = '<div class="flex items-center gap-3 bg-amber-50 border border-amber-200 rounded-lg p-4">'
            +'<div class="w-10 h-10 rounded-lg bg-amber-100 flex items-center justify-center shrink-0">'
            +'<svg class="w-5 h-5 text-amber-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg></div>'
            +'<div><div class="font-semibold text-slate-800">Belum Absen</div><div class="text-xs text-slate-500 mt-0.5">Silakan clock-in untuk memulai</div></div></div>';
        }
        return;
      }
      const d=s.data, ok=d.jam_masuk&&d.jam_keluar;
      let badge='';
      if (d.status) {
        const m={'Hadir':'badge-hadir','Sakit':'badge-sakit','Izin':'badge-izin','Cuti':'badge-cuti','Alpha':'badge-alpha','Terlambat':'badge-terlambat','Butuh Koreksi':'badge-koreksi'};
        badge='<span class="badge '+(m[d.status]||'badge-hadir')+'">'+escapeHtml(d.status)+'</span>';
        if (s.butuh_koreksi && !badge.includes('Koreksi')) badge += '<span class="badge badge-koreksi ml-1">Perlu Koreksi</span>';
      }
      el.innerHTML = '<div class="flex gap-4">'
        +'<div class="flex flex-col items-center pt-1">'
        +'<div class="w-3 h-3 rounded-full '+(d.jam_masuk?'bg-emerald-500':'bg-slate-200')+'"></div>'
        +'<div class="w-0.5 flex-1 my-1 '+(ok?'bg-emerald-300':d.jam_masuk?'bg-amber-300':'bg-slate-200')+'"></div>'
        +'<div class="w-3 h-3 rounded-full '+(ok?'bg-emerald-500':'bg-slate-200')+'"></div></div>'
        +'<div class="flex-1 min-w-0 space-y-4">'
        +'<div class="'+(d.jam_masuk?'':'opacity-40')+'">'
        +'<div class="flex items-center justify-between"><div class="text-xs text-slate-500 font-medium">Clock In</div>'
        +(badge?'<div class="flex items-center gap-1">'+badge+'</div>':'')
        +'</div>'
        +'<div class="flex items-center justify-between mt-1"><div class="text-lg font-bold text-slate-800 font-mono">'+fmtFull(d.jam_masuk)+'</div>'
        +'<div class="text-xs text-emerald-600 font-medium">'+(d.jam_masuk?'✓ Sudah masuk':'Belum')+'</div></div></div>'
        +'<div class="'+(d.jam_masuk?(!d.jam_keluar?'opacity-50':''):'opacity-20')+'">'
        +'<div class="text-xs text-slate-500 font-medium">Clock Out</div>'
        +'<div class="flex items-center justify-between mt-1"><div class="text-lg font-bold text-slate-800 font-mono">'+fmtFull(d.jam_keluar)+'</div>'
        +'<div class="text-xs font-medium '+(ok?'text-emerald-600':d.jam_masuk?'text-amber-600':'text-slate-300')+'">'+(ok?'✓ Selesai':d.jam_masuk?'● Belum':'—')+'</div></div></div></div></div>'
        +(s.deadline_lewat?'<div class="mt-2 bg-red-50 border border-red-200 rounded-lg p-3 flex items-start gap-2">'
          +'<svg class="w-4 h-4 text-red-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>'
          +'<div><div class="font-semibold text-red-700 text-sm">Batas Clock-Out Habis</div>'
          +'<div class="text-red-600/70 text-xs mt-0.5">'+escapeHtml(s.pesan_deadline||'Batas waktu clock-out sudah lewat. Hubungi admin untuk koreksi.')+'</div></div></div>':'')
        +(s.pesan_early?'<div class="mt-2 bg-amber-50 border border-amber-200 rounded-lg p-3 flex items-start gap-2">'
          +'<svg class="w-4 h-4 text-amber-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>'
          +'<div><div class="font-semibold text-amber-700 text-sm">Belum Waktunya Clock-Out</div>'
          +'<div class="text-amber-600/70 text-xs mt-0.5">'+escapeHtml(s.pesan_early)+'</div></div></div>':'');
    }

    // Render Buttons
    function renderButtons(s) {
      const ci=document.getElementById('btn-clock-in'), co=document.getElementById('btn-clock-out');
      
      // Case: sudah clock-in, belum clock-out, tapi belum waktunya
      if (s.pesan_early && s.sudah_masuk && !s.sudah_keluar) {
        ci.className='h-16 btn btn-success cursor-default';
        ci.innerHTML='<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg><span>Sudah Clock In</span>';
        ci.disabled=true; ci.onclick=null;
        co.className='h-16 btn btn-outline text-amber-500 cursor-not-allowed';
        co.innerHTML='<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg><span>Belum Waktunya</span>';
        co.disabled=true; co.onclick=null;
        return;
      }
      
      // Deadline lewat: sudah clock-in tapi batas clock-out habis
      if (s.deadline_lewat) {
        ci.className='h-16 btn btn-success cursor-default';
        ci.innerHTML='<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg><span>Sudah Clock In</span>';
        ci.disabled=true; ci.onclick=null;
        co.className='h-16 btn btn-outline text-red-400 cursor-not-allowed';
        co.innerHTML='<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg><span>Batas Habis</span>';
        co.disabled=true; co.onclick=null;
        return;
      }
      
      // Jika terkunci, disable kedua tombol
      if (s.terkunci) {
        if (s.hari_libur) {
          ci.className='h-16 btn btn-outline text-violet-400 cursor-not-allowed';
          ci.innerHTML='<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg><span>Hari Libur</span>';
          ci.disabled=true; ci.onclick=null;
          co.className='h-16 btn btn-outline text-violet-400 cursor-not-allowed';
          co.innerHTML='<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg><span>Hari Libur</span>';
          co.disabled=true; co.onclick=null;
        } else if (s.bolos) {
          ci.className='h-16 btn btn-outline text-red-400 cursor-not-allowed';
          ci.innerHTML='<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg><span>Bolos</span>';
          ci.disabled=true; ci.onclick=null;
          co.className='h-16 btn btn-outline text-red-400 cursor-not-allowed';
