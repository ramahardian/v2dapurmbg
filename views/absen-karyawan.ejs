    async function bukaSemuaPesan() {

      const body = document.getElementById('pesan-modal-body');
      const title = document.getElementById('pesan-modal-title');
      const modal = document.getElementById('pesan-modal');

      title.textContent = 'Semua Pesan';
      body.innerHTML = '<div class="flex items-center justify-center py-12"><div class="spinner"></div></div>';
      modal.classList.remove('hidden');

      try {
        const r = await fetch('/api/notifikasi/saya?limit=50&_='+Date.now());
        if (!r.ok) throw new Error('Gagal');
        const data = await r.json();

        if (!data.data.length) {
          body.innerHTML = '<div class="text-center py-12 text-sm text-slate-400">Belum ada pesan</div>';
          return;
        }

        body.innerHTML = data.data.map(function(n) {
          var isNew = !n.is_read;
          var d = new Date(n.created_at);
          var timeStr = d.toLocaleDateString('id-ID', { weekday:'short', day:'numeric', month:'short', hour:'2-digit', minute:'2-digit' });
          return '<div class="flex items-start gap-3 px-4 py-3.5 rounded-xl cursor-pointer transition ' + (isNew ? 'bg-blue-50/60' : 'hover:bg-slate-50') + '" style="border-bottom:1px solid #f1f5f9" onclick="bukaDetailPesan(' + n.id + ')">' +
            (isNew ? '<span class="w-2.5 h-2.5 rounded-full bg-blue-500 shrink-0 mt-1.5"></span>' : '<span class="w-2.5 h-2.5 shrink-0 mt-1.5"></span>') +
            '<div class="min-w-0 flex-1">' +
              '<div class="text-sm font-semibold text-slate-800">' + escapeHtml(n.judul) + '</div>' +
              (n.pesan ? '<div class="text-xs text-slate-500 mt-0.5 line-clamp-1">' + escapeHtml(n.pesan) + '</div>' : '') +
              '<div class="text-[10px] text-slate-400 mt-1">' + (n.pengirim_nama ? 'Dari: ' + escapeHtml(n.pengirim_nama) + ' · ' : '') + timeStr + '</div>' +
            '</div>' +
            '<svg class="w-4 h-4 text-slate-300 shrink-0 mt-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>' +
          '</div>';
        }).join('');

        if (data.pagination && data.pagination.total_pages > 1) {
          body.innerHTML += '<div class="text-center pt-3 pb-1 text-xs text-slate-400">Menampilkan ' + Math.min(50, data.pagination.total) + ' dari ' + data.pagination.total + ' pesan</div>';
        }
      } catch(e) {
        body.innerHTML = '<div class="text-center py-10 text-sm text-red-500">Gagal memuat pesan</div>';
      }
