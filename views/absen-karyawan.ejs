        return;
      }
      document.getElementById('cuti-dokumen-name').textContent = file.name;
      document.getElementById('cuti-dokumen-hapus').classList.remove('hidden');
      const reader = new FileReader();
      reader.onload = function(e) {
        document.getElementById('cuti-dokumen').value = e.target.result;
      };
      reader.readAsDataURL(file);
    }

    function hapusDokumenProfil() {
      document.getElementById('cuti-dokumen').value = '';
      document.getElementById('cuti-dokumen-input').value = '';
      document.getElementById('cuti-dokumen-name').textContent = '';
      document.getElementById('cuti-dokumen-hapus').classList.add('hidden');
    }

    async function submitCutiProfil() {
      const jenis = document.getElementById('cuti-jenis').value;
      const tglMulai = document.getElementById('cuti-tanggal-mulai').value;
      const tglSelesai = document.getElementById('cuti-tanggal-selesai').value;
      const alasan = document.getElementById('cuti-alasan').value.trim();
      const dokumen = document.getElementById('cuti-dokumen').value;

      if (!tglMulai) {
        showToast('Tanggal mulai wajib diisi', 'error');
        return;
      }
      if (!alasan) {
        showToast('Alasan wajib diisi', 'error');
        return;
      }

      const btn = document.querySelector('#cuti-form-profil button[type="button"]');
      btn.disabled = true;
      btn.innerHTML = '<svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4"/></svg> Mengirim...';

      try {
        const body = {
          jenis,
          tanggal_mulai: tglMulai,
          tanggal_selesai: tglSelesai || null,
          alasan,
          dokumen: dokumen || null
        };
        const r = await fetch('/api/mobile/ijin-cuti', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(body)
        });
        const data = await r.json();
        if (!r.ok) throw new Error(data.error || 'Gagal');
        showToast('✅ Pengajuan berhasil dikirim', 'success');
        closeProfileModal();
      } catch (ex) {
        showToast('❌ ' + ex.message, 'error');
      } finally {
        btn.disabled = false;
        btn.innerHTML = '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 5v14m-7-7h14"/></svg> Ajukan Ijin/Cuti';
      }
    }

    // Tutup modal jika klik backdrop
    document.getElementById('profile-modal').addEventListener('click', function(e) {
      if (e.target === this) closeProfileModal();
    });
    document.getElementById('notif-modal').addEventListener('click', function(e) {
      if (e.target === this) closeNotifModal();
    });

    // Logout & Refresh
    document.getElementById('btn-logout').addEventListener('click',async()=>{await fetch('/api/auth/logout',{method:'POST'});window.location.href='/absen';});
    document.getElementById('btn-refresh').addEventListener('click',()=>{loadAll();});


    // ─── Notifikasi Modal (Enhanced) ───
    let notifData = [];

    function notifAvatarColor(name) {
      var colors = ['bg-blue-500','bg-emerald-500','bg-violet-500','bg-rose-500','bg-amber-500','bg-cyan-500','bg-pink-500','bg-teal-500','bg-orange-500','bg-indigo-500'];
      var hash = 0;
      for (var i = 0; i < (name||'').length; i++) hash = (hash * 31 + name.charCodeAt(i)) | 0;
      return colors[Math.abs(hash) % colors.length];
    }
    function notifInitials(name) {
      if (!name) return '?';
      var parts = name.split(' ');
      return parts.length > 1 ? (parts[0][0] + parts[1][0]).toUpperCase() : name.substring(0, 2).toUpperCase();
    }
    function notifTimeAgo(dateStr) {
      var d = new Date(dateStr);
      var now = new Date();
      var diff = Math.floor((now - d) / 1000);
      if (diff < 60) return 'Baru saja';
      if (diff < 3600) return Math.floor(diff/60) + 'm';
      if (diff < 86400) return Math.floor(diff/3600) + 'j';
      if (diff < 172800) return 'Kemarin';
      if (diff < 604800) return Math.floor(diff/86400) + ' hari lalu';
      return d.toLocaleDateString('id-ID', { day:'numeric', month:'short' });
    }

    async function openNotifModal() {
      document.getElementById('notif-modal').classList.remove('hidden');
      await loadNotifList();
    }

    function notifShowHeaders(view) {
      document.getElementById('notif-modal-header-inbox').classList.toggle('hidden', view !== 'inbox');
      document.getElementById('notif-modal-header-detail').classList.toggle('hidden', view !== 'detail');
      document.getElementById('notif-modal-header-compose').classList.toggle('hidden', view !== 'compose');
    }

    async function loadNotifList() {
      notifShowHeaders('inbox');
      var el = document.getElementById('notif-list');
      el.innerHTML = '<div class="flex items-center justify-center py-16"><svg class="animate-spin w-6 h-6 text-blue-600" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg></div>';
      try {
        var r = await fetch('/api/notifikasi?type=inbox', { credentials: 'include' });
        if (!r.ok) { el.innerHTML = '<div class="text-center py-16 text-red-400 text-sm">Gagal memuat notifikasi</div>'; return; }
        notifData = await r.json() || [];
        var unreadCount = notifData.filter(function(n) { return !n.is_read; }).length;
        var badge = document.getElementById('notif-count-mobile');
        if (badge) { if (unreadCount > 0) { badge.textContent = unreadCount > 99 ? '99+' : unreadCount; badge.classList.remove('hidden'); } else { badge.classList.add('hidden'); } }
        var countEl = document.getElementById('notif-modal-count');
        if (countEl) { if (unreadCount > 0) { countEl.textContent = unreadCount; countEl.classList.remove('hidden'); } else { countEl.classList.add('hidden'); } }

        if (!notifData.length) {
          el.innerHTML = '<div class="flex flex-col items-center justify-center py-16 px-6">'
            + '<div class="w-16 h-16 rounded-2xl bg-stone-100 flex items-center justify-center mb-4">'
            + '<svg class="w-8 h-8 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16-2h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293h-3.172a1 1 0 01-.707-.293l-2.414-2.414A1 1 0 006.586 13H4"/></svg></div>'
            + '<p class="text-stone-500 text-sm font-medium mb-1">Belum ada notifikasi</p>'
            + '<p class="text-stone-400 text-xs mb-5">Notifikasi dari admin akan muncul di sini</p>'
            + '<button onclick="showNotifForm()" class="text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 px-5 py-2.5 rounded-xl shadow-sm transition active:scale-95">+ Kirim Pesan ke Admin</button></div>';
          return;
        }

        el.innerHTML = '<div class="divide-y divide-stone-100">'
          + notifData.map(function(n, i) {
              var isUnread = !n.is_read;
              var name = n.nama_pengirim || 'Sistem';
              var initials = notifInitials(name);
              var color = notifAvatarColor(name);
              var preview = n.pesan ? (n.pesan.length > 100 ? n.pesan.substring(0, 100) + '...' : n.pesan) : '(tanpa pesan)';
              var time = notifTimeAgo(n.created_at);
              return '<div onclick="showNotifDetail(' + n.id + ')" class="flex items-start gap-3 px-4 sm:px-5 py-3.5 cursor-pointer transition-all duration-150 hover:bg-blue-50/50 ' + (isUnread ? 'bg-blue-50/30' : '') + '">'
                + '<div class="w-9 h-9 rounded-full shrink-0 flex items-center justify-center text-xs font-bold text-white shadow-sm ' + color + ' ' + (isUnread ? 'ring-2 ring-blue-300' : '') + '">' + initials + '</div>'
                + '<div class="flex-1 min-w-0 pt-0.5">'
                + '<div class="flex items-center justify-between gap-2">'
                + '<span class="text-sm font-semibold truncate ' + (isUnread ? 'text-stone-900' : 'text-stone-600') + '">' + escapeHtml(name) + '</span>'
                + '<span class="text-[11px] whitespace-nowrap shrink-0 ' + (isUnread ? 'text-blue-600 font-medium' : 'text-stone-400') + '">' + time + '</span>'
                + '</div>'
                + '<div class="text-sm font-medium truncate mt-0.5 ' + (isUnread ? 'text-stone-800' : 'text-stone-600') + '">' + escapeHtml(n.judul) + '</div>'
                + '<div class="text-[13px] truncate text-stone-400 mt-0.5">' + escapeHtml(preview) + '</div>'
                + '</div>'
                + (isUnread ? '<div class="w-2 h-2 rounded-full bg-blue-500 mt-2.5 shrink-0"></div>' : '')
                + '</div>';
            }).join('')
          + '</div>'
          + '<div class="sticky bottom-0 px-4 sm:px-5 py-2.5 text-center text-xs text-stone-400 bg-white/80 backdrop-blur-sm border-t border-stone-100">'
          + notifData.length + ' notifikasi</div>';
      } catch(e) {
        el.innerHTML = '<div class="text-center py-16 text-red-400 text-sm">Gagal memuat notifikasi</div>';
      }
    }

    function showNotifDetail(id) {
      var n = notifData.find(function(item) { return item.id === id; });
      if (!n) return;
      notifShowHeaders('detail');
      document.getElementById('notif-detail-title').textContent = n.judul || '(tanpa judul)';

      // Mark as read if unread
      if (!n.is_read) {
        n.is_read = 1;
        fetch('/api/notifikasi/' + id + '/baca', { method: 'PUT', credentials: 'include' }).catch(function(){});
        loadNotifCount();
      }

      var name = n.nama_pengirim || 'Sistem';
      var initials = notifInitials(name);
      var color = notifAvatarColor(name);
      var date = new Date(n.created_at).toLocaleDateString('id-ID', { weekday:'long', year:'numeric', month:'long', day:'numeric', hour:'2-digit', minute:'2-digit' });

      var el = document.getElementById('notif-list');
      el.innerHTML = '<div class="p-4 sm:p-5">'
        + '<div class="flex items-center gap-3.5 mb-4 p-3.5 bg-stone-50 rounded-xl border border-stone-100">'
        + '<div class="w-10 h-10 rounded-full flex items-center justify-center text-sm font-bold text-white shadow-sm shrink-0 ' + color + '">' + initials + '</div>'
        + '<div class="min-w-0 flex-1">'
        + '<div class="text-sm font-semibold text-stone-800">' + escapeHtml(name) + '</div>'
        + '<div class="text-xs text-stone-400 mt-0.5">Diterima · ' + date + '</div>'
        + '</div></div>'
        + (n.pesan ? '<div class="text-sm leading-7 text-stone-700 whitespace-pre-wrap bg-white p-4 rounded-xl border border-stone-100 shadow-sm">' + escapeHtml(n.pesan) + '</div>'
          : '<div class="text-sm italic text-stone-400 px-2 py-4">(Tidak ada isi pesan)</div>')
        + '<div class="flex items-center gap-2 mt-5 pt-4 border-t border-stone-100">'
        + '<button onclick="showNotifForm(' + (n.pengirim_id || 'null') + ')" class="flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 active:bg-blue-800 rounded-xl transition-all shadow-sm">'
        + '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="21 15 15 21 9 15"/><path d="M21 4v11h-6"/></svg> Balas</button>'
        + '<button onclick="notifHapus(' + n.id + ')" class="flex items-center gap-1.5 px-4 py-2 text-sm font-medium text-red-600 hover:bg-red-50 active:bg-red-100 rounded-xl transition-all">'
        + '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6l-1 14a2 2 0 0 1-2 2H8a2 2 0 0 1-2-2L5 6"/><path d="M10 11v6"/><path d="M14 11v6"/><path d="M9 6V4a1 1 0 0 1 1-1h4a1 1 0 0 1 1 1v2"/></svg> Hapus</button>'
        + '<button onclick="loadNotifList()" class="px-4 py-2 text-sm font-medium text-stone-600 hover:bg-stone-100 rounded-xl transition-all">Kembali</button>'
        + '</div></div>';
    }

    async function showNotifForm(replyToPengirimId) {
      notifShowHeaders('compose');
      var titleEl = document.getElementById('notif-compose-title');
      titleEl.textContent = replyToPengirimId ? 'Balas Pesan' : 'Pesan Baru';

      var penerimaHtml = '';
      if (!replyToPengirimId) {
        try {
          var r = await fetch('/api/notifikasi/daftar-admin', { credentials: 'include' });
          if (r.ok) {
            var admins = await r.json();
            if (admins && admins.length) {
              penerimaHtml = '<div class="mb-4">'
                + '<label class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1.5 block">Tujuan</label>'
                + '<select id="notif-form-penerima" class="w-full h-11 px-4 rounded-xl border border-stone-200 text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 transition-all bg-white">'
                + '<option value="">— Pilih penerima —</option>'
                + admins.map(function(a) { return '<option value="' + a.id + '">' + escapeHtml(a.nama) + ' (' + escapeHtml(a.role.toUpperCase()) + ')</option>'; }).join('')
                + '<option value="semua">Kirim ke semua admin/keuangan</option>'
                + '</select></div>';
            }
          }
        } catch(e) {}
      }

      var el = document.getElementById('notif-list');
      el.innerHTML = '<div class="p-5 space-y-4">'
        + penerimaHtml
        + '<div>'
        + '<label class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1.5 block">Subjek</label>'
        + '<input id="notif-form-judul" type="text" placeholder="Judul pesan..." class="w-full h-11 px-4 rounded-xl border border-stone-200 text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 transition-all bg-white">'
        + '</div>'
        + '<div>'
        + '<label class="text-xs font-semibold text-stone-500 uppercase tracking-wider mb-1.5 block">Pesan</label>'
        + '<textarea id="notif-form-pesan" rows="5" placeholder="Tulis pesan Anda..." class="w-full px-4 py-3 rounded-xl border border-stone-200 text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 transition-all resize-none bg-white"></textarea>'
        + '</div>'
        + '<input id="notif-form-reply-to" type="hidden" value="' + (replyToPengirimId || '') + '">'
        + '<button onclick="kirimPesanDariKaryawan()" class="w-full h-12 bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white rounded-xl text-sm font-semibold shadow-md flex items-center justify-center gap-2 transition-all active:scale-[0.98]">'
        + '<svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg> Kirim Pesan</button>'
        + '</div>';
    }

    async function kirimPesanDariKaryawan() {
      var judul = document.getElementById('notif-form-judul').value.trim();
      var pesan = document.getElementById('notif-form-pesan').value.trim();
      var replyTo = document.getElementById('notif-form-reply-to').value;
      var penerimaSel = document.getElementById('notif-form-penerima');
      var penerima = penerimaSel ? penerimaSel.value : '';
      if (!judul) { showToast('Judul wajib diisi', 'error'); return; }
      if (!replyTo && !penerima) { showToast('Pilih penerima', 'error'); return; }
      var btn = document.querySelector('#notif-list button:last-child');
      if (!btn) return;
      btn.disabled = true;
      btn.innerHTML = '<svg class="animate-spin w-4 h-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"/></svg> Mengirim...';
      try {
        var body = { judul: judul, pesan: pesan };
        if (replyTo) body.reply_to = replyTo;
        else if (penerima === 'semua') body.kirim_ke_semua = true;
        else body.penerima_id = penerima;
        var r = await fetch('/api/notifikasi/kirim-dari-karyawan', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(body), credentials: 'include' });
        var d = await r.json();
        if (d.error) { showToast(d.error, 'error'); btn.disabled = false; btn.innerHTML = 'Kirim'; return; }
        showToast('Pesan terkirim', 'success');
        loadNotifList();
      } catch(e) {
        showToast('Gagal mengirim', 'error');
        btn.disabled = false;
        btn.innerHTML = 'Kirim';
      }
    }

    async function notifHapus(id) {
      if (!confirm('Hapus notifikasi ini?')) return;
      try {
        var r = await fetch('/api/notifikasi/' + id, { method: 'DELETE', credentials: 'include' });
        var d = await r.json();
        if (d.error) { showToast(d.error, 'error'); return; }
        showToast('Pesan dihapus', 'success');
        loadNotifList();
      } catch(e) {
        showToast('Gagal menghapus', 'error');
      }
    }

    function notifRefresh() {
      loadNotifList();
      showToast('Pesan disegarkan', 'success');
    }

    function closeNotifModal() {
      document.getElementById('notif-modal').classList.add('hidden');
    }

    loadAll();


  </script>
</body>
</html>
