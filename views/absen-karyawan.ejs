    function stopCamera() {
      if (_cameraStream) {
        _cameraStream.getTracks().forEach(t => t.stop());
        _cameraStream = null;
      }
    }

    async function startCamera() {
      const video = document.getElementById('modal-camera-video');
      const start = document.getElementById('modal-camera-start');
      const loading = document.getElementById('modal-camera-loading');
      const active = document.getElementById('modal-camera-active');
      const retake = document.getElementById('modal-camera-retake');
      const preview = document.getElementById('modal-photo-preview');
      const camOff = document.getElementById('modal-photo-camera-off');
      start.classList.add('hidden');
      loading.classList.remove('hidden');
      loading.classList.add('flex');
      if (camOff) camOff.classList.add('hidden');
      try {
        const constraints = { video: { facingMode: 'environment', width: { ideal: 1280 }, height: { ideal: 720 } } };
        _cameraStream = await navigator.mediaDevices.getUserMedia(constraints);
        video.srcObject = _cameraStream;
        await video.play();
        loading.classList.add('hidden');
        video.classList.remove('hidden');
        active.classList.remove('hidden');
        active.classList.add('flex');
        document.getElementById('modal-camera-area').classList.remove('border-dashed','border-stone-300','bg-stone-50');
        document.getElementById('modal-camera-area').classList.add('border-solid','border-stone-400','bg-black');
      } catch (e) {
        loading.classList.add('hidden');
        start.classList.remove('hidden');
        if (camOff) camOff.classList.remove('hidden');
        showToast('Tidak bisa mengakses kamera: ' + (e.message || 'Izin ditolak'), 'error');
      }
    }

    function tambahWatermark(canvas) {
      const ctx = canvas.getContext('2d');
      const w = canvas.width, h = canvas.height;
      const now = new Date();
      const jam = now.toLocaleTimeString('id-ID', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: false });
      const tgl = now.toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' });
      const label = _absenTipe === 'in' ? 'CLOCK IN' : 'CLOCK OUT';
      const nama = (karyawanData && karyawanData.nama) || '-';
      const dapur = _tenantNama || '-';

      const barH = Math.round(h * 0.09);
      const fs = Math.max(10, Math.round(w * 0.028));
      const fs2 = Math.max(9, Math.round(w * 0.022));

      ctx.save();
      ctx.fillStyle = 'rgba(0,0,0,0.55)';
      ctx.fillRect(0, h - barH, w, barH);

      ctx.fillStyle = '#fff';
      ctx.textBaseline = 'middle';

      ctx.font = 'bold ' + fs + 'px sans-serif';
      ctx.textAlign = 'left';
      ctx.fillText(nama + ' - ' + dapur, Math.round(w * 0.025), h - barH / 2 - fs * 0.2);

      ctx.font = fs2 + 'px sans-serif';
      ctx.fillStyle = 'rgba(255,255,255,0.8)';
      ctx.fillText(tgl + ' ' + jam, Math.round(w * 0.025), h - barH / 2 + fs * 0.5);

      ctx.font = 'bold ' + fs + 'px sans-serif';
      ctx.textAlign = 'right';
      ctx.fillStyle = '#fbbf24';
      ctx.fillText(label, w - Math.round(w * 0.025), h - barH / 2);

      ctx.restore();
    }

    async function capturePhoto() {
      const video = document.getElementById('modal-camera-video');
      const canvas = document.getElementById('modal-camera-canvas');
      const preview = document.getElementById('modal-photo-preview');
      const img = document.getElementById('modal-photo-img');
      const active = document.getElementById('modal-camera-active');
      const retake = document.getElementById('modal-camera-retake');
      const btnYa = document.getElementById('modal-ya');
      const compressing = document.getElementById('modal-photo-compressing');
      const photoOk = document.getElementById('modal-photo-ok');
      const photoOkText = document.getElementById('modal-photo-ok-text');
      const photoError = document.getElementById('modal-photo-error');

      canvas.width = video.videoWidth;
      canvas.height = video.videoHeight;
      canvas.getContext('2d').drawImage(video, 0, 0);

      if (compressing) { compressing.classList.remove('hidden'); }
      if (photoOk) photoOk.classList.add('hidden');
      if (photoError) photoError.classList.add('hidden');

      _photoBase64 = await prosesFotoDariCanvas(canvas);

      if (compressing) compressing.classList.add('hidden');

      const sizeKB = Math.round(_photoBase64.length * 0.75 / 1024);
      if (photoOkText) photoOkText.textContent = 'Foto siap (' + sizeKB + ' KB)';
      if (photoOk) photoOk.classList.remove('hidden');

      video.classList.add('hidden');
      active.classList.add('hidden');
      img.src = _photoBase64;
      preview.classList.remove('hidden');
      retake.classList.remove('hidden');
      retake.classList.add('flex');

      document.getElementById('modal-camera-area').classList.remove('bg-black');
      btnYa.disabled = false;

      stopCamera();
    }

