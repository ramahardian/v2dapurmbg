      if (s.peringatan_terlambat && (!s.sudah_absensi||!s.sudah_masuk)) {
        ci.className='h-16 btn btn-primary'; ci.innerHTML='<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg><span>Clock In (Terlambat)</span>'; ci.disabled=false; ci.onclick=()=>confirmAbsen('in');
        co.className='h-16 btn btn-outline text-slate-400'; co.innerHTML='<svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg><span>Clock Out</span>'; co.disabled=true; co.onclick=null;
