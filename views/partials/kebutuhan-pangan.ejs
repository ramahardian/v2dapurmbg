<div id="kp-container">
  <!-- Hero -->
  <div class="bg-gradient-to-br from-emerald-700 to-emerald-500 rounded-2xl p-6 lg:p-8 mb-6 text-white shadow-lg">
    <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
      <div>
        <div class="flex items-center gap-2 mb-2">
          <div class="w-10 h-10 rounded-xl bg-white/15 flex items-center justify-center shadow-sm">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="18" y1="20" x2="18" y2="10"/><line x1="12" y1="20" x2="12" y2="4"/><line x1="6" y1="20" x2="6" y2="14"/></svg>
          </div>
          <h2 class="text-xl lg:text-2xl font-bold tracking-tight">Perhitungan Kebutuhan Pangan</h2>
        </div>
        <p class="text-white/80 text-sm max-w-xl">Hitung kebutuhan bahan pangan per Program Makan (siklus) berdasarkan standar SP dan BDD.</p>
      </div>
    </div>
  </div>

  <!-- Step 1: Pilih Siklus -->
  <div id="kp-step-siklus" class="bg-white border border-stone-200 rounded-xl p-5 mb-4">
    <div class="font-bold text-sm mb-3 flex items-center gap-2">
      <span class="w-6 h-6 rounded-full bg-emerald-600 text-white text-xs flex items-center justify-center shrink-0">1</span>
      Pilih Program Makan (Siklus)
    </div>
    <div class="flex flex-wrap gap-2 mb-3">
      <select id="kp-siklus-select" class="flex-1 min-w-[200px] h-11 px-3 border border-stone-200 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-400">
        <option value="">— Pilih Siklus —</option>
      </select>
      <input type="number" id="kp-jumlah-siswa" placeholder="Jumlah Siswa" min="0" class="w-40 h-11 px-3 border border-stone-200 rounded-xl text-sm focus:ring-2 focus:ring-emerald-500/20 focus:border-emerald-400" />
      <button onclick="hitungKebutuhanPangan()" class="h-11 px-5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-sm font-medium transition-colors shadow-sm flex items-center gap-2">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="22 12 18 12 15 21 9 3 6 12 2 12"/></svg>
        Hitung
      </button>
    </div>
    <div id="kp-info-siklus" class="text-xs text-stone-400 hidden"></div>
  </div>

  <!-- Step 2: Hasil -->
  <div id="kp-hasil" class="hidden space-y-4">
    <!-- Ringkasan -->
    <div id="kp-ringkasan" class="grid grid-cols-2 sm:grid-cols-4 gap-3"></div>

    <!-- Tombol Export -->
    <div class="flex justify-end gap-2">
      <button onclick="exportKebutuhanPanganXlsx()" class="border border-emerald-300 text-emerald-700 hover:bg-emerald-50 px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium flex items-center gap-1.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        Export XLSX
      </button>
      <button onclick="window.print()" class="border border-stone-300 text-stone-700 hover:bg-stone-50 px-3 py-1.5 rounded-lg text-xs sm:text-sm font-medium flex items-center gap-1.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="6 9 6 2 18 2 18 9"/><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"/><rect x="6" y="14" width="12" height="8"/></svg>
        Print
      </button>
    </div>

    <!-- Tabel per Hari -->
    <div id="kp-tables"></div>
  </div>
</div>