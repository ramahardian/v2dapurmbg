<div class="grid grid-cols-1 md:grid-cols-4 gap-3 mb-5">
  <div class="bg-white rounded-2xl border border-stone-200 shadow-sm px-3 py-2.5 md:col-span-2 flex items-center">
    <div class="relative w-full">
      <input type="text" id="gudang-search" placeholder="Cari bahan..." autocomplete="off"
        class="w-full h-10 pl-10 pr-4 rounded-xl border border-stone-200 bg-stone-50/60 text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 transition-all">
      <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
    </div>
  </div>
  <div class="bg-white rounded-2xl border border-stone-200 shadow-sm px-3 py-2.5 md:col-span-2 flex items-center">
    <div class="flex items-center gap-2 w-full">
      <button onclick="openStokForm('masuk')" class="flex-1 min-w-0 h-10 px-2 border border-emerald-300 text-emerald-700 hover:bg-emerald-50 rounded-xl text-[13px] font-medium shadow-sm transition-all flex items-center justify-center gap-1.5 whitespace-nowrap">
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="19 12 12 19 5 12"/></svg>
        <span>Barang Masuk</span>
      </button>
      <button onclick="openStokForm('keluar')" class="flex-1 min-w-0 h-10 px-2 border border-orange-300 text-orange-700 hover:bg-orange-50 rounded-xl text-[13px] font-medium shadow-sm transition-all flex items-center justify-center gap-1.5 whitespace-nowrap">
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><polyline points="5 12 12 5 19 12"/></svg>
        <span>Barang Keluar</span>
      </button>
    </div>
  </div>
</div>

<!-- Tabs -->
<div class="flex gap-1 bg-stone-100 rounded-xl p-1 mb-5 w-fit">
  <button onclick="showGudang('stok')" id="tab-stok" class="px-4 py-2 rounded-lg text-sm font-medium transition-all bg-white text-blue-600 shadow-sm">Stok Saat Ini</button>
  <button onclick="showGudang('masuk')" id="tab-masuk" class="px-4 py-2 rounded-lg text-sm font-medium transition-all text-stone-600 hover:text-stone-800">Riwayat Masuk</button>
  <button onclick="showGudang('keluar')" id="tab-keluar" class="px-4 py-2 rounded-lg text-sm font-medium transition-all text-stone-600 hover:text-stone-800">Riwayat Keluar</button>
</div>

<div id="gudang-content" class="mb-3"></div>
<div id="gudang-pagination" class="flex items-center justify-between"></div>
