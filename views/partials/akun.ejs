<div class="max-w-3xl mx-auto space-y-6">
  <div class="dash-card-item bg-white border border-slate-200 rounded-lg shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-200 flex items-center gap-2.5">
      <span class="flex h-8 w-8 items-center justify-center rounded-md border border-slate-200 bg-slate-50 text-[#14326b]">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      </span>
      <h3 class="font-semibold text-slate-900">Profil Saya</h3>
    </div>
    <div class="p-6 space-y-4">
      <!-- Foto -->
      <div class="flex items-center gap-5">
        <div id="akun-foto-preview" class="w-16 h-16 rounded-full overflow-hidden bg-slate-100 flex items-center justify-center text-lg font-bold text-slate-500 shrink-0 ring-2 ring-slate-200" style="background-size:cover;background-position:center">
          <% if (user.foto) { %>
            <img src="<%= user.foto %>" class="w-full h-full object-cover" id="akun-foto-img">
          <% } else { %>
            <span id="akun-foto-initial"><%= user.nama ? user.nama.charAt(0).toUpperCase() : '?' %></span>
          <% } %>
        </div>
        <div class="flex flex-col gap-1.5">
          <label class="cursor-pointer inline-flex items-center gap-1.5 text-sm font-medium text-[#14326b] hover:text-[#0f2a5f] transition-colors">
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            Unggah Foto
            <input type="file" id="akun-foto-input" accept="image/png,image/jpeg,image/jpg,image/webp" class="hidden">
          </label>
          <button id="akun-foto-hapus" class="text-xs text-red-600 hover:text-red-700 text-left <%= user.foto ? '' : 'hidden' %> transition-colors">Hapus foto</button>
          <span class="text-[10px] text-slate-400">Format: JPG, PNG, WEBP. Maks 2MB</span>
        </div>
      </div>
      <div>
        <label class="text-sm font-medium text-slate-700">Nama Lengkap</label>
        <input id="akun-nama" value="<%= user.nama %>" class="mt-1 w-full h-11 px-4 border border-slate-200 rounded-lg focus:ring-2 focus:ring-[#14326b]/20 focus:border-[#14326b] text-sm" />
      </div>
      <div>
        <label class="text-sm font-medium text-slate-700">Email</label>
        <input id="akun-email" type="email" value="<%= user.email %>" class="mt-1 w-full h-11 px-4 border border-slate-200 rounded-lg focus:ring-2 focus:ring-[#14326b]/20 focus:border-[#14326b] text-sm" />
      </div>
      <div>
        <label class="text-sm font-medium text-slate-700">Role</label>
        <input value="<%= user.role.replace('_', ' ') %>" disabled class="mt-1 w-full h-11 px-4 border border-slate-200 rounded-lg bg-slate-50 text-slate-500 text-sm capitalize" />
      </div>
      <div class="pt-2 flex justify-end">
        <button id="btn-simpan-profil" class="h-10 px-5 text-sm font-semibold bg-[#14326b] hover:bg-[#0f2a5f] text-white rounded-lg shadow-sm transition-colors">Simpan Profil</button>
      </div>
    </div>
  </div>

  <div class="dash-card-item bg-white border border-slate-200 rounded-lg shadow-sm overflow-hidden">
    <div class="px-6 py-4 border-b border-slate-200 flex items-center gap-2.5">
      <span class="flex h-8 w-8 items-center justify-center rounded-md border border-slate-200 bg-slate-50 text-[#0f766e]">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
      </span>
      <h3 class="font-semibold text-slate-900">Ganti Kata Sandi</h3>
    </div>
    <div class="p-6 space-y-4">
      <div>
        <label class="text-sm font-medium text-slate-700">Password Lama</label>
        <input id="akun-pass-lama" type="password" placeholder="Masukkan password saat ini" class="mt-1 w-full h-11 px-4 border border-slate-200 rounded-lg focus:ring-2 focus:ring-[#14326b]/20 focus:border-[#14326b] text-sm" />
      </div>
      <div>
        <label class="text-sm font-medium text-slate-700">Password Baru</label>
        <input id="akun-pass-baru" type="password" placeholder="Minimal 6 karakter" class="mt-1 w-full h-11 px-4 border border-slate-200 rounded-lg focus:ring-2 focus:ring-[#14326b]/20 focus:border-[#14326b] text-sm" />
      </div>
      <div class="pt-2 flex justify-end">
        <button id="btn-ganti-password" class="h-10 px-5 text-sm font-semibold bg-[#14326b] hover:bg-[#0f2a5f] text-white rounded-lg shadow-sm transition-colors">Ganti Password</button>
      </div>
    </div>
  </div>
</div>