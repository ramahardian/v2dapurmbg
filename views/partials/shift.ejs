<div class="flex flex-wrap items-center gap-3 mb-5">
  <button id="add-shift-btn" class="h-11 px-5 bg-[#1e40af] hover:bg-[#1d4ed8] text-white rounded-xl text-sm font-semibold shadow-sm transition-all flex items-center gap-2">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    Shift Baru
  </button>
  <button id="add-jadwal-btn" class="h-11 px-4 border border-stone-200 text-stone-700 hover:bg-stone-50 rounded-xl text-sm font-medium shadow-sm transition-all flex items-center gap-2">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
    Atur Jadwal
  </button>
</div>

<!-- Tabel Master Shift -->
<div class="bg-white rounded-2xl border border-stone-200 shadow-sm overflow-hidden mb-6">
  <div class="px-5 py-4 border-b border-stone-100 flex items-center gap-2">
    <svg class="w-5 h-5 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    <h3 class="text-sm font-bold text-stone-800">Master Shift</h3>
  </div>
  <div class="overflow-x-auto">
    <table class="w-full">
      <thead><tr class="border-b border-stone-100">
        <th class="text-left px-4 py-3.5 text-[10px] font-bold uppercase tracking-wider text-stone-500">Nama Shift</th>
        <th class="text-center px-4 py-3.5 text-[10px] font-bold uppercase tracking-wider text-stone-500">Jam Masuk</th>
        <th class="text-center px-4 py-3.5 text-[10px] font-bold uppercase tracking-wider text-stone-500">Jam Keluar</th>
        <th class="text-center px-4 py-3.5 text-[10px] font-bold uppercase tracking-wider text-stone-500">Status</th>
        <th class="text-right px-4 py-3.5 text-[10px] font-bold uppercase tracking-wider text-stone-500">Aksi</th>
      </tr></thead>
      <tbody id="shift-table-body">
        <% if (shifts.length) { %>
          <% shifts.forEach(s => { %>
            <tr class="border-b border-stone-50 hover:bg-stone-50/50 transition-colors">
              <td class="px-4 py-3 text-xs font-medium"><span class="inline-block px-2.5 py-0.5 rounded-lg text-xs font-semibold" style="background:<%= s.warna %>20;color:<%= s.warna %>"><%= s.nama %></span></td>
              <td class="px-4 py-3 text-xs text-center mono text-stone-700"><%= s.jam_masuk.slice(0,5) %></td>
              <td class="px-4 py-3 text-xs text-center mono text-stone-700"><%= s.jam_keluar.slice(0,5) %><% if (s.jam_keluar <= s.jam_masuk) { %><span class="ml-1.5 text-[10px] font-semibold text-amber-600 bg-amber-50 px-1.5 py-0.5 rounded-lg cursor-default" title="Lintas hari (berakhir besok)">+1</span><% } %></td>
              <td class="px-4 py-3 text-xs text-center"><span class="inline-block px-2.5 py-0.5 text-[10px] font-semibold rounded-lg <%= s.is_active ? 'bg-emerald-100 text-emerald-700' : 'bg-stone-100 text-stone-500' %>"><%= s.is_active ? 'Aktif' : 'Nonaktif' %></span></td>
              <td class="px-4 py-3 text-xs text-right whitespace-nowrap">
                <button onclick="editShift(<%= s.id %>)" class="w-7 h-7 inline-flex items-center justify-center rounded-lg text-stone-400 hover:text-blue-600 hover:bg-blue-50 transition-all" title="Edit"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg></button>
                <button onclick="deleteShift(<%= s.id %>)" class="w-7 h-7 inline-flex items-center justify-center rounded-lg text-stone-400 hover:text-red-600 hover:bg-red-50 transition-all" title="Hapus"><svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg></button>
              </td>
            </tr>
          <% }) %>
        <% } else { %>
          <tr><td colspan="5" class="text-center py-16 text-stone-400"><svg class="w-12 h-12 mx-auto mb-3 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg><div class="text-sm">Belum ada shift</div><div class="text-xs text-stone-400 mt-1">Klik "+ Shift Baru" untuk mulai.</div></td></tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<!-- Tabel Jadwal Karyawan -->
<div class="bg-white rounded-2xl border border-stone-200 shadow-sm overflow-hidden">
  <div class="px-5 py-4 border-b border-stone-100 flex items-center gap-2">
    <svg class="w-5 h-5 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
    <h3 class="text-sm font-bold text-stone-800">Jadwal Karyawan</h3>
  </div>
  <div id="jadwal-content">
    <div class="text-center py-16 text-stone-400"><svg class="w-12 h-12 mx-auto mb-3 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg><div class="text-sm">Memuat jadwal...</div></div>
  </div>
</div>
