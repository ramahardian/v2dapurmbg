<div class="grid grid-cols-1 xl:grid-cols-4 gap-3 mb-5">
  <div class="dash-card-item bg-white rounded-lg border border-slate-200 shadow-sm px-3 py-2.5 xl:col-span-4 flex items-center">
    <div class="flex items-center gap-2 w-full">
      <button id="btn-tambah-user" class="inline-flex items-center gap-1.5 h-9 px-4 bg-[#14326b] hover:bg-[#0f2a5f] text-white rounded-lg text-xs font-medium shadow-sm transition-colors whitespace-nowrap">
        <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Tambah User
      </button>
    </div>
  </div>
</div>
<div class="dash-panel bg-white border border-slate-200 rounded-lg shadow-sm overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full">
      <thead class="bg-slate-50">
        <tr class="border-b border-slate-200">
          <th class="text-left px-4 py-3 text-[10px] font-bold uppercase tracking-wider text-slate-500">Nama</th>
          <th class="text-left px-4 py-3 text-[10px] font-bold uppercase tracking-wider text-slate-500">Email</th>
          <th class="text-left px-4 py-3 text-[10px] font-bold uppercase tracking-wider text-slate-500">Role</th>
          <th class="text-left px-4 py-3 text-[10px] font-bold uppercase tracking-wider text-slate-500">Karyawan</th>
          <th class="text-left px-4 py-3 text-[10px] font-bold uppercase tracking-wider text-slate-500">Bergabung</th>
          <th class="text-right px-4 py-3 text-[10px] font-bold uppercase tracking-wider text-slate-500">Aksi</th>
        </tr>
      </thead>
      <tbody id="user-table-body">
        <tr><td colspan="6" class="text-center py-12 text-slate-400">Memuat data...</td></tr>
      </tbody>
    </table>
  </div>
</div>
<div id="user-modal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50 p-4">
  <div class="dash-panel bg-white rounded-lg border border-slate-200 shadow-xl w-full max-w-md overflow-hidden flex flex-col max-h-[90vh]">
    <div class="px-5 sm:px-6 py-4 border-b border-slate-200 flex items-center justify-between">
      <h3 id="user-modal-title" class="font-semibold text-slate-900">Tambah User</h3>
      <button onclick="closeUserModal()" class="w-7 h-7 rounded-lg hover:bg-slate-100 flex items-center justify-center text-slate-400 hover:text-slate-700 transition-colors" aria-label="Tutup">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="p-5 sm:p-6 space-y-4 overflow-y-auto flex-1">
      <input id="user-id" type="hidden" />
      <div>
        <label class="text-sm font-medium text-slate-700">Nama Lengkap <span class="text-red-500">*</span></label>
        <input id="user-nama" class="mt-1 w-full h-11 px-4 border border-slate-200 rounded-lg focus:ring-2 focus:ring-[#14326b]/20 focus:border-[#14326b] text-sm" placeholder="Nama user" />
      </div>
      <div>
        <label class="text-sm font-medium text-slate-700">Email <span class="text-red-500">*</span></label>
        <input id="user-email" type="email" class="mt-1 w-full h-11 px-4 border border-slate-200 rounded-lg focus:ring-2 focus:ring-[#14326b]/20 focus:border-[#14326b] text-sm" placeholder="user@example.com" />
      </div>
      <div>
        <label class="text-sm font-medium text-slate-700">Password <span class="text-red-500" id="pass-label">*</span></label>
        <input id="user-password" type="password" class="mt-1 w-full h-11 px-4 border border-slate-200 rounded-lg focus:ring-2 focus:ring-[#14326b]/20 focus:border-[#14326b] text-sm" placeholder="Minimal 6 karakter" />
      </div>
      <div>
        <label class="text-sm font-medium text-slate-700">Role</label>
        <select id="user-role-select" class="mt-1 w-full h-11 px-4 border border-slate-200 rounded-lg focus:ring-2 focus:ring-[#14326b]/20 focus:border-[#14326b] text-sm bg-white">
          <option value="" disabled selected>Pilih Role</option>
          <option value="produksi">Produksi</option>
          <option value="gudang">Gudang</option>
          <option value="keuangan">Keuangan</option>
          <option value="ahli_gizi">Ahli Gizi</option>
          <option value="admin">Admin</option>
        </select>
      </div>
      <div>
        <label class="text-sm font-medium text-slate-700">Karyawan (opsional)</label>
        <select id="user-karyawan" class="mt-1 w-full h-11 px-4 border border-slate-200 rounded-lg focus:ring-2 focus:ring-[#14326b]/20 focus:border-[#14326b] text-sm bg-white">
          <option value="">-- Tidak terhubung --</option>
        </select>
        <p class="text-xs text-slate-400 mt-1">Hubungkan ke data karyawan agar bisa absen via web/mobile</p>
      </div>
    </div>
    <div class="px-5 sm:px-6 py-3 border-t border-slate-200 flex justify-end gap-2">
      <button onclick="closeUserModal()" class="h-10 px-4 text-sm text-slate-600 bg-slate-100 hover:bg-slate-200 rounded-lg font-medium transition-colors">Batal</button>
      <button id="btn-simpan-user" class="h-10 px-4 text-sm bg-[#14326b] hover:bg-[#0f2a5f] text-white rounded-lg font-semibold shadow-sm transition-colors">Simpan</button>
    </div>
  </div>
</div>