    <button onclick="showLap('siklus')" id="lt-siklus" class="px-3 py-1.5 text-[11px] font-medium rounded-md border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 transition-colors">Siklus Menu</button>
    <% } %>
    <button onclick="showLap('pembelian')" id="lt-pembelian" class="px-3 py-1.5 text-[11px] font-medium rounded-md border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 transition-colors">Pembelian</button>
    <button onclick="showLap('rab-pembelian')" id="lt-rab-pembelian" class="px-3 py-1.5 text-[11px] font-medium rounded-md border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 transition-colors">RAB + Pembelian</button>
    <button onclick="showLap('penerimaan')" id="lt-penerimaan" class="px-3 py-1.5 text-[11px] font-medium rounded-md border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 transition-colors">Penerimaan</button>
