<div class="bg-white rounded-lg border border-slate-200 shadow-sm p-4 mb-5">
  <div class="flex flex-wrap gap-1.5">
    <button onclick="showLap('rab')" id="lt-rab" class="px-3 py-1.5 text-[11px] font-medium rounded-md border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 transition-colors">RAB</button>
    <button onclick="showLap('rab-harian')" id="lt-rab-harian" class="px-3 py-1.5 text-[11px] font-medium rounded-md border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 transition-colors">RAB Harian</button>
    <button onclick="exportRabHarianXlsx()" id="export-rab-harian-btn" style="display:none" class="self-center shrink-0 ml-1 inline-flex items-center gap-1.5 text-[11px] font-medium text-white bg-[#14326b] hover:bg-[#0f2a5f] px-3 py-1.5 rounded-lg shadow-sm transition-colors" title="Export RAB Harian minggu ini ke Excel">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg> EXPORT XLSX
    </button>
    <button onclick="showLap('rab-bulanan')" id="lt-rab-bulanan" class="px-3 py-1.5 text-[11px] font-medium rounded-md border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 transition-colors">RAB Bulanan</button>
    <button onclick="showLap('persediaan')" id="lt-persediaan" class="px-3 py-1.5 text-[11px] font-medium rounded-md border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 transition-colors">Persediaan</button>
    <button onclick="showLap('distribusi')" id="lt-distribusi" class="px-3 py-1.5 text-[11px] font-medium rounded-md border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 transition-colors">Distribusi</button>
    <button onclick="showLap('keuangan')" id="lt-keuangan" class="px-3 py-1.5 text-[11px] font-medium rounded-md border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 transition-colors">Keuangan</button>
    <button onclick="showLap('pengeluaran-bulanan')" id="lt-pengeluaran-bulanan" class="px-3 py-1.5 text-[11px] font-medium rounded-md border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 transition-colors">Catatan Pengeluaran Bulanan</button>
    <button onclick="showLap('penggunaan-anggaran')" id="lt-penggunaan-anggaran" class="px-3 py-1.5 text-[11px] font-medium rounded-md border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 transition-colors">Penggunaan Anggaran</button>
