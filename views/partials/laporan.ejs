    <button onclick="showLap('jurnal-umum')" id="lt-jurnal-umum" class="px-3 py-1.5 text-[11px] font-medium rounded-md border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 transition-colors">Jurnal Umum</button>
    <button onclick="showLap('buku-besar')" id="lt-buku-besar" class="px-3 py-1.5 text-[11px] font-medium rounded-md border border-slate-200 bg-slate-50 text-[#14326b] hover:bg-slate-100 transition-colors">Buku Besar</button>
    <button onclick="showLap('neraca')" id="lt-neraca" class="px-3 py-1.5 text-[11px] font-medium rounded-md border border-slate-200 bg-slate-50 text-slate-700 hover:bg-slate-100 transition-colors">Neraca</button>
  </div>
</div>
<div id="lap-content"></div>
