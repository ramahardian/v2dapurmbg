<!-- Hero + Stats + Filter dalam satu grid bento -->
<div class="grid grid-cols-1 sm:grid-cols-3 xl:grid-cols-6 gap-3 sm:gap-4 mb-6 auto-rows-min">
<div class="sm:col-span-3 xl:col-span-6 dash-card-item relative overflow-hidden rounded-lg border border-[#0f2a5f] text-white p-6 lg:p-8 shadow-sm"
     style="background-image: linear-gradient(115deg, rgba(9,26,58,.97) 0%, rgba(20,50,107,.94) 55%, rgba(15,42,95,.92) 100%), url('/bg.jpeg'); background-size: cover; background-position: center;">
  <div class="absolute inset-0 opacity-[0.07]" style="background-image: linear-gradient(rgba(255,255,255,.6) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.6) 1px, transparent 1px); background-size: 44px 44px;"></div>
  <div class="relative flex flex-col lg:flex-row lg:items-center lg:justify-between gap-5">
    <div class="min-w-0">
      <div class="flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-300">
        <span class="h-1.5 w-1.5 rounded-full bg-[#c6a664]"></span>
        Perencanaan Menu
      </div>
      <h2 class="mt-2 text-xl lg:text-2xl font-semibold tracking-tight text-white">Sirkulasi Menu</h2>
      <p class="mt-1 text-xs text-slate-300/90 max-w-xl">Rencanakan menu bergizi untuk setiap siklus — atur menu harian, pantau kandungan gizi, dan cetak laporan.</p>
    </div>
    <button onclick="openSiklusForm()" class="inline-flex items-center justify-center gap-1.5 h-9 px-4 rounded-lg bg-white text-[#14326b] hover:bg-white/90 text-xs font-semibold shadow-sm transition-colors shrink-0">
      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Siklus Baru
    </button>
  </div>
</div>

<!-- Quick Stats -->
<div id="siklus-stats" class="sm:col-span-3 xl:col-span-4 grid grid-cols-1 sm:grid-cols-3 gap-3 sm:gap-4 hidden">
  <div class="dash-card-item relative overflow-hidden bg-white rounded-lg border border-slate-200 p-4 sm:p-5 shadow-sm">
    <span class="absolute inset-x-0 top-0 h-[3px]" style="background:#14326b"></span>
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <div class="text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-500">Total Siklus</div>
        <div class="mono text-lg sm:text-2xl font-semibold text-slate-900 mt-2" id="stat-total">0</div>
        <div class="text-[10px] text-slate-500 mt-1">Total siklus menu</div>
      </div>
      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-slate-200 bg-slate-50 text-[#14326b]">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/></svg>
      </span>
    </div>
  </div>
  <div class="dash-card-item relative overflow-hidden bg-white rounded-lg border border-slate-200 p-4 sm:p-5 shadow-sm">
    <span class="absolute inset-x-0 top-0 h-[3px]" style="background:#0f766e"></span>
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <div class="text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-500">Aktif</div>
        <div class="mono text-lg sm:text-2xl font-semibold text-slate-900 mt-2" id="stat-aktif">0</div>
        <div class="text-[10px] text-slate-500 mt-1">Siklus aktif</div>
      </div>
      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-slate-200 bg-slate-50 text-[#0f766e]">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
      </span>
    </div>
  </div>
  <div class="dash-card-item relative overflow-hidden bg-white rounded-lg border border-slate-200 p-4 sm:p-5 shadow-sm">
    <span class="absolute inset-x-0 top-0 h-[3px]" style="background:#b45309"></span>
    <div class="flex items-start justify-between gap-3">
      <div class="min-w-0">
        <div class="text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-500">Draft</div>
        <div class="mono text-lg sm:text-2xl font-semibold text-slate-900 mt-2" id="stat-draft">0</div>
        <div class="text-[10px] text-slate-500 mt-1">Siklus draft</div>
      </div>
      <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-slate-200 bg-slate-50 text-amber-600">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
      </span>
    </div>
  </div>
</div>

<!-- Search & Filter Bar -->
<div class="sm:col-span-3 xl:col-span-2 dash-card-item bg-white rounded-lg border border-slate-200 shadow-sm px-4 py-3">
  <div class="flex flex-col gap-2">
    <div class="relative w-full">
      <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <input type="text" id="siklus-search" placeholder="Cari siklus..." autocomplete="off"
        class="h-9 pl-10 pr-4 rounded-lg border border-slate-200 text-sm w-full focus:outline-none focus:ring-2 focus:ring-[#14326b]/20 focus:border-[#14326b] bg-white transition" />
    </div>
    <div class="flex flex-wrap items-center gap-2">
      <select id="siklus-filter-status" class="h-9 flex-1 min-w-0 px-3 border border-slate-200 rounded-lg text-xs bg-white focus:outline-none focus:ring-2 focus:ring-[#14326b]/20 focus:border-[#14326b]" onchange="reloadSiklusList()">
        <option value="">Semua Status</option>
        <option value="Aktif">Aktif</option>
        <option value="Draft">Draft</option>
        <option value="Arsip">Arsip</option>
      </select>
      <span id="siklus-divider-selected" class="hidden w-px h-6 bg-slate-200"></span>
      <button id="siklus-delete-selected" onclick="deleteSelectedSiklus()" class="hidden h-9 px-3 text-xs font-medium text-red-600 bg-red-50 hover:bg-red-100 border border-red-200 rounded-lg transition-colors items-center gap-1.5 whitespace-nowrap">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
        Hapus <span id="siklus-selected-count" class="font-bold">0</span>
      </button>
    </div>
  </div>
</div></div>

<!-- Siklus Grid -->
<div id="siklus-list" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4"></div>

<!-- Siklus Detail Area -->
<div id="siklus-detail" class="mt-6"></div>
