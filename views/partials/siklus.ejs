<!-- Hero Banner -->
<div class="bg-gradient-to-br from-[#1e40af] to-[#3b82f6] rounded-2xl p-6 lg:p-8 mb-6 text-white shadow-lg dash-card-item" style="animation-delay:0ms">
  <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-4">
    <div>
      <div class="flex items-center gap-2 mb-2">
        <div class="w-10 h-10 rounded-xl bg-white/15 flex items-center justify-center shadow-sm">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
        </div>
        <h2 class="text-xl lg:text-2xl font-bold tracking-tight">Sirkulasi Menu</h2>
      </div>
      <p class="text-white/80 text-sm max-w-xl">Rencanakan menu bergizi untuk setiap siklus — atur menu harian, pantau kandungan gizi, dan cetak laporan.</p>
    </div>
    <button onclick="openSiklusForm()" class="inline-flex items-center gap-2 bg-white text-[#1e40af] px-5 py-2.5 rounded-xl font-bold text-xs hover:bg-white/90 transition-all shadow-sm shrink-0">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Siklus Baru
    </button>
  </div>
</div>

<!-- Quick Stats -->
<div id="siklus-stats" class="grid grid-cols-1 sm:grid-cols-3 gap-3 mb-6 hidden">
  <div class="bg-gradient-to-br from-blue-50 to-blue-100/60 rounded-2xl border border-blue-200/60 p-4 shadow-sm dash-card-item">
    <div class="flex items-center justify-between mb-1">
      <span class="text-[10px] font-semibold uppercase tracking-wider text-blue-700">Total Siklus</span>
      <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/></svg>
    </div>
    <div class="text-2xl font-bold text-blue-800 mt-1" id="stat-total">0</div>
    <div class="text-[10px] text-blue-600/70">Total siklus menu</div>
  </div>
  <div class="bg-gradient-to-br from-emerald-50 to-emerald-100/60 rounded-2xl border border-emerald-200/60 p-4 shadow-sm dash-card-item">
    <div class="flex items-center justify-between mb-1">
      <span class="text-[10px] font-semibold uppercase tracking-wider text-emerald-700">Aktif</span>
      <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
    </div>
    <div class="text-2xl font-bold text-emerald-800 mt-1" id="stat-aktif">0</div>
    <div class="text-[10px] text-emerald-600/70">Siklus aktif</div>
  </div>
  <div class="bg-gradient-to-br from-amber-50 to-amber-100/60 rounded-2xl border border-amber-200/60 p-4 shadow-sm dash-card-item">
    <div class="flex items-center justify-between mb-1">
      <span class="text-[10px] font-semibold uppercase tracking-wider text-amber-700">Draft</span>
      <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>
    </div>
    <div class="text-2xl font-bold text-amber-800 mt-1" id="stat-draft">0</div>
    <div class="text-[10px] text-amber-600/70">Siklus draft</div>
  </div>
</div>

<!-- Search & Filter Bar -->
<div class="bg-white rounded-2xl border border-stone-200 shadow-sm px-4 py-3 mb-4">
  <div class="flex flex-wrap items-center justify-between gap-3">
    <div class="relative flex-1 min-w-[200px] max-w-xs">
      <svg class="absolute left-3 top-2.5 w-4 h-4 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
      </svg>
      <input type="text" id="siklus-search" placeholder="Cari siklus..." autocomplete="off"
        class="pl-10 pr-4 py-2.5 border border-stone-200 rounded-xl text-sm w-full focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 bg-white transition" />
    </div>
    <div class="flex items-center gap-2">
      <button id="siklus-filter-all" onclick="var s=document.getElementById('siklus-filter-status');s.selectedIndex=0;reloadSiklusList()" class="px-3 py-2 text-xs font-medium text-stone-600 bg-stone-50 hover:bg-stone-100 rounded-lg transition-colors border border-stone-200">Semua Status</button>
      <select id="siklus-filter-status" class="px-3 py-2 border border-stone-200 rounded-lg text-xs bg-white focus:outline-none focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400" onchange="reloadSiklusList()">
        <option value="">Semua</option>
        <option value="Aktif">Aktif</option>
        <option value="Draft">Draft</option>
        <option value="Arsip">Arsip</option>
      </select>
      <div id="siklus-divider-selected" class="w-px h-6 bg-stone-200 mx-1 hidden"></div>
      <button id="siklus-delete-selected" onclick="deleteSelectedSiklus()" class="hidden px-3 py-2 text-xs font-medium text-red-600 bg-red-50 hover:bg-red-100 rounded-lg transition-colors items-center gap-1.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
        Hapus Terpilih <span id="siklus-selected-count" class="font-bold">0</span>
      </button>
    </div>
  </div>
</div>

<!-- Siklus Grid -->
<div id="siklus-list" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4"></div>

<!-- Siklus Detail Area -->
<div id="siklus-detail" class="mt-6"></div>
