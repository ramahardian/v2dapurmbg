<!-- Summary Cards -->
<div id="cuti-summary" class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-4">
  <div class="bg-gradient-to-br from-blue-50 to-blue-100/60 rounded-2xl border border-blue-200/60 p-4 shadow-sm dash-card-item">
    <div class="flex items-center justify-between mb-1">
      <span class="text-[10px] font-semibold uppercase tracking-wider text-blue-700">Total</span>
      <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    </div>
    <div id="cuti-stat-total" class="text-lg font-bold text-blue-800">—</div>
    <div class="text-[10px] text-blue-600/70">Total pengajuan</div>
  </div>
  <div class="bg-gradient-to-br from-amber-50 to-amber-100/60 rounded-2xl border border-amber-200/60 p-4 shadow-sm dash-card-item">
    <div class="flex items-center justify-between mb-1">
      <span class="text-[10px] font-semibold uppercase tracking-wider text-amber-700">Menunggu</span>
      <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
    </div>
    <div id="cuti-stat-menunggu" class="text-lg font-bold text-amber-800">—</div>
    <div class="text-[10px] text-amber-600/70">Menunggu persetujuan</div>
  </div>
  <div class="bg-gradient-to-br from-emerald-50 to-emerald-100/60 rounded-2xl border border-emerald-200/60 p-4 shadow-sm dash-card-item">
    <div class="flex items-center justify-between mb-1">
      <span class="text-[10px] font-semibold uppercase tracking-wider text-emerald-700">Disetujui</span>
      <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    </div>
    <div id="cuti-stat-disetujui" class="text-lg font-bold text-emerald-800">—</div>
    <div class="text-[10px] text-emerald-600/70">Pengajuan disetujui</div>
  </div>
  <div class="bg-gradient-to-br from-red-50 to-red-100/60 rounded-2xl border border-red-200/60 p-4 shadow-sm dash-card-item">
    <div class="flex items-center justify-between mb-1">
      <span class="text-[10px] font-semibold uppercase tracking-wider text-red-700">Ditolak</span>
      <svg class="w-4 h-4 text-red-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
    </div>
    <div id="cuti-stat-ditolak" class="text-lg font-bold text-red-800">—</div>
    <div class="text-[10px] text-red-600/70">Pengajuan ditolak</div>
  </div>
</div>

<!-- Filters & Actions -->
<div class="bg-white rounded-2xl border border-stone-200 shadow-sm px-4 py-3 mb-4">
  <div class="flex flex-wrap items-center gap-x-4 gap-y-2">
    <div class="flex items-center gap-2">
      <svg class="w-4 h-4 text-stone-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/></svg>
      <select id="cuti-filter-karyawan" class="text-xs border border-stone-200 rounded-lg px-3 py-2 bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400">
        <option value="">Semua Karyawan</option>
      </select>
      <input id="cuti-filter-tanggal-awal" type="date" class="text-xs border border-stone-200 rounded-lg px-3 py-2 bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400" />
      <span class="text-xs text-stone-400">s.d.</span>
      <input id="cuti-filter-tanggal-akhir" type="date" class="text-xs border border-stone-200 rounded-lg px-3 py-2 bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400" />
      <select id="cuti-filter-jenis" class="text-xs border border-stone-200 rounded-lg px-3 py-2 bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400">
        <option value="">Semua Jenis</option>
        <option value="Izin">Izin</option>
        <option value="Cuti">Cuti</option>
      </select>
      <select id="cuti-filter-status" class="text-xs border border-stone-200 rounded-lg px-3 py-2 bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400">
        <option value="">Semua Status</option>
        <option value="Menunggu">Menunggu</option>
        <option value="Disetujui">Disetujui</option>
        <option value="Ditolak">Ditolak</option>
      </select>
    </div>
    <div class="flex gap-1.5">
      <button onclick="loadIjinCuti()" class="bg-blue-600 hover:bg-blue-700 text-white px-3 py-1.5 rounded-lg text-xs font-medium transition-colors shadow-sm flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Filter
      </button>
      <button onclick="openIjinCutiForm()" class="border border-stone-300 text-stone-700 hover:bg-stone-50 px-3 py-1.5 rounded-lg text-xs font-medium transition-colors flex items-center gap-1.5">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>+ Tambah
      </button>
    </div>
  </div>
</div>

<!-- Table -->
<div class="bg-white rounded-2xl border border-stone-200 shadow-sm overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-[11px]">
      <thead class="bg-stone-50">
        <tr>
          <th class="text-left px-3 py-2.5 font-bold text-stone-500 text-[10px] uppercase tracking-wider border-r border-stone-200">Karyawan</th>
          <th class="text-left px-3 py-2.5 font-bold text-stone-500 text-[10px] uppercase tracking-wider border-r border-stone-200">NIK</th>
          <th class="text-center px-3 py-2.5 font-bold text-stone-500 text-[10px] uppercase tracking-wider border-r border-stone-200">Jenis</th>
          <th class="text-left px-3 py-2.5 font-bold text-stone-500 text-[10px] uppercase tracking-wider border-r border-stone-200">Tanggal</th>
          <th class="text-left px-3 py-2.5 font-bold text-stone-500 text-[10px] uppercase tracking-wider border-r border-stone-200">Durasi</th>
          <th class="text-center px-3 py-2.5 font-bold text-stone-500 text-[10px] uppercase tracking-wider border-r border-stone-200">Status</th>
          <th class="text-left px-3 py-2.5 font-bold text-stone-500 text-[10px] uppercase tracking-wider border-r border-stone-200">Alasan</th>
          <th class="text-right px-3 py-2.5 font-bold text-stone-500 text-[10px] uppercase tracking-wider">Aksi</th>
        </tr>
      </thead>
      <tbody id="cuti-table-body">
        <tr><td colspan="8" class="text-center py-12 text-stone-400">Memuat data ijin/cuti...</td></tr>
      </tbody>
    </table>
  </div>
</div>

<!-- Pagination -->
<div id="cuti-pagination" class="flex items-center justify-between mt-3 text-sm text-stone-500"></div>

<!-- Form Modal -->
<div id="cuti-modal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50 p-4">
  <div class="bg-white rounded-2xl shadow-xl w-full max-w-lg max-h-[90vh] overflow-hidden flex flex-col">
    <div class="px-4 sm:px-6 py-3 sm:py-4 border-b border-stone-200 flex justify-between items-center">
      <h3 id="cuti-modal-title" class="text-sm font-bold text-stone-800">Input Ijin/Cuti</h3>
      <button onclick="closeCutiModal()" class="w-7 h-7 rounded-lg hover:bg-stone-100 flex items-center justify-center text-stone-400 hover:text-stone-700 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="p-4 sm:p-6 overflow-y-auto flex-1">
      <form id="cuti-form" class="space-y-4" onsubmit="return false;">
        <input type="hidden" id="cuti-id" />
        <div>
          <label class="text-xs font-semibold text-stone-700">Karyawan <span class="text-red-500">*</span></label>
          <select id="cuti-karyawan" required class="mt-1 w-full h-10 px-3 border border-stone-200 rounded-lg text-xs focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400"></select>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
          <div>
            <label class="text-xs font-semibold text-stone-700">Tanggal Mulai <span class="text-red-500">*</span></label>
            <input id="cuti-tanggal-mulai" type="date" required class="mt-1 w-full h-10 px-3 border border-stone-200 rounded-lg text-xs focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400" />
          </div>
          <div>
            <label class="text-xs font-semibold text-stone-700">Tanggal Selesai</label>
            <input id="cuti-tanggal-selesai" type="date" class="mt-1 w-full h-10 px-3 border border-stone-200 rounded-lg text-xs focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400" />
          </div>
        </div>
        <div>
          <label class="text-xs font-semibold text-stone-700">Jenis <span class="text-red-500">*</span></label>
          <select id="cuti-jenis" onchange="toggleDokumenUpload()" class="mt-1 w-full h-10 px-3 border border-stone-200 rounded-lg text-xs focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400">
            <option value="Izin">Izin</option>
            <option value="Cuti">Cuti</option>
          </select>
        </div>
        <div id="cuti-dokumen-wrap" class="bg-stone-50 rounded-xl p-4 border border-stone-200">
          <label class="text-xs font-semibold text-stone-700">Upload Dokumen Pendukung</label>
          <p class="text-[10px] text-stone-400 mt-0.5 mb-2">Opsional — bisa untuk surat sakit, surat izin, dll.</p>
          <div class="flex items-center gap-3 flex-wrap">
            <button type="button" onclick="document.getElementById('cuti-dokumen-input').click()" class="px-3 py-1.5 text-[10px] border border-stone-300 rounded-lg hover:bg-white transition-colors">Pilih File</button>
            <span id="cuti-dokumen-name" class="text-[10px] text-stone-500"></span>
            <input type="file" id="cuti-dokumen-input" accept=".pdf,.jpg,.jpeg,.png,.webp" class="hidden" onchange="previewDokumenName(this)" />
            <input type="hidden" id="cuti-dokumen" value="" />
            <button type="button" id="cuti-dokumen-hapus" onclick="hapusDokumen()" class="hidden text-[10px] text-red-600 hover:text-red-800">Hapus</button>
          </div>
          <div id="cuti-dokumen-preview" class="mt-2"></div>
        </div>
        <div>
          <label class="text-xs font-semibold text-stone-700">Alasan</label>
          <textarea id="cuti-alasan" class="mt-1 w-full px-3 py-2 border border-stone-200 rounded-lg text-xs focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400" rows="2" placeholder="Alasan izin/cuti..."></textarea>
        </div>
      </form>
    </div>
    <div class="px-4 sm:px-6 py-3 border-t border-stone-200 flex justify-end gap-2">
      <button onclick="closeCutiModal()" class="px-4 py-2 text-xs text-stone-600 hover:bg-stone-100 rounded-lg transition-colors">Batal</button>
      <button id="cuti-save" class="px-4 py-2 text-xs bg-blue-600 hover:bg-blue-700 text-white rounded-lg font-medium transition-colors shadow-sm">Simpan</button>
    </div>
  </div>
</div>
