<!-- Summary Cards -->
<div id="cuti-summary" class="grid grid-cols-2 xl:grid-cols-4 gap-3 sm:gap-4 mb-4 auto-rows-min">
  <div class="dash-card-item relative overflow-hidden bg-white rounded-lg border border-slate-200 p-4 sm:p-5 shadow-sm">
    <span class="absolute inset-x-0 top-0 h-[3px]" style="background:#14326b"></span>
    <div class="flex items-center justify-between mb-1">
      <span class="text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-500">Total</span>
      <span class="flex h-8 w-8 items-center justify-center rounded-md border border-slate-200 bg-slate-50 text-[#14326b]">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </span>
    </div>
    <div id="cuti-stat-total" class="mono text-lg sm:text-2xl font-semibold text-slate-900">—</div>
    <div class="text-[10px] text-slate-500 mt-1">Total pengajuan</div>
  </div>
  <div class="dash-card-item relative overflow-hidden bg-white rounded-lg border border-slate-200 p-4 sm:p-5 shadow-sm">
    <span class="absolute inset-x-0 top-0 h-[3px]" style="background:#b45309"></span>
    <div class="flex items-center justify-between mb-1">
      <span class="text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-500">Menunggu</span>
      <span class="flex h-8 w-8 items-center justify-center rounded-md border border-slate-200 bg-slate-50 text-amber-600">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
      </span>
    </div>
    <div id="cuti-stat-menunggu" class="mono text-lg sm:text-2xl font-semibold text-slate-900">—</div>
    <div class="text-[10px] text-slate-500 mt-1">Menunggu persetujuan</div>
  </div>
  <div class="dash-card-item relative overflow-hidden bg-white rounded-lg border border-slate-200 p-4 sm:p-5 shadow-sm">
    <span class="absolute inset-x-0 top-0 h-[3px]" style="background:#0f766e"></span>
    <div class="flex items-center justify-between mb-1">
      <span class="text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-500">Disetujui</span>
      <span class="flex h-8 w-8 items-center justify-center rounded-md border border-slate-200 bg-slate-50 text-[#0f766e]">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </span>
    </div>
    <div id="cuti-stat-disetujui" class="mono text-lg sm:text-2xl font-semibold text-slate-900">—</div>
    <div class="text-[10px] text-slate-500 mt-1">Pengajuan disetujui</div>
  </div>
  <div class="dash-card-item relative overflow-hidden bg-white rounded-lg border border-slate-200 p-4 sm:p-5 shadow-sm">
    <span class="absolute inset-x-0 top-0 h-[3px]" style="background:#b91c1c"></span>
    <div class="flex items-center justify-between mb-1">
      <span class="text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-500">Ditolak</span>
      <span class="flex h-8 w-8 items-center justify-center rounded-md border border-slate-200 bg-slate-50 text-red-600">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      </span>
    </div>
    <div id="cuti-stat-ditolak" class="mono text-lg sm:text-2xl font-semibold text-slate-900">—</div>
    <div class="text-[10px] text-slate-500 mt-1">Pengajuan ditolak</div>
  </div>
</div>

<!-- Filters & Actions -->
<div class="grid grid-cols-1 xl:grid-cols-4 gap-3 mb-5">
  <div class="xl:col-span-3 dash-card-item bg-white rounded-lg border border-slate-200 shadow-sm px-4 py-3">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <div class="flex flex-wrap items-center gap-2 min-w-0">
        <svg class="w-4 h-4 text-slate-400 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M22 3H2l8 9.46V19l4 2v-8.54L22 3z"/></svg>
        <select id="cuti-filter-karyawan" class="text-xs border border-slate-200 rounded-lg px-3 py-2 bg-white focus:ring-2 focus:ring-[#14326b]/20 focus:border-[#14326b]">
          <option value="">Semua Karyawan</option>
        </select>
        <input id="cuti-filter-tanggal-awal" type="date" class="text-xs border border-slate-200 rounded-lg px-3 py-2 bg-white focus:ring-2 focus:ring-[#14326b]/20 focus:border-[#14326b]" />
        <span class="text-xs text-slate-400">s.d.</span>
        <input id="cuti-filter-tanggal-akhir" type="date" class="text-xs border border-slate-200 rounded-lg px-3 py-2 bg-white focus:ring-2 focus:ring-[#14326b]/20 focus:border-[#14326b]" />
        <select id="cuti-filter-jenis" class="text-xs border border-slate-200 rounded-lg px-3 py-2 bg-white focus:ring-2 focus:ring-[#14326b]/20 focus:border-[#14326b]">
          <option value="">Semua Jenis</option>
          <option value="Izin">Izin</option>
          <option value="Cuti">Cuti</option>
        </select>
        <select id="cuti-filter-status" class="text-xs border border-slate-200 rounded-lg px-3 py-2 bg-white focus:ring-2 focus:ring-[#14326b]/20 focus:border-[#14326b]">
          <option value="">Semua Status</option>
          <option value="Menunggu">Menunggu</option>
          <option value="Disetujui">Disetujui</option>
          <option value="Ditolak">Ditolak</option>
        </select>
      </div>
    </div>
  </div>
  <div class="dash-card-item bg-white rounded-lg border border-slate-200 shadow-sm px-3 py-2.5 flex items-center">
    <div class="flex items-center gap-2 w-full">
      <button onclick="loadIjinCuti()" class="flex-1 min-w-0 h-9 px-2 bg-[#14326b] hover:bg-[#0f2a5f] text-white rounded-lg text-xs font-medium transition-colors shadow-sm flex items-center justify-center gap-1.5 whitespace-nowrap">
        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>Filter
      </button>
      <button onclick="openIjinCutiForm()" class="flex-1 min-w-0 h-9 px-2 border border-slate-300 text-slate-700 hover:bg-slate-50 rounded-lg text-xs font-medium transition-colors flex items-center justify-center gap-1.5 whitespace-nowrap">
        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>+ Tambah
      </button>
    </div>
  </div>
</div>

<!-- Table -->
<div class="dash-panel bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full text-[11px]">
      <thead class="bg-slate-50">
        <tr>
          <th class="text-left px-3 py-2.5 font-bold text-slate-500 text-[10px] uppercase tracking-wider border-r border-slate-200">Karyawan</th>
          <th class="text-left px-3 py-2.5 font-bold text-slate-500 text-[10px] uppercase tracking-wider border-r border-slate-200">NIK</th>
          <th class="text-center px-3 py-2.5 font-bold text-slate-500 text-[10px] uppercase tracking-wider border-r border-slate-200">Jenis</th>
          <th class="text-left px-3 py-2.5 font-bold text-slate-500 text-[10px] uppercase tracking-wider border-r border-slate-200">Tanggal</th>
          <th class="text-left px-3 py-2.5 font-bold text-slate-500 text-[10px] uppercase tracking-wider border-r border-slate-200">Durasi</th>
          <th class="text-center px-3 py-2.5 font-bold text-slate-500 text-[10px] uppercase tracking-wider border-r border-slate-200">Status</th>
          <th class="text-left px-3 py-2.5 font-bold text-slate-500 text-[10px] uppercase tracking-wider border-r border-slate-200">Alasan</th>
          <th class="text-right px-3 py-2.5 font-bold text-slate-500 text-[10px] uppercase tracking-wider">Aksi</th>
        </tr>
      </thead>
      <tbody id="cuti-table-body">
        <tr><td colspan="8" class="text-center py-12 text-slate-400">Memuat data ijin/cuti...</td></tr>
      </tbody>
    </table>
  </div>
</div>

<!-- Pagination -->
<div id="cuti-pagination" class="flex items-center justify-between mt-3 text-sm text-slate-500"></div>

<!-- Form Modal -->
<div id="cuti-modal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50 p-4">
  <div class="dash-panel bg-white rounded-lg border border-slate-200 shadow-xl w-full max-w-lg max-h-[90vh] overflow-hidden flex flex-col">
    <div class="px-4 sm:px-6 py-3 sm:py-4 border-b border-slate-200 flex justify-between items-center">
      <h3 id="cuti-modal-title" class="text-sm font-bold text-slate-800">Input Ijin/Cuti</h3>
      <button onclick="closeCutiModal()" class="w-7 h-7 rounded-lg hover:bg-slate-100 flex items-center justify-center text-slate-400 hover:text-slate-700 transition-colors">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="p-4 sm:p-6 overflow-y-auto flex-1">
      <form id="cuti-form" class="space-y-4" onsubmit="return false;">
        <input type="hidden" id="cuti-id" />
        <div>
          <label class="text-xs font-semibold text-slate-700">Karyawan <span class="text-red-500">*</span></label>
          <select id="cuti-karyawan" required class="mt-1 w-full h-10 px-3 border border-slate-200 rounded-lg text-xs focus:ring-2 focus:ring-[#14326b]/20 focus:border-[#14326b]"></select>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
          <div>
            <label class="text-xs font-semibold text-slate-700">Tanggal Mulai <span class="text-red-500">*</span></label>
            <input id="cuti-tanggal-mulai" type="date" required class="mt-1 w-full h-10 px-3 border border-slate-200 rounded-lg text-xs focus:ring-2 focus:ring-[#14326b]/20 focus:border-[#14326b]" />
          </div>
          <div>
            <label class="text-xs font-semibold text-slate-700">Tanggal Selesai</label>
            <input id="cuti-tanggal-selesai" type="date" class="mt-1 w-full h-10 px-3 border border-slate-200 rounded-lg text-xs focus:ring-2 focus:ring-[#14326b]/20 focus:border-[#14326b]" />
          </div>
        </div>
        <div>
          <label class="text-xs font-semibold text-slate-700">Jenis <span class="text-red-500">*</span></label>
          <select id="cuti-jenis" onchange="toggleDokumenUpload()" class="mt-1 w-full h-10 px-3 border border-slate-200 rounded-lg text-xs focus:ring-2 focus:ring-[#14326b]/20 focus:border-[#14326b]">
            <option value="Izin">Izin</option>
            <option value="Cuti">Cuti</option>
          </select>
        </div>
        <div id="cuti-dokumen-wrap" class="bg-slate-50 rounded-lg p-4 border border-slate-200">
          <label class="text-xs font-semibold text-slate-700">Upload Dokumen Pendukung</label>
          <p class="text-[10px] text-slate-400 mt-0.5 mb-2">Opsional — bisa untuk surat sakit, surat izin, dll.</p>
          <div class="flex items-center gap-3 flex-wrap">
            <button type="button" onclick="document.getElementById('cuti-dokumen-input').click()" class="px-3 py-1.5 text-[10px] border border-slate-300 rounded-lg hover:bg-white transition-colors">Pilih File</button>
            <span id="cuti-dokumen-name" class="text-[10px] text-slate-500"></span>
            <input type="file" id="cuti-dokumen-input" accept=".pdf,.jpg,.jpeg,.png,.webp" class="hidden" onchange="previewDokumenName(this)" />
            <input type="hidden" id="cuti-dokumen" value="" />
            <button type="button" id="cuti-dokumen-hapus" onclick="hapusDokumen()" class="hidden text-[10px] text-red-600 hover:text-red-800">Hapus</button>
          </div>
          <div id="cuti-dokumen-preview" class="mt-2"></div>
        </div>
        <div>
          <label class="text-xs font-semibold text-slate-700">Alasan</label>
          <textarea id="cuti-alasan" class="mt-1 w-full px-3 py-2 border border-slate-200 rounded-lg text-xs focus:ring-2 focus:ring-[#14326b]/20 focus:border-[#14326b]" rows="2" placeholder="Alasan izin/cuti..."></textarea>
        </div>
      </form>
    </div>
    <div class="px-4 sm:px-6 py-3 border-t border-slate-200 flex justify-end gap-2">
      <button onclick="closeCutiModal()" class="px-4 py-2 text-xs text-slate-600 hover:bg-slate-100 rounded-lg transition-colors">Batal</button>
      <button id="cuti-save" class="px-4 py-2 text-xs bg-[#14326b] hover:bg-[#0f2a5f] text-white rounded-lg font-medium transition-colors shadow-sm">Simpan</button>
    </div>
  </div>
</div>
