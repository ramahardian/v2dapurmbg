<div class="grid grid-cols-1 xl:grid-cols-4 gap-3 mb-5">
  <div class="dash-card-item relative overflow-hidden bg-white rounded-lg border border-slate-200 px-4 py-3 shadow-sm xl:col-span-2 flex items-center justify-between">
    <span class="absolute inset-x-0 top-0 h-[3px]" style="background:#14326b"></span>
    <div>
      <div class="text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-500 mb-1">Total Bahan Baku</div>
      <div class="mono text-xl font-semibold text-slate-900" id="bb-stat-total">–</div>
    </div>
    <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-slate-200 bg-slate-50 text-[#14326b]">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M16.5 9.4 7.55 4.24"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.29 7 12 12 20.71 7"/><line x1="12" y1="22" x2="12" y2="12"/></svg>
    </span>
  </div>
  <div class="dash-card-item bg-white rounded-lg border border-slate-200 shadow-sm px-3 py-2.5 xl:col-span-2 flex items-center">
    <div class="flex flex-wrap items-center gap-2 w-full">
      <button id="add-btn" class="flex-1 min-w-0 h-9 px-3 bg-[#14326b] hover:bg-[#0f2a5f] text-white rounded-lg text-xs font-medium shadow-sm transition-colors flex items-center justify-center gap-1.5 whitespace-nowrap">
        <svg class="w-3.5 h-3.5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
        Tambah
      </button>
      <button onclick="toggleSumberFilter()" id="filter-koperasi-btn" class="flex-1 min-w-0 h-9 px-3 border border-slate-300 text-slate-700 hover:bg-slate-50 rounded-lg text-xs font-medium transition-colors whitespace-nowrap">Koperasi</button>
      <button onclick="exportBahanBakuXlsx()" class="flex-1 min-w-0 h-9 px-3 border border-slate-300 text-slate-700 hover:bg-slate-50 rounded-lg text-xs font-medium transition-colors whitespace-nowrap">Export XLSX</button>
    </div>
  </div>
</div>
<div class="relative mb-5">
  <input type="text" id="bahan-search" placeholder="Cari bahan..." autocomplete="off"
    class="w-full h-10 pl-10 pr-4 rounded-lg border border-slate-200 bg-white text-sm shadow-sm focus:ring-2 focus:ring-[#14326b]/20 focus:border-[#14326b] transition-all">
  <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
  </svg>
</div>
<div id="table-wrap" class="dash-panel bg-white rounded-lg border border-slate-200 shadow-sm overflow-hidden"></div>
<div id="bahan-pagination" class="flex items-center justify-between mt-4"></div>