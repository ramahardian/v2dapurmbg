<div class="flex flex-wrap items-center gap-3 mb-5">
  <div class="relative flex-1 min-w-[200px]">
    <input type="text" id="karyawan-search-input" placeholder="Cari karyawan..." autocomplete="off"
      class="w-full h-11 pl-10 pr-4 rounded-xl border border-stone-200 bg-white text-sm shadow-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 transition-all">
    <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
    </svg>
  </div>
  <button id="add-karyawan-btn" onclick="openKaryawanForm()" class="h-11 px-5 bg-[#1e40af] hover:bg-[#1d4ed8] text-white rounded-xl text-sm font-semibold shadow-sm transition-all flex items-center gap-2 shrink-0">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
    Tambah
  </button>
</div>
<div class="bg-white rounded-2xl border border-stone-200 shadow-sm overflow-hidden">
  <div class="overflow-x-auto">
    <table class="w-full">
      <thead>
        <tr class="border-b border-stone-100">
          <th class="text-left px-4 py-3.5 text-[10px] font-bold uppercase tracking-wider text-stone-500">Nama</th>
          <th class="text-left px-4 py-3.5 text-[10px] font-bold uppercase tracking-wider text-stone-500">NIK</th>
          <th class="text-left px-4 py-3.5 text-[10px] font-bold uppercase tracking-wider text-stone-500">Jabatan</th>
          <th class="text-left px-4 py-3.5 text-[10px] font-bold uppercase tracking-wider text-stone-500">Departemen</th>
          <th class="text-right px-4 py-3.5 text-[10px] font-bold uppercase tracking-wider text-stone-500">Gaji Pokok</th>
          <th class="text-left px-4 py-3.5 text-[10px] font-bold uppercase tracking-wider text-stone-500">Status</th>
          <th class="text-right px-4 py-3.5 text-[10px] font-bold uppercase tracking-wider text-stone-500">Aksi</th>
        </tr>
      </thead>
      <tbody id="karyawan-table-body">
        <tr><td colspan="7" class="text-center py-16 text-stone-400"><svg class="w-12 h-12 mx-auto mb-3 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg><div class="text-sm">Memuat data karyawan...</div></td></tr>
      </tbody>
    </table>
  </div>
</div>
<div id="karyawan-pagination" class="flex items-center gap-2 mt-4"></div>

<!-- Modal -->
<div id="karyawan-modal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50 p-4">
  <div class="bg-white rounded-2xl shadow-xl w-full max-w-lg max-h-[90vh] overflow-hidden flex flex-col">
    <div class="px-5 sm:px-6 py-4 border-b border-stone-200 flex justify-between items-center">
      <h3 id="karyawan-modal-title" class="text-base font-bold text-stone-800">Tambah Karyawan</h3>
      <button onclick="closeModal('karyawan-modal')" class="w-8 h-8 flex items-center justify-center rounded-lg text-stone-400 hover:text-stone-700 hover:bg-stone-100 transition-colors">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
    <div class="p-5 sm:p-6 overflow-y-auto flex-1">
      <form id="karyawan-form" class="space-y-4">
        <input type="hidden" id="karyawan-id" />
        <div>
          <label class="text-xs font-semibold text-stone-600 uppercase tracking-wider">Nama Lengkap <span class="text-red-500">*</span></label>
          <input id="karyawan-nama" type="text" required class="mt-1.5 w-full h-11 px-3 rounded-lg border border-stone-200 text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 transition-all" />
        </div>
        <div>
          <label class="text-xs font-semibold text-stone-600 uppercase tracking-wider">NIK</label>
          <input id="karyawan-nik" type="text" class="mt-1.5 w-full h-11 px-3 rounded-lg border border-stone-200 text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 transition-all" />
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
          <div>
            <label class="text-xs font-semibold text-stone-600 uppercase tracking-wider">Jabatan</label>
            <select id="karyawan-jabatan" class="mt-1.5 w-full h-11 px-3 rounded-lg border border-stone-200 text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 transition-all"></select>
          </div>
          <div>
            <label class="text-xs font-semibold text-stone-600 uppercase tracking-wider">Departemen</label>
            <select id="karyawan-departemen" class="mt-1.5 w-full h-11 px-3 rounded-lg border border-stone-200 text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 transition-all"></select>
          </div>
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
          <div>
            <label class="text-xs font-semibold text-stone-600 uppercase tracking-wider">Gaji Pokok (Rp)</label>
            <input id="karyawan-gaji" type="number" class="mt-1.5 w-full h-11 px-3 rounded-lg border border-stone-200 text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 transition-all" />
          </div>
          <div>
            <label class="text-xs font-semibold text-stone-600 uppercase tracking-wider">Status</label>
            <select id="karyawan-status" class="mt-1.5 w-full h-11 px-3 rounded-lg border border-stone-200 text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 transition-all">
              <option value="Aktif">Aktif</option>
              <option value="Cuti">Cuti</option>
              <option value="Resign">Resign</option>
            </select>
          </div>
        </div>
        <div>
          <label class="text-xs font-semibold text-stone-600 uppercase tracking-wider">Tanggal Masuk</label>
          <input id="karyawan-masuk" type="date" class="mt-1.5 w-full h-11 px-3 rounded-lg border border-stone-200 text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 transition-all" />
        </div>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 sm:gap-4">
          <div>
            <label class="text-xs font-semibold text-stone-600 uppercase tracking-wider">Email</label>
            <input id="karyawan-email" type="email" class="mt-1.5 w-full h-11 px-3 rounded-lg border border-stone-200 text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 transition-all" placeholder="email@example.com" />
          </div>
          <div>
            <label class="text-xs font-semibold text-stone-600 uppercase tracking-wider">Telepon</label>
            <input id="karyawan-telepon" type="text" class="mt-1.5 w-full h-11 px-3 rounded-lg border border-stone-200 text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 transition-all" placeholder="08xxxxxxxxxx" />
          </div>
        </div>
        <div>
          <label class="text-xs font-semibold text-stone-600 uppercase tracking-wider">Alamat</label>
          <textarea id="karyawan-alamat" rows="2" class="mt-1.5 w-full px-3 py-2.5 rounded-lg border border-stone-200 text-sm focus:ring-2 focus:ring-blue-500/20 focus:border-blue-400 transition-all" placeholder="Alamat lengkap"></textarea>
        </div>
        <div>
          <label class="text-xs font-semibold text-stone-600 uppercase tracking-wider">Foto Profil</label>
          <div class="flex items-center gap-4 mt-2">
            <div id="karyawan-photo-preview" class="w-16 h-16 rounded-full bg-stone-100 flex items-center justify-center overflow-hidden shrink-0 border-2 border-stone-200">
              <svg class="w-6 h-6 text-stone-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
            </div>
            <div class="flex flex-col gap-1.5">
              <input id="karyawan-photo-input" type="file" accept="image/*" class="text-sm text-stone-600 file:mr-3 file:py-1.5 file:px-4 file:rounded-lg file:border-0 file:text-sm file:font-semibold file:bg-[#1e40af] file:text-white hover:file:bg-[#1d4ed8] file:cursor-pointer cursor-pointer transition-all" />
              <button type="button" id="karyawan-photo-hapus" class="text-xs text-red-600 text-left hover:underline hidden">Hapus foto</button>
            </div>
          </div>
        </div>
      </form>
    </div>
    <div class="px-5 sm:px-6 py-4 border-t border-stone-200 flex justify-end gap-2">
      <button onclick="closeModal('karyawan-modal')" class="h-10 px-5 text-sm font-medium text-stone-600 bg-stone-100 hover:bg-stone-200 rounded-xl transition-all">Batal</button>
      <button id="karyawan-save" class="h-10 px-5 text-sm font-semibold bg-[#1e40af] hover:bg-[#1d4ed8] text-white rounded-xl shadow-sm transition-all">Simpan</button>
    </div>
  </div>
</div>
