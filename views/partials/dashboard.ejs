<div class="grid grid-cols-2 xl:grid-cols-4 gap-3 sm:gap-4 mb-6 auto-rows-min">

<!-- ══════════ Hero ══════════ -->
<div class="dash-card-item relative overflow-hidden rounded-lg border border-[#0f2a5f] text-white p-5 sm:p-6 lg:p-8 shadow-sm col-span-2 xl:col-span-4"
     style="animation-delay:0ms; background-image: linear-gradient(115deg, rgba(9,26,58,.97) 0%, rgba(20,50,107,.94) 55%, rgba(15,42,95,.92) 100%), url('/bg.jpeg'); background-size: cover; background-position: center;">
  <div class="absolute inset-0 opacity-[0.07]"
       style="background-image: linear-gradient(rgba(255,255,255,.6) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,.6) 1px, transparent 1px); background-size: 44px 44px;"></div>
  <div class="relative flex flex-col md:flex-row md:items-center md:justify-between gap-5">
    <div class="min-w-0">
      <div class="flex items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.18em] text-slate-300">
        <span class="h-1.5 w-1.5 rounded-full bg-[#c6a664]"></span>
        Sistem Operasional <%= tenant && tenant.nama ? tenant.nama : 'Sppg Sukaluyu Tamansari' %>
      </div>
      <h2 class="mt-2 text-xl sm:text-2xl font-semibold tracking-tight text-white">Selamat datang kembali, <%= user.nama %></h2>
      <p class="mt-1 text-xs text-slate-300/90">Ringkasan operasional dapur hari ini.</p>
    </div>
    <div class="hidden md:block text-right shrink-0 border-l border-white/15 pl-6">
      <div class="text-[10px] font-semibold uppercase tracking-[0.14em] text-slate-300">Penyerapan Budget</div>
      <div class="mono mt-1 text-2xl font-semibold text-white"><%= summary.persen_budget %>%</div>
      <div class="w-28 h-1.5 bg-white/20 rounded-full mt-2 ml-auto overflow-hidden">
        <div class="h-full rounded-full" style="width:<%= Math.min(summary.persen_budget,100) %>%; background:#c6a664;"></div>
      </div>
    </div>
  </div>
</div>

<!-- ══════════ KPI ══════════ -->
<div class="dash-card-item relative overflow-hidden bg-white rounded-lg border border-slate-200 p-4 sm:p-5 shadow-sm" style="animation-delay:60ms">
  <span class="absolute inset-x-0 top-0 h-[3px]" style="background:#0f766e"></span>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <div class="text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-500">Total Penerima</div>
      <div class="mono mt-2 text-lg sm:text-2xl font-semibold break-words text-slate-900"><span class="dash-count" data-count="<%= summary.total_penerima_manfaat %>">0</span></div>
      <div class="text-[10px] text-slate-500 mt-1">Paket Besar: <b class="text-slate-700"><span class="dash-count" data-count="<%= summary.paket_besar %>">0</span></b> &bull; Paket Kecil: <b class="text-slate-700"><span class="dash-count" data-count="<%= summary.paket_kecil %>">0</span></b></div>
    </div>
    <span class="dash-icon-pulse flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-slate-200 bg-slate-50 text-[#0f766e]">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
    </span>
  </div>
</div>

<div class="dash-card-item relative overflow-hidden bg-white rounded-lg border border-slate-200 p-4 sm:p-5 shadow-sm" style="animation-delay:120ms">
  <span class="absolute inset-x-0 top-0 h-[3px]" style="background:#14326b"></span>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <div class="text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-500">Porsi Diproduksi</div>
      <div class="mono mt-2 text-lg sm:text-2xl font-semibold break-words text-slate-900"><span class="dash-count" data-count="<%= summary.total_porsi_diproduksi %>">0</span></div>
      <div class="text-[10px] text-slate-500 mt-1">Akumulasi semua produksi</div>
    </div>
    <span class="dash-icon-pulse flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-slate-200 bg-slate-50 text-[#14326b]">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M16.5 9.4 7.55 4.24"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.29 7 12 12 20.71 7"/><line x1="12" y1="22" x2="12" y2="12"/></svg>
    </span>
  </div>
</div>

<div class="dash-card-item relative overflow-hidden bg-white rounded-lg border border-slate-200 p-4 sm:p-5 shadow-sm" style="animation-delay:180ms">
  <span class="absolute inset-x-0 top-0 h-[3px]" style="background:#c6a664"></span>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <div class="text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-500">Realisasi Budget</div>
      <div class="mono mt-2 text-lg sm:text-2xl font-semibold break-words text-slate-900"><span class="dash-count" data-count="<%= summary.total_realisasi %>" data-format="idr">Rp 0</span></div>
      <div class="text-[10px] text-slate-500 mt-1">dari Rp <%= summary.total_budget.toLocaleString('id-ID') %></div>
    </div>
    <span class="dash-icon-pulse flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-slate-200 bg-slate-50 text-[#a8853f]">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
    </span>
  </div>
</div>

<div class="dash-card-item relative overflow-hidden bg-white rounded-lg border border-slate-200 p-4 sm:p-5 shadow-sm" style="animation-delay:240ms">
  <span class="absolute inset-x-0 top-0 h-[3px]" style="background:#64748b"></span>
  <div class="flex items-start justify-between gap-3">
    <div class="min-w-0">
      <div class="text-[10px] font-semibold uppercase tracking-[0.12em] text-slate-500">Ijin/Cuti Hari Ini</div>
      <div class="mono mt-2 text-lg sm:text-2xl font-semibold break-words text-slate-900"><span class="dash-count" data-count="<%= summary.ijin_cuti_hari_ini %>">0</span></div>
      <div class="text-[10px] text-slate-500 mt-1">Menunggu persetujuan: <b class="text-slate-700"><span class="dash-count" data-count="<%= summary.ijin_cuti_menunggu %>">0</span></b></div>
    </div>
    <span class="dash-icon-pulse flex h-9 w-9 shrink-0 items-center justify-center rounded-md border border-slate-200 bg-slate-50 text-[#475569]">
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
    </span>
  </div>
</div>

<!-- Export RAB + User Online -->
<div class="contents">
  <% if (user.role === 'admin' || user.role === 'keuangan') { %>
  <div class="dash-card-item bg-white rounded-lg border border-slate-200 shadow-sm p-5 col-span-2 xl:col-span-2" style="animation-delay:340ms">
    <div class="flex items-center justify-between mb-1">
      <div class="flex items-center gap-2.5">
        <span class="flex h-8 w-8 items-center justify-center rounded-md border border-slate-200 bg-slate-50 text-[#14326b]">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/></svg>
        </span>
        <h3 class="font-semibold text-slate-900">Export RAB Harian (XLSX)</h3>
      </div>
    </div>
    <p class="text-xs leading-relaxed text-slate-500 mb-4 pl-0.5">Unduh RAB Harian (rencana belanja bahan baku per hari) untuk tanggal tertentu atau rentang tanggal — format Excel template RAB.</p>
    <div class="flex flex-wrap items-end gap-3">
      <label class="flex flex-col gap-1">
        <span class="text-[10px] font-semibold uppercase tracking-[0.1em] text-slate-500">Tanggal</span>
        <input type="date" id="dash-rh-tanggal" value="<%= new Date().toISOString().slice(0, 10) %>" class="text-xs border border-slate-300 rounded-md px-2.5 py-2 bg-white text-slate-700 focus:ring-2 focus:ring-[#14326b]/15 focus:border-[#14326b] outline-none">
      </label>
      <span class="text-xs text-slate-400 pb-2.5">s/d</span>
      <label class="flex flex-col gap-1">
        <span class="text-[10px] font-semibold uppercase tracking-[0.1em] text-slate-500">Sampai</span>
        <input type="date" id="dash-rh-tanggal-sampai" value="<%= new Date().toISOString().slice(0, 10) %>" class="text-xs border border-slate-300 rounded-md px-2.5 py-2 bg-white text-slate-700 focus:ring-2 focus:ring-[#14326b]/15 focus:border-[#14326b] outline-none" title="Tanggal akhir rentang (opsional, maks. 31 hari)">
      </label>
      <button onclick="exportDashboardRabHarian()" class="inline-flex items-center gap-1.5 text-xs font-semibold text-white bg-[#14326b] hover:bg-[#0f2a5f] px-3.5 py-2 rounded-md transition-colors shadow-sm">
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>
        Export XLSX
      </button>
    </div>
  </div>
  <% } else { %>
  <div class="dash-card-item bg-white rounded-lg border border-slate-200 shadow-sm p-5 flex-1 min-w-0 hidden" id="export-rab-placeholder" style="animation-delay:340ms"></div>
  <% } %>

  <!-- Online Users Card -->
  <div class="dash-card-item bg-white rounded-lg border border-slate-200 shadow-sm p-5 col-span-2 xl:col-span-2" style="animation-delay:540ms">
    <div class="flex items-center justify-between mb-4">
      <div class="flex items-center gap-2.5">
        <span class="flex h-8 w-8 items-center justify-center rounded-md border border-slate-200 bg-slate-50 text-[#0f766e]">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
        </span>
        <h3 class="font-semibold text-slate-900">User Online Saat Ini</h3>
      </div>
      <span id="online-count" class="mono text-xs font-semibold text-[#14326b] bg-slate-50 border border-slate-200 rounded-md px-2 py-0.5">&mdash;</span>
    </div>
    <div id="online-users-list" class="space-y-1.5 max-h-48 overflow-y-auto">
      <div class="text-sm text-slate-400 text-center py-4">Memuat...</div>
    </div>
    <div class="mt-3 pt-3 border-t border-slate-100 text-center">
      <button onclick="loadOnlineUsers()" class="text-xs font-semibold text-[#14326b] hover:text-[#0f2a5f] hover:underline">Refresh</button>
      <span class="mx-2 text-slate-300">|</span>
      <button onclick="openOnlineHistory()" class="text-xs font-semibold text-[#14326b] hover:text-[#0f2a5f] hover:underline">Riwayat</button>
      <span class="mx-2 text-slate-300">|</span>
      <span class="text-[10px] text-slate-400">Auto-refresh tiap 30 detik</span>
    </div>
  </div>
</div>

<% var ma = summary.menu_aktif; %>
<% var maList = summary.menu_aktif_list || []; %>
<% var maJenjang = (function(kp){ if(!kp) return []; try { var p = JSON.parse(kp); if (Array.isArray(p)) return p; } catch(e){} return [kp]; })(ma && ma.kategori); %>
<% var maJenjangLabel = maJenjang.length > 1 ? maJenjang[0] + ' +' + (maJenjang.length - 1) : (maJenjang[0] || ''); %>
<div class="dash-card-item bg-white rounded-lg border border-slate-200 shadow-sm p-5 col-span-2 xl:col-span-2" id="dash-menu-card" style="animation-delay:420ms">
  <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
    <div class="flex items-center gap-2.5 min-w-0">
      <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-md border border-slate-200 bg-slate-50 text-[#0f766e]">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
      </span>
      <h3 class="font-semibold text-slate-900">Menu Hari Ini</h3>
    </div>
    <% if (ma) { %>
      <div class="flex items-center gap-1.5 shrink-0">
        <% if (user.role === 'admin' || user.role === 'ahli_gizi') { %>
        <button type="button" onclick="dashMenuOpenEditor()" id="dash-menu-editor" class="inline-flex items-center gap-1.5 h-8 px-2.5 rounded-md border border-[#c9d6ea] bg-[#eef2f9] text-[#14326b] hover:bg-[#e3eaf5] transition-colors" aria-label="Buat postingan media sosial" title="Buat postingan media sosial">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="3" width="18" height="18" rx="2" stroke-width="2"/><circle cx="8.5" cy="8.5" r="1.5" stroke-width="2"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 15l-5-5L5 21"/></svg>
          <span class="hidden sm:inline text-[11px] font-semibold">Buat Postingan</span>
        </button>
        <% } %>
        <button type="button" onclick="dashMenuNav(-1)" id="dash-menu-prev" class="w-8 h-8 flex items-center justify-center rounded-md border border-slate-300 text-slate-500 hover:bg-slate-50 hover:text-slate-700 transition-colors disabled:opacity-40 disabled:cursor-not-allowed" aria-label="Hari sebelumnya">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M15 18l-6-6 6-6"/></svg>
        </button>
        <span class="inline-flex items-center gap-1 px-2 py-1 rounded-md bg-[#eef2f9] border border-[#c9d6ea] text-[#14326b] text-[10px] font-semibold uppercase tracking-wider whitespace-nowrap">
          <span class="w-1.5 h-1.5 rounded-full bg-[#0f766e] animate-pulse"></span>
          Hari <span id="dash-menu-hari"><%= ma.hari_ke %></span>/<span id="dash-menu-total"><%= ma.total_hari %></span>
        </span>
        <button type="button" onclick="dashMenuNav(1)" id="dash-menu-next" class="w-8 h-8 flex items-center justify-center rounded-md border border-slate-300 text-slate-500 hover:bg-slate-50 hover:text-slate-700 transition-colors disabled:opacity-40 disabled:cursor-not-allowed" aria-label="Hari berikutnya">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9 18l6-6-6-6"/></svg>
        </button>
      </div>
      <span id="dash-menu-today-hari" class="hidden"><%= ma.hari_ke %></span>
    <% } %>
  </div>
  <% if (ma) { %>
    <div id="dash-menu-body">
      <div class="space-y-4">
        <div class="flex flex-col sm:flex-row gap-4">
          <% if (ma.foto) { %>
            <div class="shrink-0 w-full sm:w-32 h-40 sm:h-28 rounded-md overflow-hidden border border-slate-200 bg-slate-50">
              <img src="<%= ma.foto %>" alt="Foto menu" class="w-full h-full object-cover">
            </div>
          <% } %>
          <div class="flex flex-1 flex-col sm:flex-row sm:items-center sm:justify-between gap-3 min-w-0">
            <div class="min-w-0">
              <div class="flex items-center gap-2 flex-wrap mb-1.5">
                <span class="text-[10px] font-semibold uppercase tracking-wider text-[#14326b] bg-[#eef2f9] border border-[#c9d6ea] rounded px-2 py-0.5"><%= ma.siklus_nama %></span>
                <% if (maJenjangLabel) { %><span class="text-[10px] font-semibold uppercase tracking-wider text-slate-400"><%= maJenjangLabel %></span><% } %>
              </div>
              <% if (ma.menu_nama) { %>
                <div class="text-lg font-semibold text-slate-900 leading-relaxed text-pretty"><%= ma.menu_nama %></div>
              <% } else { %>
                <div class="inline-flex items-center gap-2 px-3 py-2 rounded-md bg-amber-50 border border-amber-200">
                  <svg class="w-4 h-4 text-amber-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"/></svg>
                  <span class="text-sm font-semibold text-amber-700">Menu belum diisi</span>
                  <a href="/siklus" data-key="siklus" class="text-xs font-semibold text-[#14326b] underline hover:no-underline ml-1">Isi sekarang &rarr;</a>
                </div>
              <% } %>
            </div>
            <div class="shrink-0">
              <div class="text-[10px] font-semibold uppercase tracking-wider text-slate-400 mb-1">Porsi</div>
              <div class="mono text-sm font-semibold text-slate-700"><%= ma.porsi_item.toLocaleString('id-ID') %><% if (ma.jumlah_porsi > 0) { %> / <%= ma.jumlah_porsi.toLocaleString('id-ID') %> porsi<% } %></div>
            </div>
          </div>
        </div>
        <% if (ma.kalori > 0) { %>
          <div class="grid grid-cols-4 gap-2 border-t border-slate-100 pt-3">
            <div class="text-center">
              <div class="mono text-sm font-semibold text-orange-700"><%= ma.kalori.toLocaleString('id-ID') %></div>
              <div class="text-[9px] text-slate-400 font-semibold uppercase tracking-wider mt-0.5">Kalori</div>
            </div>
            <div class="text-center">
              <div class="mono text-sm font-semibold text-[#14326b]"><%= ma.protein.toLocaleString('id-ID') %>g</div>
              <div class="text-[9px] text-slate-400 font-semibold uppercase tracking-wider mt-0.5">Protein</div>
            </div>
            <div class="text-center">
              <div class="mono text-sm font-semibold text-amber-700"><%= ma.karbohidrat.toLocaleString('id-ID') %>g</div>
              <div class="text-[9px] text-slate-400 font-semibold uppercase tracking-wider mt-0.5">Karbo</div>
            </div>
            <div class="text-center">
              <div class="mono text-sm font-semibold text-rose-700"><%= ma.lemak.toLocaleString('id-ID') %>g</div>
              <div class="text-[9px] text-slate-400 font-semibold uppercase tracking-wider mt-0.5">Lemak</div>
            </div>
          </div>
        <% } %>
      </div>
    </div>
  <% } else { %>
    <div class="text-sm text-slate-400 py-6 text-center flex flex-col items-center gap-2">
      <svg class="w-6 h-6 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
      Belum ada siklus aktif. <a href="/siklus" data-key="siklus" class="font-semibold text-[#14326b] underline hover:no-underline">Aktifkan siklus &rarr;</a>
    </div>
  <% } %>
  <script type="application/json" id="dash-menu-data"><%- JSON.stringify(maList).replace(/<\//g, '<\\/') %></script>
</div>

<div class="dash-card-item bg-white rounded-lg border border-slate-200 shadow-sm p-5 col-span-2 xl:col-span-2" style="animation-delay:480ms">
  <div class="flex items-center justify-between mb-4">
    <div class="flex items-center gap-2.5">
      <span class="flex h-8 w-8 items-center justify-center rounded-md border border-slate-200 bg-slate-50 text-[#14326b]">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M18 20V10M12 20V4M6 20v-6"/></svg>
      </span>
      <h3 class="font-semibold text-slate-900">Produksi 7 Hari Terakhir</h3>
    </div>
    <span class="mono text-xs font-semibold text-[#14326b]"><%= summary.grafik_total_7hari.toLocaleString('id-ID') %> porsi</span>
  </div>
  <% if (summary.grafik_total_7hari > 0) { %>
    <div class="flex items-end gap-2 sm:gap-3 h-40">
      <% summary.grafik_produksi.forEach(function(g) { %>
        <% var h = Math.max(4, Math.round((g.porsi / summary.grafik_max_porsi) * 100)); %>
        <div class="flex-1 flex flex-col items-center gap-1.5 min-w-0">
          <div class="w-full rounded-t bg-gradient-to-t from-[#14326b] to-[#3f74c4] transition-all duration-500" style="height:<%= h %>%"></div>
          <div class="text-[9px] text-slate-400 truncate w-full text-center"><%= g.label %></div>
        </div>
      <% }); %>
    </div>
    <div class="mt-2 flex justify-between text-[9px] text-slate-300">
      <span>7 hari lalu</span><span>Hari ini</span>
    </div>
  <% } else { %>
    <div class="text-sm text-slate-400 py-8 text-center">Belum ada data produksi dalam 7 hari terakhir.</div>
  <% } %>
</div>

</div><!-- /dash-bento -->

<!-- Modal Riwayat User Online -->
<style>
  #oh-range-pills .oh-pill { color: #64748b; }
  #oh-range-pills .oh-pill:hover { color: #0f172a; }
  #oh-range-pills .oh-pill-active { background: #fff; color: #14326b; box-shadow: 0 1px 2px rgba(15,23,42,.10); font-weight: 600; }
</style>
<div id="online-history-modal" class="fixed inset-0 bg-black/50 hidden items-center justify-center z-50 p-4">
  <div class="bg-white rounded-lg border border-slate-200 shadow-xl w-full max-w-2xl max-h-[85vh] flex flex-col overflow-hidden">
    <div class="flex items-start justify-between px-5 py-4 border-b border-slate-200">
      <div class="flex items-center gap-3">
        <div class="w-9 h-9 rounded-md bg-[#eef2f9] border border-[#c9d6ea] text-[#14326b] flex items-center justify-center shrink-0">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <div>
          <h3 class="font-semibold text-slate-900 leading-tight">Riwayat User Online</h3>
          <p class="text-[10px] text-slate-400 mt-0.5">Log login &amp; aktivitas user pada rentang terpilih</p>
        </div>
      </div>
      <button onclick="closeOnlineHistory()" class="w-8 h-8 flex items-center justify-center rounded-md text-slate-400 hover:text-slate-700 hover:bg-slate-100 transition-colors" aria-label="Tutup">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
      </button>
    </div>

    <div class="px-5 py-3 border-b border-slate-200 flex flex-wrap items-center gap-x-4 gap-y-2">
      <div class="flex items-center gap-1 p-1 bg-slate-100 rounded-md" id="oh-range-pills">
        <button onclick="ohSetRange(1)" data-days="1" class="oh-pill px-2.5 py-1 rounded text-[11px] font-medium transition-colors">Hari ini</button>
        <button onclick="ohSetRange(7)" data-days="7" class="oh-pill px-2.5 py-1 rounded text-[11px] font-medium transition-colors">7 hari</button>
        <button onclick="ohSetRange(30)" data-days="30" class="oh-pill px-2.5 py-1 rounded text-[11px] font-medium transition-colors">30 hari</button>
        <button onclick="ohSetRange(90)" data-days="90" class="oh-pill px-2.5 py-1 rounded text-[11px] font-medium transition-colors">90 hari</button>
      </div>
      <div class="flex items-center gap-2 ml-auto">
        <div class="relative">
          <select id="oh-user" onchange="loadOnlineHistory()" class="text-xs border border-slate-300 rounded-md pl-3 pr-8 py-1.5 bg-white text-slate-700 focus:ring-2 focus:ring-[#14326b]/15 focus:border-[#14326b] appearance-none cursor-pointer outline-none">
            <option value="">Semua user</option>
          </select>
          <svg class="w-3.5 h-3.5 text-slate-400 absolute right-2 top-1/2 -translate-y-1/2 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
        </div>
        <button onclick="clearOnlineHistoryLog()" title="Bersihkan log aktivitas" class="h-8 px-2.5 flex items-center gap-1 rounded-md border border-slate-300 text-slate-500 hover:bg-rose-50 hover:text-rose-600 hover:border-rose-200 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
          <span class="text-[10px] font-medium">Bersihkan</span>
        </button>
        <button onclick="loadOnlineHistory()" title="Muat ulang" class="w-8 h-8 flex items-center justify-center rounded-md border border-slate-300 text-slate-500 hover:bg-slate-50 hover:text-slate-700 transition-colors">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/></svg>
        </button>
      </div>
    </div>

    <div class="px-5 py-2.5 border-b border-slate-100 flex items-center justify-between gap-3">
      <div class="flex items-center gap-2 text-[11px] text-slate-500">
        <span class="font-semibold text-[#0f766e]"><span id="oh-stat-total">0</span> aktivitas</span>
        <span class="text-slate-300">&middot;</span>
        <span class="font-semibold text-[#14326b]"><span id="oh-stat-login">0</span> login</span>
        <span class="text-slate-300">&middot;</span>
        <span class="font-semibold text-slate-600"><span id="oh-stat-user">0</span> user</span>
      </div>
      <span id="oh-range-info" class="text-[10px] text-slate-400 whitespace-nowrap"></span>
    </div>

    <div id="oh-summary" class="px-5 py-2.5 border-b border-slate-100"></div>

    <div id="oh-list" class="flex-1 overflow-y-auto"></div>
    <!-- Pagination tetap tampil di bawah (sticky footer), tidak ikut tergulir -->
    <div id="oh-pagination" class="shrink-0 bg-white"></div>
  </div>
</div>
