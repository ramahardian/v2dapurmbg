<div class="rounded-2xl bg-gradient-to-r from-[#1e40af] to-[#1d4ed8] text-white p-6 lg:p-8 mb-6 shadow-sm">
  <div class="text-[10px] uppercase tracking-wider text-white/60 font-bold mb-2">Sistem Operasional Dapur Sukaluyu</div>
  <h2 class="text-2xl font-bold">Selamat datang kembali, <%= user.nama %></h2>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
  <div class="bg-gradient-to-br from-emerald-50 to-emerald-100/60 rounded-2xl border border-emerald-200/60 p-5 shadow-sm">
    <div class="flex items-center justify-between mb-1">
      <span class="text-[10px] font-semibold uppercase tracking-wider text-emerald-700">Total Penerima</span>
      <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
    </div>
    <div class="mono text-2xl font-bold text-emerald-800"><%= summary.total_penerima_manfaat %></div>
    <div class="text-[10px] text-emerald-600/70 mt-1">Paket Besar: <b><%= summary.paket_besar %></b> • Paket Kecil: <b><%= summary.paket_kecil %></b></div>
  </div>
  <div class="bg-gradient-to-br from-blue-50 to-blue-100/60 rounded-2xl border border-blue-200/60 p-5 shadow-sm">
    <div class="flex items-center justify-between mb-1">
      <span class="text-[10px] font-semibold uppercase tracking-wider text-blue-700">Porsi Diproduksi</span>
      <svg class="w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M16.5 9.4 7.55 4.24"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.29 7 12 12 20.71 7"/><line x1="12" y1="22" x2="12" y2="12"/></svg>
    </div>
    <div class="mono text-2xl font-bold text-blue-800"><%= summary.total_porsi_diproduksi %></div>
    <div class="text-[10px] text-blue-600/70 mt-1">Akumulasi semua produksi</div>
  </div>
  <div class="bg-gradient-to-br from-amber-50 to-amber-100/60 rounded-2xl border border-amber-200/60 p-5 shadow-sm">
    <div class="flex items-center justify-between mb-1">
      <span class="text-[10px] font-semibold uppercase tracking-wider text-amber-700">Realisasi Budget</span>
      <svg class="w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
    </div>
    <div class="mono text-2xl font-bold text-amber-800">Rp <%= summary.total_realisasi.toLocaleString('id-ID') %></div>
    <div class="text-[10px] text-amber-600/70 mt-1">dari Rp <%= summary.total_budget.toLocaleString('id-ID') %></div>
  </div>
  <div class="bg-gradient-to-br from-rose-50 to-rose-100/60 rounded-2xl border border-rose-200/60 p-5 shadow-sm">
    <div class="flex items-center justify-between mb-1">
      <span class="text-[10px] font-semibold uppercase tracking-wider text-rose-700">Stok Menipis</span>
      <svg class="w-4 h-4 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 9v2m0 4h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>
    </div>
    <div class="mono text-2xl font-bold text-rose-800"><%= summary.stok_menipis %></div>
    <div class="text-[10px] text-rose-600/70 mt-1"><%= summary.jumlah_bahan_baku %> bahan total</div>
  </div>
  <div class="bg-gradient-to-br from-violet-50 to-violet-100/60 rounded-2xl border border-violet-200/60 p-5 shadow-sm">
    <div class="flex items-center justify-between mb-1">
      <span class="text-[10px] font-semibold uppercase tracking-wider text-violet-700">Ijin/Cuti Hari Ini</span>
      <svg class="w-4 h-4 text-violet-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
    </div>
    <div class="mono text-2xl font-bold text-violet-800"><%= summary.ijin_cuti_hari_ini || 0 %></div>
    <div class="text-[10px] text-violet-600/70 mt-1">Menunggu persetujuan: <b><%= summary.ijin_cuti_menunggu || 0 %></b></div>
  </div>
</div>
<div class="bg-white rounded-2xl border border-stone-200 shadow-sm p-5 mb-6">
  <div class="flex items-center gap-2 mb-4">
    <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 9v2m0 4h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>
    <h3 class="font-bold text-stone-800">Stok Menipis</h3>
  </div>
  <% if (summary.low_stock_items && summary.low_stock_items.length > 0) { %>
    <ul class="space-y-2">
      <% summary.low_stock_items.forEach(function(it) { %>
        <li class="flex justify-between border-b border-stone-100 pb-2 last:border-0">
          <div>
            <div class="text-sm font-medium text-stone-700"><%= it.nama %></div>
            <div class="text-[10px] text-stone-500">Min: <%= it.min %> <%= it.satuan %></div>
          </div>
          <div class="mono text-sm text-red-700 font-semibold"><%= it.stok %> <%= it.satuan %></div>
        </li>
      <% }); %>
    </ul>
  <% } else { %>
    <div class="text-sm text-stone-400 py-4 flex items-center gap-2">
      <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
      Semua stok aman
    </div>
  <% } %>
</div>
