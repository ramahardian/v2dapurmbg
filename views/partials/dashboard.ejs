<div class="rounded-2xl bg-gradient-to-r from-[#1e40af] to-[#1d4ed8] text-white p-6 lg:p-8 mb-6 shadow-sm dash-card-item" style="animation-delay:0ms">
  <div class="flex items-center justify-between gap-4">
    <div>
      <div class="text-[10px] uppercase tracking-wider text-white/60 font-bold mb-2">Sistem Operasional Dapur Sukaluyu</div>
      <h2 class="text-2xl font-bold">Selamat datang kembali, <%= user.nama %></h2>
    </div>
    <div class="hidden md:block text-right shrink-0">
      <div class="text-[10px] uppercase tracking-wider text-white/60 font-bold mb-1">Penyerapan Budget</div>
      <div class="mono text-lg font-bold"><%= summary.persen_budget %>%</div>
      <div class="w-24 h-1.5 bg-white/20 rounded-full mt-1.5 ml-auto overflow-hidden">
        <div class="h-full bg-white rounded-full" style="width:<%= Math.min(summary.persen_budget,100) %>%"></div>
      </div>
    </div>
  </div>
</div>
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
  <div class="dash-card-item bg-gradient-to-br from-emerald-50 to-emerald-100/60 rounded-2xl border border-emerald-200/60 p-5 shadow-sm" style="animation-delay:60ms">
    <div class="flex items-center justify-between mb-1">
      <span class="text-[10px] font-semibold uppercase tracking-wider text-emerald-700">Total Penerima</span>
      <svg class="dash-icon-pulse w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
    </div>
    <div class="mono text-2xl font-bold text-emerald-800"><span class="dash-count" data-count="<%= summary.total_penerima_manfaat %>">0</span></div>
    <div class="text-[10px] text-emerald-600/70 mt-1">Paket Besar: <b><span class="dash-count" data-count="<%= summary.paket_besar %>">0</span></b> • Paket Kecil: <b><span class="dash-count" data-count="<%= summary.paket_kecil %>">0</span></b></div>
  </div>
  <div class="dash-card-item bg-gradient-to-br from-blue-50 to-blue-100/60 rounded-2xl border border-blue-200/60 p-5 shadow-sm" style="animation-delay:120ms">
    <div class="flex items-center justify-between mb-1">
      <span class="text-[10px] font-semibold uppercase tracking-wider text-blue-700">Porsi Diproduksi</span>
      <svg class="dash-icon-pulse w-4 h-4 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M16.5 9.4 7.55 4.24"/><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.29 7 12 12 20.71 7"/><line x1="12" y1="22" x2="12" y2="12"/></svg>
    </div>
    <div class="mono text-2xl font-bold text-blue-800"><span class="dash-count" data-count="<%= summary.total_porsi_diproduksi %>">0</span></div>
    <div class="text-[10px] text-blue-600/70 mt-1">Akumulasi semua produksi</div>
  </div>
  <div class="dash-card-item bg-gradient-to-br from-amber-50 to-amber-100/60 rounded-2xl border border-amber-200/60 p-5 shadow-sm" style="animation-delay:180ms">
    <div class="flex items-center justify-between mb-1">
      <span class="text-[10px] font-semibold uppercase tracking-wider text-amber-700">Realisasi Budget</span>
      <svg class="dash-icon-pulse w-4 h-4 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>
    </div>
    <div class="mono text-2xl font-bold text-amber-800"><span class="dash-count" data-count="<%= summary.total_realisasi %>" data-format="idr">Rp 0</span></div>
    <div class="text-[10px] text-amber-600/70 mt-1">dari Rp <%= summary.total_budget.toLocaleString('id-ID') %></div>
  </div>
  <div class="dash-card-item bg-gradient-to-br from-rose-50 to-rose-100/60 rounded-2xl border border-rose-200/60 p-5 shadow-sm" style="animation-delay:240ms">
    <div class="flex items-center justify-between mb-1">
      <span class="text-[10px] font-semibold uppercase tracking-wider text-rose-700">Stok Menipis</span>
      <svg class="dash-icon-pulse w-4 h-4 text-rose-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 9v2m0 4h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>
    </div>
    <div class="mono text-2xl font-bold text-rose-800"><span class="dash-count" data-count="<%= summary.stok_menipis %>">0</span></div>
    <div class="text-[10px] text-rose-600/70 mt-1"><%= summary.jumlah_bahan_baku %> bahan total</div>
  </div>
  <div class="dash-card-item bg-gradient-to-br from-violet-50 to-violet-100/60 rounded-2xl border border-violet-200/60 p-5 shadow-sm" style="animation-delay:300ms">
    <div class="flex items-center justify-between mb-1">
      <span class="text-[10px] font-semibold uppercase tracking-wider text-violet-700">Ijin/Cuti Hari Ini</span>
      <svg class="dash-icon-pulse w-4 h-4 text-violet-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
    </div>
    <div class="mono text-2xl font-bold text-violet-800"><span class="dash-count" data-count="<%= summary.ijin_cuti_hari_ini %>">0</span></div>
    <div class="text-[10px] text-violet-600/70 mt-1">Menunggu persetujuan: <b><span class="dash-count" data-count="<%= summary.ijin_cuti_menunggu %>">0</span></b></div>
  </div>
</div>

<% const tips = []; %>
<% if (summary.stok_menipis > 0) tips.push({ tone: 'rose', text: '<b>' + summary.stok_menipis + '</b> bahan baku berstatus stok menipis. Prioritaskan restock hari ini agar produksi tidak terhambat.' }); %>
<% if (summary.persen_budget >= 80 && summary.persen_budget <= 100) tips.push({ tone: 'amber', text: 'Penyerapan budget sudah <b>' + summary.persen_budget + '%</b>. Pantau pengeluaran agar tidak melewati pagu.' }); %>
<% if (summary.persen_budget > 100) tips.push({ tone: 'rose', text: 'Realisasi budget <b>melebihi</b> pagu (' + summary.persen_budget + '%). Segera evaluasi anggaran periode ini.' }); %>
<% if (summary.ijin_cuti_menunggu > 0) tips.push({ tone: 'violet', text: 'Ada <b>' + summary.ijin_cuti_menunggu + '</b> pengajuan ijin/cuti yang menunggu persetujuan Anda.' }); %>
<% if (summary.total_penerima_manfaat > 0 && summary.total_porsi_diproduksi === 0) tips.push({ tone: 'blue', text: 'Jadwalkan produksi hari ini — data penerima sudah tercatat namun belum ada porsi yang diproduksi.' }); %>
<% if (tips.length === 0) tips.push({ tone: 'emerald', text: 'Semua berjalan lancar! Tidak ada peringatan yang perlu ditindaklanjuti saat ini.' }); %>

<div class="dash-card-item bg-white rounded-2xl border border-stone-200 shadow-sm p-5 mb-6" style="animation-delay:360ms">
  <div class="flex items-center justify-between mb-4">
    <div class="flex items-center gap-2">
      <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 1 1 7.072 0l-.548.547A3.374 3.374 0 0 0 14 18.469V19a2 2 0 1 1-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
      <h3 class="font-bold text-stone-800">Tips Cerdas</h3>
    </div>
    <span class="text-[10px] font-medium uppercase tracking-wider text-stone-400">Berdasarkan data saat ini</span>
  </div>
  <ul class="space-y-2.5">
    <% tips.forEach(function(t) {
        var barColor = {
          rose:   'bg-rose-400',
          amber:  'bg-amber-400',
          violet: 'bg-violet-400',
          blue:   'bg-blue-400',
          emerald:'bg-emerald-400'
        }[t.tone] || 'bg-stone-300';
    %>
      <li class="flex items-start gap-2.5">
        <span class="mt-[7px] w-1.5 h-1.5 rounded-full shrink-0 <%= barColor %>"></span>
        <span class="text-sm leading-relaxed text-stone-700"><%- t.text %></span>
      </li>
    <% }); %>
  </ul>
</div>

<% var ma = summary.menu_aktif; %>
<div class="dash-card-item bg-white rounded-2xl border border-stone-200 shadow-sm p-5 mb-6" style="animation-delay:420ms">
  <div class="flex items-center justify-between mb-4">
    <div class="flex items-center gap-2">
      <svg class="w-5 h-5 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
      <h3 class="font-bold text-stone-800">Menu Aktif Hari Ini</h3>
    </div>
    <% if (ma) { %>
      <span class="inline-flex items-center gap-1 px-2.5 py-1 rounded-lg bg-emerald-100 text-emerald-700 text-[10px] font-bold uppercase tracking-wider">
        <span class="w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse"></span>
        Hari <%= ma.hari_ke %>/<%= ma.total_hari %>
      </span>
    <% } %>
  </div>
  <% if (ma) { %>
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
      <div class="min-w-0">
        <div class="text-[10px] uppercase tracking-wider text-stone-400 font-bold mb-1"><%= ma.siklus_nama %><% if (ma.kategori) { %> • <%= ma.kategori %><% } %></div>
        <div class="text-lg font-bold text-stone-800 truncate"><%= ma.menu_nama || 'Menu belum diisi' %></div>
        <div class="text-xs text-stone-500 mt-1">
          Porsi: <b class="mono"><%= ma.porsi_item.toLocaleString('id-ID') %></b>
          <% if (ma.jumlah_porsi > 0) { %> dari total <b class="mono"><%= ma.jumlah_porsi.toLocaleString('id-ID') %></b> porsi<% } %>
        </div>
      </div>
      <% if (ma.kalori > 0) { %>
        <div class="grid grid-cols-2 sm:grid-cols-4 gap-2 shrink-0">
          <div class="bg-orange-50 border border-orange-100 rounded-xl px-3 py-2 text-center">
            <div class="mono text-sm font-bold text-orange-700"><%= ma.kalori.toLocaleString('id-ID') %></div>
            <div class="text-[9px] text-orange-600/70 font-semibold uppercase tracking-wider">Kalori</div>
          </div>
          <div class="bg-blue-50 border border-blue-100 rounded-xl px-3 py-2 text-center">
            <div class="mono text-sm font-bold text-blue-700"><%= ma.protein.toLocaleString('id-ID') %>g</div>
            <div class="text-[9px] text-blue-600/70 font-semibold uppercase tracking-wider">Protein</div>
          </div>
          <div class="bg-amber-50 border border-amber-100 rounded-xl px-3 py-2 text-center">
            <div class="mono text-sm font-bold text-amber-700"><%= ma.karbohidrat.toLocaleString('id-ID') %>g</div>
            <div class="text-[9px] text-amber-600/70 font-semibold uppercase tracking-wider">Karbo</div>
          </div>
          <div class="bg-rose-50 border border-rose-100 rounded-xl px-3 py-2 text-center">
            <div class="mono text-sm font-bold text-rose-700"><%= ma.lemak.toLocaleString('id-ID') %>g</div>
            <div class="text-[9px] text-rose-600/70 font-semibold uppercase tracking-wider">Lemak</div>
          </div>
        </div>
      <% } %>
    </div>
  <% } else { %>
    <div class="text-sm text-stone-400 py-6 text-center flex flex-col items-center gap-2">
      <svg class="w-6 h-6 text-stone-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
      Belum ada siklus aktif. <a href="/siklus" data-key="siklus" class="font-medium text-emerald-600 underline hover:no-underline">Aktifkan siklus →</a>
    </div>
  <% } %>
</div>

<div class="dash-card-item bg-white rounded-2xl border border-stone-200 shadow-sm p-5 mb-6" style="animation-delay:480ms">
  <div class="flex items-center justify-between mb-4">
    <div class="flex items-center gap-2">
      <svg class="w-5 h-5 text-blue-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M18 20V10M12 20V4M6 20v-6"/></svg>
      <h3 class="font-bold text-stone-800">Produksi 7 Hari Terakhir</h3>
    </div>
    <span class="mono text-xs font-semibold text-blue-700"><%= summary.grafik_total_7hari.toLocaleString('id-ID') %> porsi</span>
  </div>
  <% if (summary.grafik_total_7hari > 0) { %>
    <div class="flex items-end gap-2 sm:gap-3 h-40">
      <% summary.grafik_produksi.forEach(function(g) { %>
        <% var h = Math.max(4, Math.round((g.porsi / summary.grafik_max_porsi) * 100)); %>
        <div class="flex-1 flex flex-col items-center gap-1.5 min-w-0">
          <div class="w-full rounded-t-lg bg-gradient-to-t from-blue-600 to-sky-400 transition-all duration-500" style="height:<%= h %>%"></div>
          <div class="text-[9px] text-stone-400 truncate w-full text-center"><%= g.label %></div>
        </div>
      <% }); %>
    </div>
    <div class="mt-2 flex justify-between text-[9px] text-stone-300">
      <span>7 hari lalu</span><span>Hari ini</span>
    </div>
  <% } else { %>
    <div class="text-sm text-stone-400 py-8 text-center">Belum ada data produksi dalam 7 hari terakhir.</div>
  <% } %>
</div>

<div class="bg-white rounded-2xl border border-stone-200 shadow-sm p-5 mb-6 dash-card-item" style="animation-delay:540ms">
  <div class="flex items-center gap-2 mb-4">
    <svg class="w-5 h-5 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path d="M12 9v2m0 4h.01M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0z"/></svg>
    <h3 class="font-bold text-stone-800">Stok Menipis</h3>
  </div>
  <% if (summary.low_stock_items && summary.low_stock_items.length > 0) { %>
    <ul class="space-y-2">
      <% summary.low_stock_items.forEach(function(it) { %>
        <li class="flex justify-between border-b border-stone-100 pb-2 last:border-0">
          <div>
            <div class="text-sm font-medium text-stone-700"><%= it.nama %></div>
            <div class="text-[10px] text-stone-500">Min: <%= it.min %> <%= it.satuan %></div>
          </div>
          <div class="mono text-sm text-red-700 font-semibold"><%= it.stok %> <%= it.satuan %></div>
        </li>
      <% }); %>
    </ul>
  <% } else { %>
    <div class="text-sm text-stone-400 py-4 flex items-center gap-2">
      <svg class="w-4 h-4 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><polyline points="20 6 9 17 4 12"/></svg>
      Semua stok aman
    </div>
  <% } %>
</div>
