<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Masuk Dashboard — Sppg Sukaluyu Tamansari</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <style>
    * { box-sizing: border-box; }
    html, body { min-height: 100%; }
    body {
      font-family: "Geist", -apple-system, BlinkMacSystemFont, "Segoe UI", "Noto Sans", Helvetica, Arial, sans-serif, "Apple Color Emoji", "Segoe UI Emoji";
      font-weight: 400;
      margin: 0;
      color: #0f172a;
      background: #eef2f7;
      overflow-x: hidden;
    }
    h1, h2, h3 { font-family: "Geist", sans-serif; font-weight: 600; letter-spacing: -0.02em; }

    /* ── Latar belakang foto (tetap /bg.jpeg) ── */
    .page-bg {
      position: fixed;
      inset: 0;
      background: url('/bg.jpeg') center / cover no-repeat;
      z-index: -2;
    }
    .page-bg::after {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(180deg, rgba(241, 245, 249, 0.90) 0%, rgba(226, 232, 240, 0.88) 55%, rgba(203, 213, 225, 0.90) 100%);
    }

    /* ── Panel institusi ── */
    .aside-photo {
      position: absolute;
      inset: 0;
      background: url('/bg.jpeg') center / cover no-repeat;
      opacity: 0.42;
    }
    .aside-overlay {
      position: absolute;
      inset: 0;
      background: linear-gradient(155deg, rgba(9, 26, 58, 0.97) 0%, rgba(15, 42, 95, 0.94) 55%, rgba(20, 53, 116, 0.90) 100%);
    }
    .aside-grid {
      position: absolute;
      inset: 0;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
      background-size: 44px 44px;
      mask-image: linear-gradient(to bottom, rgba(0,0,0,0.7), transparent 80%);
      -webkit-mask-image: linear-gradient(to bottom, rgba(0,0,0,0.7), transparent 80%);
    }

    .mobile-header {
      background:
        linear-gradient(135deg, rgba(9, 26, 58, 0.95), rgba(20, 53, 116, 0.88)),
        url('/bg.jpeg') center / cover no-repeat;
    }

    /* ── Kartu & form ── */
    .login-shell {
      box-shadow: 0 30px 70px -28px rgba(15, 23, 42, 0.45), 0 2px 6px rgba(15, 23, 42, 0.05);
      animation: shellIn 0.55s cubic-bezier(0.22, 1, 0.36, 1) both;
    }
    @keyframes shellIn {
      from { opacity: 0; transform: translateY(14px); }
      to   { opacity: 1; transform: translateY(0); }
    }
    .field {
      width: 100%;
      height: 3rem;
      border-radius: 0.5rem;
      border: 1px solid #cbd5e1;
      background: #ffffff;
      padding: 0 2.85rem 0 2.75rem;
      font-size: 0.9rem;
      color: #0f172a;
      outline: none;
      transition: border-color 0.18s ease, box-shadow 0.18s ease;
    }
    .field::placeholder { color: #94a3b8; }
    .field:hover { border-color: #94a3b8; }
    .field:focus {
      border-color: #1e3a8a;
      box-shadow: 0 0 0 3px rgba(30, 58, 138, 0.12);
    }
    .field-icon { transition: color 0.18s ease; }
    .field-wrap:focus-within .field-icon { color: #1e3a8a; }

    .btn-login {
      background: #14326b;
      border: 1px solid #14326b;
      transition: background 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
    }
    .btn-login:hover:not(:disabled) {
      background: #0f2a5f;
      border-color: #0f2a5f;
      box-shadow: 0 8px 18px -10px rgba(15, 42, 95, 0.8);
    }
    .btn-login:focus-visible {
      outline: 2px solid #1e3a8a;
      outline-offset: 2px;
    }
    .btn-login:disabled { opacity: 0.8; cursor: wait; }

    .spinner {
      width: 1.05rem; height: 1.05rem;
      border: 2px solid rgba(255, 255, 255, 0.35);
      border-top-color: #ffffff;
      border-radius: 50%;
      animation: spin 0.65s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }

    .rule-gold {
      width: 2.5rem;
      height: 2px;
      background: #c6a664;
    }

    ::selection { background: rgba(30, 58, 138, 0.22); }
    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation-duration: 0.001ms !important; animation-iteration-count: 1 !important; }
    }
  </style>
</head>
<body class="min-h-screen">
  <div class="page-bg"></div>

  <main class="relative z-10 min-h-screen w-full flex items-center justify-center px-3 py-6 sm:px-6 sm:py-10">
    <div class="login-shell w-full max-w-[1120px] bg-white rounded-xl overflow-hidden border border-slate-200 grid lg:grid-cols-[1.04fr_0.96fr]">

      <!-- ══════════ Panel institusi (desktop) ══════════ -->
      <aside class="relative hidden lg:flex flex-col justify-center overflow-hidden px-10 py-10 xl:px-12 xl:py-12 text-white">
        <div class="aside-photo"></div>
        <div class="aside-overlay"></div>
        <div class="aside-grid"></div>

        <div class="relative z-10">
          <div class="flex items-center gap-4">
            <div class="w-14 h-14 rounded-lg bg-white ring-1 ring-white/40 shadow-lg flex items-center justify-center p-1.5">
              <img src="/asset/logo.png?v=<%= logoVer %>" alt="Sppg Sukaluyu Tamansari" class="w-full h-full object-contain" />
            </div>
            <div class="min-w-0">
              <p class="text-[10px] font-semibold uppercase tracking-[0.22em] text-blue-200">Sistem Informasi Manajemen Dapur</p>
              <h2 class="mt-1 text-[17px] font-semibold leading-snug text-white">Sppg Sukaluyu Tamansari</h2>
            </div>
          </div>
        </div>

        <div class="relative z-10 my-10 xl:my-12">
          <div class="rule-gold"></div>
          <p class="mt-5 text-[11px] font-semibold uppercase tracking-[0.2em] text-blue-200/90">Portal Internal</p>
          <h1 class="mt-2 max-w-lg text-[2rem] xl:text-[2.4rem] leading-[1.15] font-semibold tracking-tight text-white">
            Pengelolaan dapur MBG yang tertib, terukur, dan akuntabel.
          </h1>
          <p class="mt-4 max-w-md text-sm leading-relaxed text-slate-300/90">
            Satu sistem terpadu untuk perencanaan menu, pengadaan bahan, produksi, distribusi, dan pencatatan keuangan dapur.
          </p>

          <ul class="mt-8 max-w-md divide-y divide-white/10 border-y border-white/10">
            <li class="flex items-center gap-3 py-3">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-white/10 text-blue-200">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 6h16M4 12h10M4 18h7"/></svg>
              </span>
              <span class="text-[13px] text-slate-200">Perencanaan menu &amp; standar gizi</span>
            </li>
            <li class="flex items-center gap-3 py-3">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-white/10 text-blue-200">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"/></svg>
              </span>
              <span class="text-[13px] text-slate-200">Pengadaan bahan baku &amp; pengendalian stok</span>
            </li>
            <li class="flex items-center gap-3 py-3">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-white/10 text-blue-200">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 7h13v10H3zM16 10h3l2 3v4h-5zM7 20a2 2 0 100-4 2 2 0 000 4zm10 0a2 2 0 100-4 2 2 0 000 4z"/></svg>
              </span>
              <span class="text-[13px] text-slate-200">Produksi &amp; distribusi makanan</span>
            </li>
            <li class="flex items-center gap-3 py-3">
              <span class="flex h-7 w-7 shrink-0 items-center justify-center rounded-md bg-white/10 text-blue-200">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 3v18m7-14H8a3 3 0 000 6h8a3 3 0 010 6H5"/></svg>
              </span>
              <span class="text-[13px] text-slate-200">Akuntansi &amp; pelaporan keuangan</span>
            </li>
          </ul>
        </div>

      </aside>

      <!-- ══════════ Panel form ══════════ -->
      <section class="relative flex flex-col justify-center bg-white px-6 py-7 sm:px-9 sm:py-10 lg:px-11 lg:py-12">

        <!-- Header institusi (mobile) -->
        <div class="mobile-header lg:hidden -mx-6 -mt-7 sm:-mx-9 sm:-mt-10 mb-7 px-6 py-5 sm:px-9 sm:py-6 text-white">
          <div class="flex items-center gap-3">
            <div class="w-12 h-12 shrink-0 rounded-lg bg-white ring-1 ring-white/30 flex items-center justify-center p-1.5">
              <img src="/asset/logo.png?v=<%= logoVer %>" alt="Sppg Sukaluyu Tamansari" class="w-full h-full object-contain" />
            </div>
            <div class="min-w-0">
              <p class="text-[9px] font-semibold uppercase tracking-[0.18em] text-blue-200">Sistem Informasi Manajemen Dapur</p>
              <p class="mt-0.5 text-sm font-semibold">Sppg Sukaluyu Tamansari</p>
            </div>
          </div>
        </div>

        <div>
          <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-blue-800">Akses Dashboard</p>
          <h1 class="mt-2 text-[1.65rem] sm:text-[1.85rem] font-semibold tracking-tight text-slate-900">Masuk ke Akun Anda</h1>
          <p class="mt-2 text-[13px] leading-relaxed text-slate-500">
            Gunakan email dan kata sandi yang telah terdaftar untuk mengakses sistem.
          </p>
        </div>

        <form id="login-form" class="mt-7 space-y-4" novalidate>
          <div>
            <label for="email" class="text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Email</label>
            <div class="field-wrap relative mt-1.5">
              <svg class="field-icon absolute left-3.5 top-1/2 -translate-y-1/2 w-[17px] h-[17px] text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M4 5h16a1 1 0 011 1v12a1 1 0 01-1 1H4a1 1 0 01-1-1V6a1 1 0 011-1z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3.5 6.5L12 13l8.5-6.5"/></svg>
              <input id="email" type="email" required autocomplete="username" inputmode="email" placeholder="nama@email.com" class="field" />
            </div>
          </div>

          <div>
            <label for="password" class="text-[11px] font-semibold uppercase tracking-[0.1em] text-slate-600">Kata Sandi</label>
            <div class="field-wrap relative mt-1.5">
              <svg class="field-icon absolute left-3.5 top-1/2 -translate-y-1/2 w-[17px] h-[17px] text-slate-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><rect x="4" y="10" width="16" height="11" rx="2" stroke-width="1.8"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M8 10V7a4 4 0 018 0v3"/></svg>
              <input id="password" type="password" required autocomplete="current-password" placeholder="Masukkan kata sandi" class="field pr-12" />
              <button type="button" id="toggle-pass" class="absolute right-2.5 top-1/2 -translate-y-1/2 flex h-8 w-8 items-center justify-center rounded-md text-slate-400 hover:text-blue-900 hover:bg-slate-100 transition" tabindex="-1" aria-label="Tampilkan kata sandi">
                <svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M1.5 12S5.5 4.5 12 4.5 22.5 12 22.5 12 18.5 19.5 12 19.5 1.5 12 1.5 12z"/><circle cx="12" cy="12" r="3" stroke-width="1.8"/></svg>
              </button>
            </div>
          </div>

          <div id="err" class="hidden text-[13px] text-red-700 bg-red-50 border border-red-200 px-3.5 py-3 rounded-md flex items-start gap-2.5">
            <svg class="w-4 h-4 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <span id="err-text"></span>
          </div>

          <button type="submit" id="btn-login" class="btn-login w-full h-12 text-white rounded-md font-semibold text-[13px] tracking-wide flex items-center justify-center gap-2">
            <span id="btn-login-text">Masuk</span>
            <svg id="btn-login-arrow" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4"/><polyline points="10 17 15 12 10 7" stroke-width="2"/><line x1="15" y1="12" x2="3" y2="12" stroke-width="2"/></svg>
            <span id="btn-login-spinner" class="spinner hidden"></span>
          </button>
        </form>

        <!-- Statistik ringkas -->
        <div class="mt-7 grid grid-cols-3 divide-x divide-slate-200 rounded-md border border-slate-200 bg-slate-50/70 overflow-hidden" id="hero-stats">
          <div class="px-2 py-3.5 text-center">
            <div class="text-[17px] font-semibold text-[#14326b]" id="stat-porsi">—</div>
            <div class="mt-0.5 text-[9px] font-semibold uppercase tracking-[0.1em] text-slate-500">Porsi/Hari</div>
          </div>
          <div class="px-2 py-3.5 text-center">
            <div class="text-[17px] font-semibold text-[#14326b]" id="stat-menu">—</div>
            <div class="mt-0.5 text-[9px] font-semibold uppercase tracking-[0.1em] text-slate-500">Menu Gizi</div>
          </div>
          <div class="px-2 py-3.5 text-center">
            <div class="text-[17px] font-semibold text-[#14326b]" id="stat-karyawan">—</div>
            <div class="mt-0.5 text-[9px] font-semibold uppercase tracking-[0.1em] text-slate-500">Karyawan Aktif</div>
          </div>
        </div>

        <div class="mt-6 border-t border-slate-200 pt-4">
          <div class="flex flex-col sm:flex-row items-center justify-between gap-2.5">
            <p class="text-[10px] text-slate-400 text-center sm:text-left">© <%= new Date().getFullYear() %> Sppg Sukaluyu Tamansari</p>
            <a href="/absen" class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-blue-900 hover:text-blue-700 transition">
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 11l3 3L22 4"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12v7a2 2 0 01-2 2H5a2 2 0 01-2-2V5a2 2 0 012-2h11"/></svg>
              Login Absen Karyawan
            </a>
          </div>
          <p class="mt-2 text-center sm:text-left text-[10px] text-slate-400">
            Hubungi administrator sistem apabila mengalami kendala akses.
          </p>
        </div>
      </section>
    </div>
  </main>

  <script>
    const errBox = document.getElementById('err');
    const errText = document.getElementById('err-text');

    function tampilkanError(pesan) {
      errText.textContent = pesan;
      errBox.classList.remove('hidden');
    }

    // Show timeout message if logged out due to inactivity
    if (new URLSearchParams(window.location.search).has('timeout')) {
      tampilkanError('Sesi berakhir karena tidak ada aktivitas selama 5 menit. Silakan login kembali.');
    }

    // Load hero stats
    fetch('/api/public/stats').then(function(r) { return r.json(); }).then(function(d) {
      document.getElementById('stat-porsi').textContent = d.porsi_per_hari && d.porsi_per_hari > 0 ? d.porsi_per_hari + '+' : '0';
      document.getElementById('stat-menu').textContent = d.total_menu;
      document.getElementById('stat-karyawan').textContent = d.total_karyawan_aktif != null ? d.total_karyawan_aktif : '0';
    }).catch(function() {});

    // Toggle password visibility
    document.getElementById('toggle-pass').addEventListener('click', function() {
      const pwd = document.getElementById('password');
      const isPass = pwd.getAttribute('type') === 'password';
      pwd.setAttribute('type', isPass ? 'text' : 'password');
      this.setAttribute('aria-label', isPass ? 'Sembunyikan kata sandi' : 'Tampilkan kata sandi');
      this.innerHTML = isPass
        ? '<svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M3 3l18 18M10.6 10.6a3 3 0 104.24 4.24M9.9 4.24A9.12 9.12 0 0112 4c7 0 11 8 11 8a18.5 18.5 0 01-2.16 3.19M6.06 6.06A18.45 18.45 0 001 12s4 8 11 8a10.07 10.07 0 005.94-1.94"/></svg>'
        : '<svg class="w-[18px] h-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M1.5 12S5.5 4.5 12 4.5 22.5 12 22.5 12 18.5 19.5 12 19.5 1.5 12 1.5 12z"/><circle cx="12" cy="12" r="3" stroke-width="1.8"/></svg>';
    });

    // Login submit
    document.getElementById('login-form').addEventListener('submit', async (e) => {
      e.preventDefault();
      errBox.classList.add('hidden');

      const btn = document.getElementById('btn-login');
      const btnText = document.getElementById('btn-login-text');
      const btnArrow = document.getElementById('btn-login-arrow');
      const btnSpinner = document.getElementById('btn-login-spinner');

      btn.disabled = true;
      btnText.textContent = 'Memverifikasi...';
      btnArrow.classList.add('hidden');
      btnSpinner.classList.remove('hidden');
      let sukses = false;

      try {
        const r = await fetch('/api/auth/login', {
          method: 'POST', headers: {'Content-Type':'application/json'},
          body: JSON.stringify({ email: document.getElementById('email').value, password: document.getElementById('password').value }),
        });
        let data;
        try { data = await r.json(); } catch {
          tampilkanError('Respons tidak valid dari server.'); return;
        }
        if (!r.ok) { tampilkanError(data.error || 'Gagal masuk. Periksa kembali email dan kata sandi Anda.'); return; }
        sukses = true;
        btnText.textContent = 'Berhasil — membuka dashboard...';
        location.href = '/';
      } catch (e) {
        console.error('Login error:', e);
        tampilkanError('Gagal terhubung ke server. Periksa koneksi Anda lalu coba lagi.');
      } finally {
        if (!sukses) {
          btn.disabled = false;
          btnText.textContent = 'Masuk';
          btnArrow.classList.remove('hidden');
          btnSpinner.classList.add('hidden');
        }
      }
    });
  </script>
</body>
</html>
