JWT_SECRET=your-secret-key-here
PORT=3000

# Domain utama untuk subdomain per-dapur (mis. mbg.id → dapurX.mbg.id).
# Di mode dev pakai *.localhost (otomatis). Biarkan kosong jika tidak pakai subdomain.
APP_BASE_DOMAIN=mbg.id

# OpenAI
OPENAI_API_KEY=sk-...

# WhatsApp Notification
# WA_ADMIN_NUMBER=08123456789  # Nomor admin yang akan menerima notif

# Opsi 1: Bot WhatsApp sendiri (pakai Baileys) — RECOMMENDED
# Scan QR code di terminal saat pertama kali jalan
# WA_BOT_ENABLED=true
# WA_FALLBACK_TO_FONTTE=true   # Fallback ke Fonnte jika bot gagal

# Opsi 2: Via Fonnte (third-party gateway)
# Daftar gratis di https://fonnte.com untuk mendapatkan API key
# WA_API_KEY=your_fonnte_api_key
# WA_GATEWAY_URL=https://api.fonnte.com/send

# WhatsApp Notification (Fonnte)
# Daftar gratis di https://fonnte.com untuk mendapatkan API key
# WA_API_KEY=your_fonnte_api_key
# WA_ADMIN_NUMBER=08123456789
# WA_GATEWAY_URL=https://api.fonnte.com/send

# Koperasi sync (nomor PO/Invoice dari sistem koperasi)
# KOPERASI_API_URL=https://koperasi.mealify.id/api/pesanan_koperasi.php